+#pragma once
+/**
+ * @file        webgpu/shader.h
+ * @brief       WebGPU shader objects (SpirvShader + WGSL module)
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include <atomic>
+#include <string>
+
+#include <rex/graphics/pipeline/shader/spirv.h>
+#include <rex/graphics/xenos.h>
+#include <webgpu/webgpu.h>
+
+namespace rex::graphics::webgpu {
+
+class WebGPUShader : public SpirvShader {
+ public:
+  class WebGPUTranslation : public SpirvTranslation {
+   public:
+    explicit WebGPUTranslation(WebGPUShader& shader, uint64_t modification)
+        : SpirvTranslation(shader, modification) {}
+    ~WebGPUTranslation() override;
+
+    // Converts the SPIR-V produced by the base translation to WGSL. Pure host
+    // code - runs on the command processor thread at draw capture time.
+    bool EnsureWGSLTranslated();
+
+    // Creates the WGPUShaderModule from the translated WGSL (main thread).
+    // Returns null on failure.
+    WGPUShaderModule GetOrCreateShaderModule(WGPUDevice device);
+
+    const std::string& wgsl() const { return wgsl_; }
+
+   private:
+    std::string wgsl_;
+    WGPUShaderModule shader_module_ = nullptr;
+    bool wgsl_attempted_ = false;
+  };
+
+  explicit WebGPUShader(xenos::ShaderType shader_type, uint64_t ucode_data_hash,
+                        const uint32_t* ucode_dwords, size_t ucode_dword_count,
+                        std::endian ucode_source_endian = std::endian::big);
+
+ protected:
+  Translation* CreateTranslationInstance(uint64_t modification) override;
+};
+
+}  // namespace rex::graphics::webgpu
diff --git a/src/graphics/webgpu/webgpu_device.cpp b/src/graphics/webgpu/webgpu_device.cpp
new file mode 100644
index 0000000..23f2e4a
--- /dev/null
+++ b/src/graphics/webgpu/webgpu_device.cpp
@@ -0,0 +1,222 @@
+/**
+ * @file        webgpu/webgpu_device.cpp
+ * @brief       WebGPU device ownership + canvas surface (implementation)
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include "webgpu_device.h"
+
+#include "webgpu_util.h"
+
+#include <cstring>
+
+#include <rex/logging.h>
+
+namespace rex::graphics::webgpu {
+
+namespace {
+using namespace rex::graphics::webgpu;
+// Emscripten's Dawn port accepts a canvas selector through this chained
+// structure (verified against emdawnwebgpu v20260423: SType 0x00040000).
+void MakeCanvasSurfaceDescriptor(WGPUSurfaceDescriptor& desc,
+                                 WGPUEmscriptenSurfaceSourceCanvasHTMLSelector& sel,
+                                 const char* selector) {
+  std::memset(&sel, 0, sizeof(sel));
+  sel.chain.sType = WGPUSType_EmscriptenSurfaceSourceCanvasHTMLSelector;
+  sel.chain.next = nullptr;
+  sel.selector = SViewCast(selector);
+  std::memset(&desc, 0, sizeof(desc));
+  desc.nextInChain = &sel.chain;
+}
+}  // namespace
+
+WebGPUDevice::~WebGPUDevice() { Shutdown(); }
+
+void WebGPUDevice::Initialize(const char* canvas_selector) {
+  if (state_ != DeviceState::kIdle) return;
+  canvas_selector_ = canvas_selector ? canvas_selector : "#canvas";
+
+  WGPUInstanceDescriptor desc = {};
+  desc.nextInChain = nullptr;
+  instance_ = wgpuCreateInstance(&desc);
+  if (!instance_) {
+    state_ = DeviceState::kFailed;
+    error_ = "wgpuInstanceCreate failed";
+    return;
+  }
+  state_ = DeviceState::kInitializing;
+
+  WGPUSurfaceDescriptor sdesc;
+  WGPUEmscriptenSurfaceSourceCanvasHTMLSelector sel;
+  MakeCanvasSurfaceDescriptor(sdesc, sel, canvas_selector_.c_str());
+  surface_ = wgpuInstanceCreateSurface(instance_, &sdesc);
+  if (!surface_) {
+    REXGPU_WARN(
+        "webgpu: surface creation from canvas '{}' failed; rendering will "
+        "fall back to offscreen-only",
+        canvas_selector_);
+  }
+
+  WGPURequestAdapterOptions options = {};
+  options.nextInChain = nullptr;
+  options.powerPreference = WGPUPowerPreference_HighPerformance;
+  WGPURequestAdapterCallbackInfo cb = {};
+  cb.nextInChain = nullptr;
+  cb.mode = WGPUCallbackMode_AllowSpontaneous;
+  cb.callback = &WebGPUDevice::RequestAdapterCallback;
+  cb.userdata1 = this;
+  cb.userdata2 = nullptr;
+  wgpuInstanceRequestAdapter(instance_, &options, cb);
+  adapter_requested_ = true;
+}
+
+void WebGPUDevice::RequestAdapterCallback(WGPURequestAdapterStatus status,
+                                          WGPUAdapter adapter,
+                                          WGPUStringView message, void* userdata1,
+                                          void* userdata2) {
+  auto* self = static_cast<WebGPUDevice*>(userdata1);
+  if (status != WGPURequestAdapterStatus_Success || !adapter) {
+    self->state_ = DeviceState::kFailed;
+    self->error_ = "adapter request failed: " + std::string(message.data ? message.data : "");
+    return;
+  }
+  self->adapter_ = adapter;
+
+  WGPUDeviceDescriptor ddesc = {};
+  WGPUDeviceLostCallbackInfo lost = {};
+  lost.mode = WGPUCallbackMode_AllowSpontaneous;
+  lost.callback = &WebGPUDevice::OnDeviceLost;
+  lost.userdata1 = self;
+  WGPUUncapturedErrorCallbackInfo uncaptured = {};
+  uncaptured.callback = &WebGPUDevice::OnUncapturedError;
+  uncaptured.userdata1 = self;
+  ddesc.nextInChain = nullptr;
+  ddesc.deviceLostCallbackInfo = lost;
+  ddesc.uncapturedErrorCallbackInfo = uncaptured;
+  WGPURequestDeviceCallbackInfo cb = {};
+  cb.nextInChain = nullptr;
+  cb.mode = WGPUCallbackMode_AllowSpontaneous;
+  cb.callback = &WebGPUDevice::RequestDeviceCallback;
+  cb.userdata1 = self;
+  cb.userdata2 = nullptr;
+  wgpuAdapterRequestDevice(self->adapter_, &ddesc, cb);
+  self->device_requested_ = true;
+}
+
+void WebGPUDevice::RequestDeviceCallback(WGPURequestDeviceStatus status,
+                                         WGPUDevice device,
+                                         WGPUStringView message, void* userdata1,
+                                         void* userdata2) {
+  auto* self = static_cast<WebGPUDevice*>(userdata1);
+  if (status != WGPURequestDeviceStatus_Success || !device) {
+    self->state_ = DeviceState::kFailed;
+    self->error_ = "device request failed: " + std::string(message.data ? message.data : "");
+    return;
+  }
+  self->device_ = device;
+  self->queue_ = wgpuDeviceGetQueue(self->device_);
+  self->state_ = DeviceState::kReady;
+  REXGPU_INFO("webgpu: device acquired ( '{}')", self->canvas_selector_);
+}
+
+void WebGPUDevice::OnDeviceLost(WGPUDevice const* device,
+                                WGPUDeviceLostReason reason,
+                                WGPUStringView message, void* userdata1,
+                                void* userdata2) {
+  auto* self = static_cast<WebGPUDevice*>(userdata1);
+  (void)device;
+  (void)userdata2;
+  self->state_ = DeviceState::kFailed;
+  self->error_ = "device lost: " + std::string(message.data ? message.data : "");
+}
+
+void WebGPUDevice::OnUncapturedError(WGPUDevice const* device, WGPUErrorType type,
+                                     WGPUStringView message, void* userdata1,
+                                     void* userdata2) {
+  (void)device;
+  (void)userdata1;
+  (void)userdata2;
+  REXGPU_ERROR("webgpu: uncaptured error ({}): {}", int(type),
+               message.data ? message.data : "");
+}
+
+bool WebGPUDevice::Pump() {
+  // Dawn on Emscripten processes callbacks through the browser event loop;
+  // nothing to spin here beyond surfacing state. Kept as a hook for future
+  // tick-driven work (e.g. mapped buffer callbacks).
+  return state_ == DeviceState::kReady;
+}
+
+bool WebGPUDevice::ConfigureSurface(uint32_t width, uint32_t height) {
+  if (state_ != DeviceState::kReady || !surface_) return false;
+  if (surface_configured_ && width == surface_width_ && height == surface_height_) {
+    return true;
+  }
+  WGPUSurfaceCapabilities caps = {};
+  wgpuSurfaceGetCapabilities(surface_, adapter_, &caps);
+  if (caps.formatCount > 0) {
+    surface_format_ = caps.formats[0];
+  } else {
+    surface_format_ = WGPUTextureFormat_BGRA8Unorm;
+  }
+  WGPUSurfaceConfiguration config = {};
+  config.device = device_;
+  config.format = surface_format_;
+  config.usage = WGPUTextureUsage_RenderAttachment;
+  config.width = width;
+  config.height = height;
+  config.alphaMode = WGPUCompositeAlphaMode_Auto;
+  config.presentMode = WGPUPresentMode_Fifo;
+  wgpuSurfaceConfigure(surface_, &config);
+  surface_width_ = width;
+  surface_height_ = height;
+  surface_configured_ = true;
+  wgpuSurfaceCapabilitiesFreeMembers(caps);
+  return true;
+}
+
+WGPUTexture WebGPUDevice::AcquireSurfaceTexture(bool* suboptimal) {
+  if (state_ != DeviceState::kReady || !surface_) return nullptr;
+  WGPUSurfaceTexture st = {};
+  wgpuSurfaceGetCurrentTexture(surface_, &st);
+  if (suboptimal) {
+    *suboptimal = st.status == WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal;
+  }
+  if (st.status != WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal &&
+      st.status != WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal) {
+    surface_configured_ = false;  // reconfigure on next frame
+    return nullptr;
+  }
+  return st.texture;
+}
+
+void WebGPUDevice::Present() {
+  if (surface_) wgpuSurfacePresent(surface_);
+}
+
+void WebGPUDevice::Shutdown() {
+  if (surface_) {
+    wgpuSurfaceRelease(surface_);
+    surface_ = nullptr;
+  }
+  if (queue_) {
+    wgpuQueueRelease(queue_);
+    queue_ = nullptr;
+  }
+  if (device_) {
+    wgpuDeviceRelease(device_);
+    device_ = nullptr;
+  }
+  if (adapter_) {
+    wgpuAdapterRelease(adapter_);
+    adapter_ = nullptr;
+  }
+  if (instance_) {
+    wgpuInstanceRelease(instance_);
+    instance_ = nullptr;
+  }
+  state_ = DeviceState::kIdle;
+}
+
+}  // namespace rex::graphics::webgpu
diff --git a/src/graphics/webgpu/webgpu_device.h b/src/graphics/webgpu/webgpu_device.h
new file mode 100644
index 0000000..b751070
--- /dev/null
+++ b/src/graphics/webgpu/webgpu_device.h
@@ -0,0 +1,88 @@
+#pragma once
+/**
+ * @file        webgpu/webgpu_device.h
+ * @brief       WebGPU device ownership + canvas surface for the wasm backend
+ *
+ * WebGPU is main-thread-only in the browser (unless OffscreenCanvas is used),
+ * so the device object exposes a small state machine: async adapter/device
+ * requests are kicked off from the main thread and their callbacks complete
+ * the state; a Pump() call drains WebGPU work each frame. The command
+ * processor thread never calls WebGPU directly -- it enqueues operations on
+ * the deferred queue which the pump drains.
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include <webgpu/webgpu.h>
+
+#include <memory>
+#include <string>
+
+#include <rex/graphics/graphics_system.h>
+
+namespace rex::graphics::webgpu {
+
+enum class DeviceState {
+  kIdle,          // not initialized
+  kInitializing, // adapter/device requests in flight
+  kReady,        // device + queue + surface available
+  kFailed,       // no adapter / device request failed / WebGPU unavailable
+};
+
+class WebGPUDevice {
+ public:
+  WebGPUDevice() = default;
+  ~WebGPUDevice();
+
+  // Kicks off adapter/device acquisition. Must be called on the main thread.
+  void Initialize(const char* canvas_selector);
+  // Drives the async init state machine + deferred GPU work. Main thread.
+  // Returns true when the device is ready.
+  bool Pump();
+  // Configures the canvas surface with the current framebuffer size.
+  bool ConfigureSurface(uint32_t width, uint32_t height);
+  // Acquires the current swapchain texture for rendering, or null.
+  WGPUTexture AcquireSurfaceTexture(bool* suboptimal);
+  void Present();
+  void Shutdown();
+
+  DeviceState state() const { return state_; }
+  bool ready() const { return state_ == DeviceState::kReady; }
+  const std::string& error() const { return error_; }
+  WGPUDevice device() const { return device_; }
+  WGPUQueue queue() const { return queue_; }
+  WGPUTextureFormat surface_format() const { return surface_format_; }
+  uint32_t surface_width() const { return surface_width_; }
+  uint32_t surface_height() const { return surface_height_; }
+
+ private:
+  static void RequestAdapterCallback(WGPURequestAdapterStatus status,
+                                     WGPUAdapter adapter, WGPUStringView message,
+                                     void* userdata1, void* userdata2);
+  static void RequestDeviceCallback(WGPURequestDeviceStatus status,
+                                    WGPUDevice device, WGPUStringView message,
+                                    void* userdata1, void* userdata2);
+  static void OnDeviceLost(WGPUDevice const* device, WGPUDeviceLostReason reason,
+                           WGPUStringView message, void* userdata1,
+                           void* userdata2);
+  static void OnUncapturedError(WGPUDevice const* device, WGPUErrorType type,
+                                WGPUStringView message, void* userdata1,
+                                void* userdata2);
+
+  DeviceState state_ = DeviceState::kIdle;
+  std::string error_;
+  std::string canvas_selector_;
+  WGPUInstance instance_ = nullptr;
+  WGPUAdapter adapter_ = nullptr;
+  WGPUDevice device_ = nullptr;
+  WGPUQueue queue_ = nullptr;
+  WGPUSurface surface_ = nullptr;
+  WGPUTextureFormat surface_format_ = WGPUTextureFormat_BGRA8Unorm;
+  uint32_t surface_width_ = 0;
+  uint32_t surface_height_ = 0;
+  bool surface_configured_ = false;
+  bool adapter_requested_ = false;
+  bool device_requested_ = false;
+};
+
+}  // namespace rex::graphics::webgpu
diff --git a/src/graphics/webgpu/webgpu_presenter.cpp b/src/graphics/webgpu/webgpu_presenter.cpp
new file mode 100644
index 0000000..29d35eb
--- /dev/null
+++ b/src/graphics/webgpu/webgpu_presenter.cpp
@@ -0,0 +1,234 @@
+/**
+ * @file        webgpu/webgpu_presenter.cpp
+ * @brief       WebGPU provider, presenter and immediate drawer (implementation)
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include "webgpu_presenter.h"
+
+#include <cstring>
+
+#include <rex/logging.h>
+
+#include "webgpu_util.h"
+
+namespace rex::graphics::webgpu {
+
+// The presentation WGSL (aspect-preserving letterbox quad) lives in
+// webgpu_util.cpp, shared with the command processor's per-frame pump.
+
+// ------------------------------- presenter ---------------------------------
+
+WebGPUPresenter::WebGPUPresenter(HostGpuLossCallback host_gpu_loss_callback,
+                                 WebGPUDevice* device)
+    : Presenter(host_gpu_loss_callback), device_(device) {
+  InitializeCommonSurfaceIndependent();
+}
+
+WebGPUPresenter::~WebGPUPresenter() {
+  DestroyPaintPipeline(paint_);
+  if (paint_sampler_) wgpuSamplerRelease(paint_sampler_);
+  if (guest_view_) wgpuTextureViewRelease(guest_view_);
+}
+
+rex::ui::Surface::TypeFlags WebGPUPresenter::GetSupportedSurfaceTypes() const {
+  return rex::ui::Surface::kTypeFlag_EmscriptenCanvas;
+}
+
+bool WebGPUPresenter::CaptureGuestOutput(rex::ui::RawImage& image_out) {
+  // v1: no readback path (Phase 4: copy texture to buffer + map).
+  (void)image_out;
+  return false;
+}
+
+rex::ui::Presenter::SurfacePaintConnectResult
+WebGPUPresenter::ConnectOrReconnectPaintingToSurfaceFromUIThread(
+    rex::ui::Surface& new_surface, uint32_t new_surface_width,
+    uint32_t new_surface_height, bool was_paintable, bool& is_vsync_implicit_out) {
+  (void)new_surface;
+  (void)was_paintable;
+  if (!device_ || !device_->ready()) {
+    return SurfacePaintConnectResult::kFailure;
+  }
+  if (!device_->ConfigureSurface(new_surface_width, new_surface_height)) {
+    return SurfacePaintConnectResult::kFailure;
+  }
+  // Fifo present mode = vsync forced by the browser compositor.
+  is_vsync_implicit_out = true;
+  connected_ = true;
+  EnsurePaintPipeline();
+  return SurfacePaintConnectResult::kSuccess;
+}
+
+void WebGPUPresenter::DisconnectPaintingFromSurfaceFromUIThreadImpl() {
+  connected_ = false;
+}
+
+bool WebGPUPresenter::RefreshGuestOutputImpl(
+    uint32_t mailbox_index, uint32_t frontbuffer_width, uint32_t frontbuffer_height,
+    std::function<bool(GuestOutputRefreshContext&)> refresher, bool& is_8bpc_out_ref) {
+  (void)mailbox_index;
+  (void)is_8bpc_out_ref;
+  // The refresher (command processor / swap path) uploads the guest image and
+  // calls SetGuestTexture; it must return true on success.
+  WebGPUGuestOutputRefreshContext ctx(is_8bpc_out_ref);
+  return refresher(ctx);
+}
+
+void WebGPUPresenter::SetGuestTexture(WGPUTexture texture, uint32_t width,
+                                      uint32_t height) {
+  if (guest_view_) {
+    wgpuTextureViewRelease(guest_view_);
+    guest_view_ = nullptr;
+  }
+  guest_texture_ = texture;
+  guest_width_ = width;
+  guest_height_ = height;
+  if (texture) {
+    WGPUTextureViewDescriptor vdesc = {};
+    vdesc.format = WGPUTextureFormat_BGRA8Unorm;
+    vdesc.dimension = WGPUTextureViewDimension_2D;
+    vdesc.aspect = WGPUTextureAspect_All;
+    guest_view_ = wgpuTextureCreateView(texture, &vdesc);
+  }
+}
+
+bool WebGPUPresenter::EnsurePaintPipeline() {
+  if (!device_ || !device_->ready() || paint_.pipeline) return paint_.pipeline;
+  if (!CreatePaintPipeline(device_->device(), device_->surface_format(),
+                           paint_)) {
+    return false;
+  }
+  WGPUSamplerDescriptor sdesc = {};
+  sdesc.magFilter = WGPUFilterMode_Linear;
+  sdesc.minFilter = WGPUFilterMode_Linear;
+  sdesc.addressModeU = WGPUAddressMode_ClampToEdge;
+  sdesc.addressModeV = WGPUAddressMode_ClampToEdge;
+  paint_sampler_ = wgpuDeviceCreateSampler(device_->device(), &sdesc);
+  return paint_.pipeline && paint_sampler_;
+}
+
+rex::ui::Presenter::PaintResult WebGPUPresenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  (void)execute_ui_drawers;  // UI overlay draw is a Phase 4 item.
+  if (!device_ || !device_->ready() || !connected_) return PaintResult::kNotPresented;
+  if (!EnsurePaintPipeline() || !guest_view_) return PaintResult::kNotPresented;
+  bool suboptimal = false;
+  WGPUTexture surface_tex = device_->AcquireSurfaceTexture(&suboptimal);
+  if (!surface_tex) return PaintResult::kNotPresented;
+
+  WGPUTextureViewDescriptor svdesc = {};
+  svdesc.format = device_->surface_format();
+  svdesc.dimension = WGPUTextureViewDimension_2D;
+  svdesc.aspect = WGPUTextureAspect_All;
+  WGPUTextureView surface_view = wgpuTextureCreateView(surface_tex, &svdesc);
+  if (!surface_view) return PaintResult::kNotPresented;
+
+  // Letterbox transform for the guest image in the surface, then a real bind
+  // group for the guest texture + sampler.
+  UpdatePaintLetterbox(device_->queue(), paint_, device_->surface_width(),
+                       device_->surface_height(), guest_width_, guest_height_);
+  WGPUBindGroup texture_group = CreatePaintTextureBindGroup(
+      device_->device(), paint_, guest_view_, paint_sampler_);
+
+  WGPURenderPassColorAttachment color = {};
+  color.view = surface_view;
+  color.loadOp = WGPULoadOp_Clear;
+  color.storeOp = WGPUStoreOp_Store;
+  color.clearValue = WGPUColor{0.0, 0.0, 0.0, 1.0};
+  WGPURenderPassDescriptor rpdesc = {};
+  rpdesc.colorAttachmentCount = 1;
+  rpdesc.colorAttachments = &color;
+  WGPUCommandEncoderDescriptor edesc = {};
+  WGPUCommandEncoder encoder = wgpuDeviceCreateCommandEncoder(device_->device(), &edesc);
+  if (encoder) {
+    WGPURenderPassEncoder pass = wgpuCommandEncoderBeginRenderPass(encoder, &rpdesc);
+    if (pass) {
+      if (paint_.pipeline && texture_group) {
+        wgpuRenderPassEncoderSetPipeline(pass, paint_.pipeline);
+        wgpuRenderPassEncoderSetBindGroup(pass, 0, paint_.bind_group, 0, nullptr);
+        wgpuRenderPassEncoderSetBindGroup(pass, 1, texture_group, 0, nullptr);
+        wgpuRenderPassEncoderDraw(pass, 6, 1, 0, 0);
+      }
+      wgpuRenderPassEncoderEnd(pass);
+      wgpuRenderPassEncoderRelease(pass);
+    }
+    WGPUCommandBufferDescriptor cbdesc = {};
+    WGPUCommandBuffer cb = wgpuCommandEncoderFinish(encoder, &cbdesc);
+    if (cb) {
+      wgpuQueueSubmit(device_->queue(), 1, &cb);
+      wgpuCommandBufferRelease(cb);
+    }
+    wgpuCommandEncoderRelease(encoder);
+  }
+  if (texture_group) wgpuBindGroupRelease(texture_group);
+  wgpuTextureViewRelease(surface_view);
+  device_->Present();
+  return PaintResult::kPresented;
+}
+
+// ------------------------------- provider ----------------------------------
+
+std::unique_ptr<rex::ui::Presenter> WebGPUProvider::CreatePresenter(
+    rex::ui::Presenter::HostGpuLossCallback host_gpu_loss_callback) {
+  return std::make_unique<WebGPUPresenter>(host_gpu_loss_callback, device_);
+}
+
+std::unique_ptr<rex::ui::ImmediateDrawer> WebGPUProvider::CreateImmediateDrawer() {
+  return std::make_unique<WebGPUImmediateDrawer>(device_);
+}
+
+// --------------------------- immediate drawer -------------------------------
+
+class WebGPUImmediateTexture : public rex::ui::ImmediateTexture {
+ public:
+  WebGPUImmediateTexture(uint32_t width, uint32_t height)
+      : ImmediateTexture(width, height) {}
+  WGPUTexture texture = nullptr;
+};
+
+std::unique_ptr<rex::ui::ImmediateTexture> WebGPUImmediateDrawer::CreateTexture(
+    uint32_t width, uint32_t height, rex::ui::ImmediateTextureFilter filter,
+    bool is_repeated, const uint8_t* data) {
+  (void)filter;
+  (void)is_repeated;
+  auto tex = std::make_unique<WebGPUImmediateTexture>(width, height);
+  if (device_ && device_->ready() && data) {
+    WGPUTextureDescriptor desc = {};
+    desc.size = {width, height, 1};
+    desc.format = WGPUTextureFormat_RGBA8Unorm;
+    desc.usage = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst;
+    tex->texture = wgpuDeviceCreateTexture(device_->device(), &desc);
+    if (tex->texture && device_->queue()) {
+      WGPUTexelCopyTextureInfo dst = {};
+      dst.texture = tex->texture;
+      dst.aspect = WGPUTextureAspect_All;
+      WGPUTexelCopyBufferLayout layout = {};
+      layout.bytesPerRow = width * 4;
+      layout.rowsPerImage = height;
+      WGPUExtent3D size = {width, height, 1};
+      wgpuQueueWriteTexture(device_->queue(), &dst, data, size_t(width) * height * 4,
+                            &layout, &size);
+    }
+  }
+  return tex;
+}
+
+void WebGPUImmediateDrawer::Begin(rex::ui::UIDrawContext& ui_draw_context,
+                                  float coordinate_space_width,
+                                  float coordinate_space_height) {
+  (void)ui_draw_context;
+  (void)coordinate_space_width;
+  (void)coordinate_space_height;
+  // Phase 4: UI overlay pipeline (ImGui support).
+}
+
+void WebGPUImmediateDrawer::BeginDrawBatch(const rex::ui::ImmediateDrawBatch& batch) {
+  (void)batch;
+}
+
+void WebGPUImmediateDrawer::Draw(const rex::ui::ImmediateDraw& draw) { (void)draw; }
+
+void WebGPUImmediateDrawer::EndDrawBatch() {}
+
+}  // namespace rex::graphics::webgpu
