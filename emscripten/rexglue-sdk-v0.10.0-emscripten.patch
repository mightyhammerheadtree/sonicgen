+WebGPUCommandProcessor::WebGPUCommandProcessor(
+    GraphicsSystem* graphics_system, system::KernelState* kernel_state,
+    WebGPUDevice* device)
+    : CommandProcessor(graphics_system, kernel_state), device_(device) {
+  legacy_readback_memexport_cvar_name_ = "gpu_webgpu_readback_memexport";
+}
+
+WebGPUCommandProcessor::~WebGPUCommandProcessor() = default;
+
+bool WebGPUCommandProcessor::Initialize() {
+  shared_memory_ = std::make_unique<WebGPUSharedMemory>();
+  constant_buffers_ = std::make_unique<WebGPUConstantBuffers>();
+  texture_cache_ = std::make_unique<WebGPUTextureCache>();
+  render_target_cache_ = std::make_unique<WebGPURenderTargetCache>();
+  pipeline_cache_ = std::make_unique<WebGPUPipelineCache>();
+  return CommandProcessor::Initialize();
+}
+
+void WebGPUCommandProcessor::Shutdown() {
+  deferred_queue_.Push([this]() {
+    pipeline_cache_->Shutdown();
+    render_target_cache_->Shutdown();
+    texture_cache_->Shutdown();
+    constant_buffers_->Shutdown();
+    shared_memory_->Shutdown();
+    DestroyPaintPipeline(paint_);
+    paint_created_ = false;
+    if (paint_sampler_handle_) {
+      wgpuSamplerRelease(paint_sampler_handle_);
+      paint_sampler_handle_ = nullptr;
+    }
+  });
+  deferred_queue_.Drain();
+  shared_memory_.reset();
+  constant_buffers_.reset();
+  texture_cache_.reset();
+  render_target_cache_.reset();
+  pipeline_cache_.reset();
+  CommandProcessor::Shutdown();
+}
+
+bool WebGPUCommandProcessor::SetupContext() {
+  if (!device_) return false;
+  // Device acquisition is asynchronous in the browser: kick it off and let
+  // PumpFrame() complete the state machine on the main thread. The command
+  // processor thread can proceed; draws are queued until the device is ready.
+  deferred_queue_.Push([this]() { device_->Initialize("#canvas"); });
+
+  deferred_queue_.Push([this]() {
+    if (!device_->ready()) return;
+    shared_memory_->Initialize(device_->device(), device_->queue(),
+                               kSharedMemorySize);
+    constant_buffers_->Initialize(device_->device(), device_->queue());
+    texture_cache_->Initialize(device_->device(), device_->queue());
+    render_target_cache_->Initialize(device_->device());
+    pipeline_cache_->Initialize(device_->device(), device_->surface_format());
+  });
+
+  // The SPIR-V translator operates fully on the CP thread (no host GPU API).
+  auto features = SpirvShaderTranslator::Features(true);
+  shader_translator_ = std::make_unique<SpirvShaderTranslator>(
+      features, false, false, false);
+  return true;
+}
+
+void WebGPUCommandProcessor::ShutdownContext() {
+  // Caches are shut down through the deferred queue in Shutdown().
+}
+
+Shader* WebGPUCommandProcessor::LoadShader(xenos::ShaderType shader_type,
+                                           uint32_t guest_address,
+                                           const uint32_t* host_address,
+                                           uint32_t dword_count) {
+  auto shader = std::make_unique<WebGPUShader>(
+      shader_type,
+      XXH3_64bits(host_address, dword_count * sizeof(uint32_t)), host_address,
+      dword_count);
+  // Translation happens at draw capture time (CaptureShader), on the command
+  // processor thread, like the Vulkan backend.
+  return shader.release();
+}
+
+// --------------------------- draw capture (CP thread) -----------------------
+
+bool WebGPUCommandProcessor::CaptureShader(WebGPUShader* shader, bool vertex,
+                                           uint32_t program_cntl,
+                                           std::string& wgsl_out,
+                                           uint64_t& hash_out,
+                                           uint32_t& texture_count_out) {
+  texture_count_out = 0;
+  if (!shader) return vertex;  // missing pixel shader = depth-only pass
+  uint32_t dynamic_count = shader->GetDynamicAddressableRegisterCount(
+      program_cntl);
+  uint64_t modification =
+      vertex ? shader_translator_->GetDefaultVertexShaderModification(
+                   dynamic_count)
+             : shader_translator_->GetDefaultPixelShaderModification(
+                   dynamic_count);
+  bool is_new = false;
+  auto* translation = static_cast<WebGPUShader::WebGPUTranslation*>(
+      shader->GetOrCreateTranslation(modification, &is_new));
+  if (!translation) return false;
+  if (is_new || !translation->is_valid() ||
+      translation->translated_binary().empty()) {
+    if (!shader_translator_->TranslateAnalyzedShader(*translation)) {
+      REXGPU_ERROR("webgpu: shader translation failed ({:016X})",
+                   shader->ucode_data_hash());
+      return false;
+    }
+  }
+  if (!translation->EnsureWGSLTranslated()) return false;
+  wgsl_out = translation->wgsl();
+  hash_out = shader->ucode_data_hash() ^ modification;
+  // Texture binding count for the fixed ABI (textures before samplers).
+  texture_count_out = uint32_t(
+      shader->GetTextureBindingsAfterTranslation().size());
+  return true;
+}
+
+void WebGPUCommandProcessor::CaptureConstants(
+    WebGPUShader* vs, WebGPUShader* ps, CapturedConstants& constants) {
+  const uint32_t* values = register_file_->values;
+
+  // System constants: index parameters + direct NDC pass-through with Y flip
+  // (the surface is sized to the guest viewport in this backend, so the
+  // viewport transform is the identity + flip).
+  SpirvShaderTranslator::SystemConstants system;
+  std::memset(&system, 0, sizeof(system));
+  system.vertex_index_endian = xenos::Endian::k8in32;
+  system.line_loop_closing_index = UINT32_MAX;
+  system.ndc_scale[0] = 1.0f;
+  system.ndc_scale[1] = -1.0f;
+  system.ndc_scale[2] = 1.0f;
+  constants.system.resize(sizeof(system));
+  std::memcpy(constants.system.data(), &system, sizeof(system));
+
+  // Float constants, tightly packed per each shader's register map.
+  if (vs) {
+    PackFloatConstants(values + kShaderConstantBankVS,
+                       vs->constant_register_map(), constants.float_vs);
+  }
+  if (ps) {
+    PackFloatConstants(values + kShaderConstantBankPS,
+                       ps->constant_register_map(), constants.float_ps);
+  }
+
+  // Bool (256 bits) and loop constants.
+  constants.bool_loop.resize(40 * sizeof(uint32_t), 0);  // 8 + 32 dwords
+  AppendRegisterBlock(values, kShaderConstantBool, 8, constants.bool_loop);
+  // Only 4 loop constant registers exist on the GPU; the WGSL buffer reserves
+  // 32 (games rarely nest loops deeper than 4 - documented v1 limitation).
+  AppendRegisterBlock(values, kShaderConstantLoop, 4, constants.bool_loop);
+
+  // Texture fetch constants (32 x 6 dwords), used by all vertex fetches.
+  AppendRegisterBlock(values, kShaderConstantFetch, 32 * 6, constants.fetch);
+}
+
+void WebGPUCommandProcessor::CaptureTextures(
+    WebGPUShader* shader, uint32_t packed_key_offset,
+    std::vector<CapturedTexture>& textures_out) {
+  if (!shader) return;
+  RegisterFile* regs = register_file_;
+  uint32_t index = 0;
+  for (const SpirvShader::TextureBinding& binding :
+       shader->GetTextureBindingsAfterTranslation()) {
+    xenos::xe_gpu_texture_fetch_t fetch = regs->GetTextureFetch(
+        binding.fetch_constant);
+    CapturedTexture captured;
+    captured.key.guest_base = fetch.base_address << 12;
+    captured.key.width = fetch.size_2d.width + 1;
+    captured.key.height = fetch.size_2d.height + 1;
+    // Canonical host format for all guest textures in v1.
+    captured.key.format = WGPUTextureFormat_BGRA8Unorm;
+    // Sampler state packed for the cache (filters come from the fetch).
+    uint32_t packed = uint32_t(fetch.mag_filter) |
+                      (uint32_t(fetch.min_filter) << 2) |
+                      (uint32_t(fetch.mip_filter) << 4) |
+                      (uint32_t(fetch.aniso_filter) << 6);
+    captured.sampler_state = packed | (packed_key_offset << 24);
+    if (fetch.tiled == 0 && captured.key.width && captured.key.height) {
+      uint32_t row_pitch = uint32_t(fetch.pitch) << 5;
+      uint32_t bytes_per_texel =
+          (fetch.format == xenos::TextureFormat::k_2_10_10_10) ? 4u : 2u;
+      if (fetch.format == xenos::TextureFormat::k_8_8_8_8) bytes_per_texel = 4;
+      size_t needed =
+          size_t(row_pitch) * (captured.key.height - 1) +
+          size_t(captured.key.width) * bytes_per_texel;
+      if (needed <= kMaxCaptureBytes) {
+        const uint8_t* guest = memory_->TranslatePhysical<const uint8_t*>(
+            captured.key.guest_base);
+        if (guest) {
+          ConvertLinearTexture(guest, needed, fetch.format,
+                               captured.key.width, captured.key.height,
+                               row_pitch, fetch.endianness, captured.data);
+        }
+      }
+    }
+    textures_out.push_back(std::move(captured));
+    ++index;
+  }
+}
+
+bool WebGPUCommandProcessor::CaptureDraw(xenos::PrimitiveType prim_type,
+                                         uint32_t index_count,
+                                         IndexBufferInfo* index_buffer_info,
+                                         CapturedDraw& draw) {
+  RegisterFile* regs = register_file_;
+  const uint32_t program_cntl = regs->Get<reg::SQ_PROGRAM_CNTL>().value;
+  uint32_t vs_program_cntl = (program_cntl & 0x3F);
+  uint32_t ps_program_cntl = (program_cntl >> 8) & 0x3F;
+
+  auto* vs = static_cast<WebGPUShader*>(active_vertex_shader());
+  auto* ps = static_cast<WebGPUShader*>(active_pixel_shader());
+  draw.depth_only = ps == nullptr;
+  if (!CaptureShader(vs, true, vs_program_cntl, draw.vs_wgsl, draw.vs_hash,
+                     draw.vs_texture_count) ||
+      !CaptureShader(ps, false, ps_program_cntl, draw.ps_wgsl, draw.ps_hash,
+                     draw.ps_texture_count)) {
+    return false;
+  }
+
+  CaptureConstants(vs, ps, draw.constants);
+  CaptureTextures(vs, 1, draw.vs_textures);
+  CaptureTextures(ps, 2, draw.ps_textures);
+
+  // Index buffer: captured immediately (guest memory may change before the
+  // main thread drains the queue).
+  if (index_buffer_info && index_buffer_info->guest_base &&
+      index_buffer_info->length) {
+    size_t length = std::min(index_buffer_info->length,
+                             size_t(kMaxCaptureBytes));
+    const uint8_t* src = memory_->TranslatePhysical<const uint8_t*>(
+        index_buffer_info->guest_base);
+    if (src) {
+      draw.index_buffer.guest_address = index_buffer_info->guest_base;
+      draw.index_buffer.data.assign(src, src + length);
+      draw.index_format = index_buffer_info->format;
+    }
+  }
+  draw.index_count = index_count;
+
+  // Vertex fetch ranges referenced by the current shaders.
+  const uint32_t* values = regs->values;
+  const Shader::ConstantRegisterMap* maps[2] = {
+      vs ? &vs->constant_register_map() : nullptr,
+      ps ? &ps->constant_register_map() : nullptr};
+  uint32_t used_vertex_fetch[96 / 32] = {};
+  for (const auto* map : maps) {
+    if (!map) continue;
+    for (uint32_t i = 0; i < 3; ++i) used_vertex_fetch[i] |= map->vertex_fetch_bitmap[i];
+  }
+  for (uint32_t block = 0; block < 3; ++block) {
+    uint32_t bits = used_vertex_fetch[block];
+    while (bits) {
+      uint32_t bit = uint32_t(std::countr_zero(bits));
+      uint32_t fetch_index = block * 32 + bit;
+      xenos::xe_gpu_vertex_fetch_t vf = regs->GetVertexFetch(fetch_index);
+      uint32_t address = vf.address * 4;
+      uint32_t size = vf.size * 4;
+      if (size && address + size <= kSharedMemorySize &&
+          size <= kMaxCaptureBytes) {
+        const uint8_t* src = memory_->TranslatePhysical<const uint8_t*>(address);
+        if (src) {
+          CapturedDraw::MemoryRange range;
+          range.guest_address = address;
+          range.data.assign(src, src + size);
+          draw.ranges.push_back(std::move(range));
+        }
+      }
+      bits &= bits - 1;
+    }
+  }
+
+  // Color render target 0: EDRAM tile base + format; size from the screen
+  // scissor (the guest renders inside the scissor box).
+  reg::RB_COLOR_INFO color_info = regs->Get<reg::RB_COLOR_INFO>();
+  draw.rt_base = color_info.color_base | (color_info.color_base_bit_11 << 11);
+  draw.rt_format = color_info.color_format;
+  reg::PA_SC_SCREEN_SCISSOR_TL scissor_tl = regs->Get<reg::PA_SC_SCREEN_SCISSOR_TL>();
+  reg::PA_SC_SCREEN_SCISSOR_BR scissor_br = regs->Get<reg::PA_SC_SCREEN_SCISSOR_BR>();
+  int32_t width = scissor_br.br_x - scissor_tl.tl_x;
+  int32_t height = scissor_br.br_y - scissor_tl.tl_y;
+  draw.rt_width = uint32_t(std::clamp(width, 1, 8192));
+  draw.rt_height = uint32_t(std::clamp(height, 1, 8192));
+
+  // Blend state (target 0) + write mask, packed for the pipeline key.
+  reg::RB_BLENDCONTROL blend_control = regs->Get<reg::RB_BLENDCONTROL>();
+  reg::RB_COLOR_MASK color_mask = regs->Get<reg::RB_COLOR_MASK>();
+  bool blend_active = !(blend_control.color_srcblend ==
+                            xenos::BlendFactor::kOne &&
+                        blend_control.color_destblend ==
+                            xenos::BlendFactor::kZero);
+  draw.blend_packed = PackBlendState(blend_control.value, color_mask.value,
+                                     blend_active);
+  draw.topology = MapTopology(prim_type);
+  return true;
+}
+
+uint32_t WebGPUCommandProcessor::PackBlendState(uint32_t blend_control,
+                                                uint32_t color_mask,
+                                                bool blend_active) {
+  auto map_factor = [](uint32_t guest_factor) -> uint32_t {
+    switch (xenos::BlendFactor(guest_factor & 31u)) {
+      case xenos::BlendFactor::kZero: return 0;
+      case xenos::BlendFactor::kOne: return 1;
+      case xenos::BlendFactor::kSrcColor: return 2;
+      case xenos::BlendFactor::kOneMinusSrcColor: return 3;
+      case xenos::BlendFactor::kSrcAlpha: return 4;
+      case xenos::BlendFactor::kOneMinusSrcAlpha: return 5;
+      case xenos::BlendFactor::kDstColor: return 6;
+      case xenos::BlendFactor::kOneMinusDstColor: return 7;
+      case xenos::BlendFactor::kDstAlpha: return 8;
+      case xenos::BlendFactor::kOneMinusDstAlpha: return 9;
+      case xenos::BlendFactor::kConstantColor: return 10;
+      case xenos::BlendFactor::kOneMinusConstantColor: return 11;
+      case xenos::BlendFactor::kConstantAlpha: return 12;
+      case xenos::BlendFactor::kOneMinusConstantAlpha: return 11;
+      case xenos::BlendFactor::kSrcAlphaSaturate: return 12;
+      default: return 0;
+    }
+  };
+  auto map_op = [](uint32_t guest_op) -> uint32_t {
+    switch (xenos::BlendOp(guest_op & 7u)) {
+      case xenos::BlendOp::kAdd: return 0;
+      case xenos::BlendOp::kSubtract: return 1;
+      case xenos::BlendOp::kRevSubtract: return 2;
+      case xenos::BlendOp::kMin: return 3;
+      case xenos::BlendOp::kMax: return 4;
+      default: return 0;
+    }
+  };
+  // RB_BLENDCONTROL layout: src 5b @0, op 3b @5, dst 5b @8, alpha src 5b @16,
+  // alpha op 3b @21, alpha dst 5b @24.
+  uint32_t color_src = (blend_control >> 0) & 31u;
+  uint32_t color_op = (blend_control >> 5) & 7u;
+  uint32_t color_dst = (blend_control >> 8) & 31u;
+  uint32_t alpha_src = (blend_control >> 16) & 31u;
+  uint32_t alpha_op = (blend_control >> 21) & 7u;
+  uint32_t alpha_dst = (blend_control >> 24) & 31u;
+  if (!blend_active) {
+    color_src = alpha_src = 1;   // One
+    color_dst = alpha_dst = 0;   // Zero
+  }
+  uint32_t write_mask = color_mask & 0xFu;
+  if (!write_mask) write_mask = 0xFu;
+  uint32_t packed = map_op(color_op) | (map_factor(color_src) << 3) |
+                    (map_factor(color_dst) << 7) | (map_op(alpha_op) << 11) |
+                    (map_factor(alpha_src) << 14) |
+                    (map_factor(alpha_dst) << 18) | (write_mask << 22);
+  return packed;
+}
+
+uint8_t WebGPUCommandProcessor::MapTopology(xenos::PrimitiveType prim_type) {
+  switch (prim_type) {
+    case xenos::PrimitiveType::kPointList:
+      return uint8_t(WGPUPrimitiveTopology_PointList);
+    case xenos::PrimitiveType::kLineList:
+      return uint8_t(WGPUPrimitiveTopology_LineList);
+    case xenos::PrimitiveType::kLineStrip:
+      return uint8_t(WGPUPrimitiveTopology_LineStrip);
+    case xenos::PrimitiveType::kTriangleStrip:
+      return uint8_t(WGPUPrimitiveTopology_TriangleStrip);
+    // Quad/fan/rectangle lists are converted to lists by the guest-side
+    // primitive processing on real hardware paths; v1 renders them as lists
+    // (documented limitation until PrimitiveProcessor is wired in).
+    default:
+      return uint8_t(WGPUPrimitiveTopology_TriangleList);
+  }
+}
+
+bool WebGPUCommandProcessor::MemoryRangeForGuestAddress(
+    uint32_t guest_address, uint32_t shared_memory_capacity) {
+  return guest_address < shared_memory_capacity;
+}
