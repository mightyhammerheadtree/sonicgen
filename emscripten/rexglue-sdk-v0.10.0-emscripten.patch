+#pragma once
+/**
+ * @file        webgpu/resources.h
+ * @brief       WebGPU resource caches: shared memory, constant buffers,
+ *              textures, render targets, pipelines
+ *
+ * Creation/updating happens on the main thread (through the deferred queue);
+ * the command processor thread only records operations and reads cache
+ * lookup results. All GPU objects are keyed by guest identity (address,
+ * format, dimensions) the same way the Vulkan backend caches are.
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <webgpu/webgpu.h>
+
+#include <rex/graphics/xenos.h>
+
+#include "webgpu_util.h"
+
+namespace rex::graphics::webgpu {
+
+// ---------------------------------------------------------------------------
+// Shared memory: a device-side read-only storage buffer mirroring the guest's
+// shared memory window (vertex/index fetch data, inline draw data). Bound in
+// shader descriptor set 0, binding 0.
+// ---------------------------------------------------------------------------
+class WebGPUSharedMemory {
+ public:
+  void Initialize(WGPUDevice device, WGPUQueue queue, uint32_t capacity);
+  void Shutdown();
+
+  // Copies bytes from the guest (captured on the CP thread) into the buffer.
+  void Upload(uint32_t guest_offset, const std::vector<uint8_t>& data);
+
+  // Bind group over set 0 (created lazily, reused for all draws).
+  WGPUBindGroup GetBindGroup(WGPUDevice device);
+  WGPUBuffer buffer() const { return buffer_; }
+  uint32_t capacity() const { return capacity_; }
+
+ private:
+  WGPUDevice device_ = nullptr;
+  WGPUQueue queue_ = nullptr;
+  WGPUBuffer buffer_ = nullptr;
+  WGPUBindGroupLayout bind_group_layout_ = nullptr;
+  WGPUBindGroup bind_group_ = nullptr;
+  uint32_t capacity_ = 0;
+};
+
+// ---------------------------------------------------------------------------
+// Constant buffers: the five uniform buffers of shader descriptor set 1
+// (system, float VS, float PS, bool/loop, fetch). The CP thread captures the
+// register banks per draw; the main thread uploads them and binds the set.
+// ---------------------------------------------------------------------------
+struct CapturedConstants {
+  // SpirvShaderTranslator::SystemConstants filled by the command processor.
+  std::vector<uint8_t> system;      // sizeof(SystemConstants), std140 layout
+  std::vector<uint8_t> float_vs;    // 256 float4, tight packing when no
+                                    // dynamic addressing, else full bank
+  std::vector<uint8_t> float_ps;    // same for the pixel shader
+  std::vector<uint8_t> bool_loop;   // 256 bools (2 x uint4) + 32 loop (8 x uint4)
+  std::vector<uint8_t> fetch;       // 32 x 6 uints
+};
+
+class WebGPUConstantBuffers {
+ public:
+  void Initialize(WGPUDevice device, WGPUQueue queue);
+  void Shutdown();
+
+  // Uploads the captured banks into the device-side buffers and returns the
+  // set-1 bind group (recreated only when a buffer size changes).
+  WGPUBindGroup Upload(WGPUDevice device, const CapturedConstants& constants);
+
+ private:
+  WGPUBuffer CreateBuffer(uint32_t size, const char* label);
+  WGPUBindGroup RefreshBindGroup(WGPUDevice device);
+  WGPUDevice device_ = nullptr;
+  WGPUQueue queue_ = nullptr;
+  WGPUBuffer buffers_[kConstantBufferCount] = {};
+  uint32_t buffer_sizes_[kConstantBufferCount] = {};
+  WGPUBindGroupLayout bind_group_layout_ = nullptr;
+  WGPUBindGroup bind_group_ = nullptr;
+};
+
+// ---------------------------------------------------------------------------
+// Texture cache: guest texture descriptions -> sampled WGPUTextures, plus a
+// sampler cache keyed by the guest filter state. Textures are uploaded in the
+// canonical host format (see MapGuestColorFormat) with data converted on the
+// CP thread.
+// ---------------------------------------------------------------------------
+struct TextureKey {
+  uint32_t guest_base;
+  uint32_t width, height;
+  uint32_t format;  // WGPUTextureFormat
+  bool operator==(const TextureKey& o) const {
+    return guest_base == o.guest_base && width == o.width && height == o.height &&
+           format == o.format;
+  }
+};
+
+struct TextureKeyHash {
+  size_t operator()(const TextureKey& k) const {
+    return size_t(k.guest_base) * 73856093u ^ size_t(k.width) * 19349663u ^
+           size_t(k.height) * 83492791u ^ size_t(k.format) * 2971215073u;
+  }
+};
+
+struct SamplerStateKey {
+  uint32_t value;  // packed filters + aniso
+  bool operator==(const SamplerStateKey& o) const { return value == o.value; }
+};
+
+struct SamplerStateKeyHash {
+  size_t operator()(const SamplerStateKey& k) const { return size_t(k.value); }
+};
+
+class WebGPUTextureCache {
+ public:
+  void Initialize(WGPUDevice device, WGPUQueue queue);
+  void Shutdown();
+  void Clear();
+
+  // Uploads texture bytes (converted to the host format on the CP thread).
+  void Upload(const TextureKey& key, const std::vector<uint8_t>& data);
+  // Gets or creates the sample view of the texture; a 1x1 transparent null
+  // texture is substituted for unknown keys so draws never fail on unbound
+  // textures.
+  WGPUTextureView GetView(const TextureKey& key);
+  WGPUSampler GetSampler(uint32_t packed_state,
+                         const xenos::xe_gpu_texture_fetch_t& fetch);
+
+ private:
+  WGPUTextureView CreateViewForTexture(WGPUTexture texture,
+                                       WGPUTextureFormat format);
+  WGPUTexture Get(const TextureKey& key) const;
+  struct Entry {
+    WGPUTexture texture = nullptr;
+    WGPUTextureView view = nullptr;
+  };
+  WGPUDevice device_ = nullptr;
+  WGPUQueue queue_ = nullptr;
+  std::unordered_map<TextureKey, Entry, TextureKeyHash> entries_;
+  // Null texture substitute (1x1 BGRA8, cleared once).
+  WGPUTexture null_texture_ = nullptr;
+  WGPUTextureView null_view_ = nullptr;
+  std::unordered_map<SamplerStateKey, WGPUSampler, SamplerStateKeyHash>
+      samplers_;
+};
+
+// ---------------------------------------------------------------------------
+// Render target cache: guest EDRAM render targets -> renderable WGPUTextures.
+// Keyed by the EDRAM tile base; textures carry CopySrc/CopyDst so the resolve
+// path can copy between them.
+// ---------------------------------------------------------------------------
+class WebGPURenderTargetCache {
+ public:
+  void Initialize(WGPUDevice device);
+  void Shutdown();
+  void Clear();
+
+  // Returns (creating if needed) the render attachment view for a guest
+  // surface; width/height come from the surface registers, format from the
+  // guest color format mapping.
+  WGPUTextureView GetView(uint32_t edram_base, uint32_t width, uint32_t height,
+                          WGPUTextureFormat format);
+  // Resolve destination (same cache; only used with CopyDst on creation).
+  WGPUTexture GetTexture(uint32_t edram_base, uint32_t width, uint32_t height,
+                         WGPUTextureFormat format);
+  // Removes targets whose guest EDRAM tile range intersects the cleared
+  // range (guest clears are issued in tiles).
+  void InvalidateRange(uint32_t start_tile, uint32_t tile_count);
+
+ private:
+  struct Entry {
+    WGPUTexture texture = nullptr;
+    WGPUTextureView view = nullptr;
+    uint32_t width = 0;
+    uint32_t height = 0;
+  };
+  WGPUDevice device_ = nullptr;
+  std::unordered_map<uint32_t, Entry> entries_;  // by EDRAM tile base
+};
+
+// ---------------------------------------------------------------------------
+// Pipeline cache: (vertex shader, pixel shader, ABI, state) -> render
+// pipeline. The fixed ABI means the layout only varies with the texture
+// counts; blend and topology come from the guest registers captured at draw
+// time and are part of the key.
+// ---------------------------------------------------------------------------
+struct WebGPUPipelineKey {
+  uint64_t vertex_hash;
+  uint64_t pixel_hash;
+  uint32_t vs_texture_count;
+  uint32_t ps_texture_count;
+  uint32_t blend_packed;   // alpha blend packed: color op/src/dst, alpha
+                           // op/src/dst, write mask
+  uint8_t topology;        // WGPUPrimitiveTopology
+  uint8_t has_pixel_shader;
+  bool operator==(const WebGPUPipelineKey& o) const {
+    return vertex_hash == o.vertex_hash && pixel_hash == o.pixel_hash &&
+           vs_texture_count == o.vs_texture_count &&
+           ps_texture_count == o.ps_texture_count &&
+           blend_packed == o.blend_packed && topology == o.topology &&
+           has_pixel_shader == o.has_pixel_shader;
+  }
+};
+
+struct WebGPUPipelineKeyHash {
+  size_t operator()(const WebGPUPipelineKey& k) const {
+    return size_t(k.vertex_hash) * 73856093u ^ size_t(k.pixel_hash) * 19349663u ^
+           size_t(k.vs_texture_count) * 2971215073u ^
+           size_t(k.ps_texture_count) * 40503u ^ size_t(k.blend_packed) *
+               83492791u ^
+           size_t(k.topology) * 193491663u ^
+           size_t(k.has_pixel_shader) * 73856091u;
+  }
+};
+
+class WebGPUPipelineCache {
+ public:
+  void Initialize(WGPUDevice device, WGPUTextureFormat target_format);
+  void Shutdown();
+  void Clear();
+
+  // Returns the pipeline for the captured state, creating it on first use.
+  // Either module may be null (depth-only pass). Layouts follow the fixed ABI.
+  WGPURenderPipeline GetOrCreate(WGPUShaderModule vertex_module,
+                                 WGPUShaderModule pixel_module,
+                                 const WebGPUPipelineKey& key);
+
+ private:
+  WGPUDevice device_ = nullptr;
+  WGPUTextureFormat target_format_ = WGPUTextureFormat_BGRA8Unorm;
+  std::unordered_map<WebGPUPipelineKey, WGPURenderPipeline,
+                     WebGPUPipelineKeyHash>
+      entries_;
+};
+
+}  // namespace rex::graphics::webgpu
