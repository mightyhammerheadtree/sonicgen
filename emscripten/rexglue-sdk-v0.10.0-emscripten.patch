+// --- builtins ---
+enum : uint32_t {
+  kBiPosition = 0,
+  kBiVertexId = 5,
+  kBiInstanceId = 6,
+  kBiFragCoord = 15,
+  kBiFrontFacing = 17,
+  kBiFragDepth = 22,
