diff --git a/src/core/fiber_wasm.cpp b/src/core/fiber_wasm.cpp
new file mode 100644
index 0000000..82fd1c3
--- /dev/null
+++ b/src/core/fiber_wasm.cpp
@@ -0,0 +1,78 @@
+/**
+ * @file        fiber_wasm.cpp
+ * @brief       WebAssembly backend for rex::thread::Fiber (emscripten/fiber.h)
+ *
+ * Emscripten implements emscripten_fiber_swap on top of JSPI (-sJSPI, shipping
+ * wasm stack-switching) or Binaryen Asyncify (-sASYNCIFY). JSPI is preferred
+ * at build time: it keeps hot paths untouched, while Asyncify transforms the
+ * whole module and costs roughly 2x code size and some runtime overhead.
+ * Guest fibers here behave exactly like the ucontext backend: switching
+ * preserves the full C++ call stack.
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_EMSCRIPTEN
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  // The thread's own context needs a stack region record but never actually
+  // switches to a fresh stack; give it a nominal 64 KiB window.
+  emscripten_fiber_init_from_current_context(&f->context_, nullptr, 0,
+                                             &f->asyncify_data_);
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  // emscripten_fiber_init takes the stack from the TOP (grows down), matching
+  // native stacks; pass the highest address as the base.
+  emscripten_fiber_init(&f->context_, &Fiber::Trampoline, f,
+                        static_cast<unsigned>(f->stack_.size()),
+                        f->stack_.data() + f->stack_.size(), &f->asyncify_data_);
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline(void* arg) {
+  // tls_current_ was updated by SwitchTo before the swap resumed here.
+  auto* f = static_cast<Fiber*>(arg);
+  tls_current_ = f;
+  f->entry_(f->arg_);
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  assert(from != nullptr && "SwitchTo before ConvertCurrentThread");
+  tls_current_ = target;
+  emscripten_fiber_swap(&from->context_, &target->context_);
+}
+
+void Fiber::Destroy() {
+  // Thread fibers are destroyed from the owning thread itself.
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  // stack_ is freed by the vector destructor.
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_EMSCRIPTEN
