diff --git a/src/graphics/webgpu/command_processor.cpp b/src/graphics/webgpu/command_processor.cpp
new file mode 100644
index 0000000..2061f14
--- /dev/null
+++ b/src/graphics/webgpu/command_processor.cpp
@@ -0,0 +1,841 @@
+/**
+ * @file        webgpu/command_processor.cpp
+ * @brief       WebGPU backend command processor (implementation)
+ *
+ * The PM4 packet parsing runs on the command processor thread via the base
+ * class. Every draw is *captured* on that thread: shader microcode is
+ * translated to SPIR-V and WGSL (pure host code), constant banks are packed
+ * per the shader's register maps, texture bytes are read from guest memory
+ * and converted to the canonical host format, and index/vertex fetch ranges
+ * are copied out. The main thread then encodes real WebGPU render passes when
+ * it drains the deferred queue - bind groups over the fixed shader ABI
+ * (shared memory storage buffer, five uniform buffers, texture sets), guest
+ * pipelines from the WGSL modules, indexed draws into cached render targets.
+ *
+ * v1 limitations (documented, intentional):
+ *  - Untiled (linear) textures in the 8_8_8_8 / 2_10_10_10 / 5_6_5 / 1_5_5_5
+ *    guest formats are uploaded; tiled or compressed formats bind the null
+ *    texture until the texture loader is ported from the Vulkan cache.
+ *  - One color render target (EDRAM tile 0's registers); no depth attachment
+ *    (WebGPU depth comes with the render target cache expansion).
+ *  - Resolve (IssueCopy) records the current target; copying to the guest
+ *    resolve destination reuses the Vulkan resolve design and is a next step.
+ *  - The system constant struct is zero-filled except for the index
+ *    parameters and a direct NDC pass-through with Y flip; the full register
+ *    conversion port is VulkanCommandProcessor::UpdateSystemConstantValues.
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include "command_processor.h"
+
+#include <cstring>
+
