+  kBiLocalInvocationId = 27,
+  kBiGlobalInvocationId = 28,
+  kBiLocalInvocationIndex = 29,
+  kBiVertexIndex = 42,
+  kBiInstanceIndex = 43,
+};
+
+enum class TKind { kVoid, kBool, kInt, kFloat, kVector, kMatrix, kArray, kRuntimeArray, kStruct, kPointer, kImage, kSampler, kSampledImage, kFunction };
+
+struct Type {
+  TKind kind = TKind::kVoid;
+  bool is_signed = false;
+  uint32_t width = 32;
+  uint32_t components = 1;
+  uint32_t elem = 0;
+  uint32_t len_id = 0;
+  uint32_t storage = 0;
+  std::vector<uint32_t> members;
+  uint32_t dim = 2;
+  bool arrayed = false;
+  bool sampled = true;
+  uint32_t format = 0;
+};
+
+struct Variable {
+  uint32_t type_id = 0;
+  uint32_t sc = 7;
+  std::string name;
+  int built_in = -1;
+  int location = -1;
+  int desc_set = -1;
+  int binding = -1;
+  bool block = false;
+};
+
+struct Inst {
+  uint32_t opcode = 0;
+  std::vector<uint32_t> ops;
+};
+
+struct Phi {
+  uint32_t type_id = 0;
+  std::vector<std::pair<uint32_t, uint32_t>> edges;  // (pred block, value id)
+};
+
+struct Block {
+  uint32_t id = 0;
+  std::vector<Inst> body;       // non-terminator, non-phi
+  std::vector<uint32_t> inst_refs;  // body instruction indexes into fn.insts
+  // terminator:
+  uint32_t term_op = kOpUnreachable;
+  uint32_t merge_id = 0;
+  uint32_t continue_id = 0;
+  uint32_t true_id = 0, false_id = 0, target_id = 0;
+  uint32_t cond_id = 0;
+  uint32_t ret_value_id = 0;
+  // switch
+  uint32_t selector_id = 0, default_id = 0;
+  std::vector<std::pair<uint32_t, uint32_t>> cases;
+  std::vector<uint32_t> phi_results;
+  std::vector<uint32_t> preds;
+  bool is_continue_target = false;
+};
+
+struct Function {
+  uint32_t id = 0;
+  uint32_t ret_type = 0;
+  std::vector<uint32_t> param_types;
+  std::vector<uint32_t> param_ids;
+  std::vector<Inst> insts;  // flat body
+  std::unordered_map<uint32_t, Block> blocks;
+  std::vector<uint32_t> block_order;
+  std::unordered_map<uint32_t, Phi> phis;
+  std::unordered_set<uint32_t> locals;  // variable ids declared in the body
+  std::string emitted_code;             // WGSL text (signature + body)
+  bool owns_local(uint32_t var_id) const { return locals.count(var_id) != 0; }
+};
+
+
+
+struct ImageRef {
+  uint32_t texture_id = 0;  // id of texture var (or sampled image pair)
+  uint32_t sampler_id = 0;  // for sampled images
+};
+
+const char* BuiltinName(int built_in) {
+  switch (built_in) {
+    case kBiPosition: return "position";
+    case kBiVertexId: case kBiVertexIndex: return "vertex_index";
+    case kBiInstanceId: case kBiInstanceIndex: return "instance_index";
+    case kBiFragCoord: return "position";
+    case kBiFrontFacing: return "front_facing";
+    case kBiFragDepth: return "frag_depth";
+    case kBiNumWorkgroups: return "num_workgroups";
+    case kBiWorkgroupId: return "workgroup_id";
+    case kBiLocalInvocationId: return "local_invocation_id";
+    case kBiGlobalInvocationId: return "global_invocation_id";
+    case kBiLocalInvocationIndex: return "local_invocation_index";
+    default: return "position";
+  }
+}
+
+bool OpHasTypedResult(uint32_t op) {
+  switch (op) {
+    case 61: case 65: case 66: case 79: case 80: case 81: case 83:
+    case 87: case 88: case 95:
+    case 109: case 110: case 111: case 112: case 113: case 114: case 115:
+    case 124: case 126: case 127: case 128: case 129: case 130: case 131:
+    case 132: case 133: case 134: case 135: case 136: case 137: case 138:
+    case 139: case 140: case 141: case 142: case 145: case 146: case 148:
+    case 164: case 165: case 166: case 167: case 168: case 169: case 170:
+    case 171: case 172: case 173: case 174: case 175: case 176: case 177:
+    case 178: case 179: case 180: case 181: case 182: case 183: case 184:
+    case 186: case 188: case 190:
+    case 194: case 195: case 196: case 197: case 198: case 199: case 200:
+    case 201: case 202: case 203: case 204: case 205:
+    case 207: case 208: case 210: case 211: case 213: case 214:
+    case 12 /* OpExtInst */:
+      return true;
+    default:
+      return false;
+  }
+}
+
+class Translator {
+ public:
+  bool Run(const uint32_t* words, size_t count, int shader_stage,
+           WgslTranslationResult& result);
+
+ private:
+  bool fail(const std::string& msg) {
+    if (!result_->success) result_->error = msg;
+    return false;
+  }
+
+  static std::string Sanitize(const std::string& n) {
+    static const char* reserved[] = {
+        "var", "let", "fn", "return", "if", "else", "loop", "break", "continue",
+        "struct", "discard", "true", "false", "const", "override", "alias",
+        "bitcast", "select"};
+    for (const char* r : reserved) {
+      if (n == r) return n + "_";
+    }
+    return n;
+  }
+
+  std::string NameOf(uint32_t id) {
+    auto nit = names_.find(id);
+    if (nit != names_.end()) return Sanitize(nit->second);
+    char buf[40];
+    std::snprintf(buf, sizeof(buf), "v%u", id);
+    return buf;
+  }
+
+  // parsing
+  bool ParseFlat(const uint32_t* words, size_t count);
+  void BuildFunctions();
+  void BuildCFG(Function& fn);
+
+  // emission
+  bool EmitModule(int shader_stage);
+  bool EmitFunction(Function& fn, int shader_stage);
+  bool Structurize(Function& fn, uint32_t block_id,
+                   const std::unordered_set<uint32_t>& stops, int depth,
+                   std::ostringstream& out, uint32_t loop_continue_id = 0,
+                   uint32_t loop_merge_id = 0, uint32_t loop_header_id = 0);
+  void EmitPhisFor(Function& fn, uint32_t from_block, uint32_t target_block,
+                   std::unordered_map<uint32_t, std::string>& exprs,
+                   std::ostringstream& out);
+  void EmitEdgePhis(Function& fn, uint32_t from_block,
+                    std::unordered_map<uint32_t, std::string>& exprs,
+                    std::ostringstream& out);
+  std::string EmitExpr(Function& fn, const Inst& inst,
+                       std::unordered_map<uint32_t, std::string>& exprs,
+                       std::ostringstream& out, bool& ok);
+  std::string EmitExtInst(Function& fn, const Inst& inst,
+                          std::unordered_map<uint32_t, std::string>& exprs,
+                          bool& ok);
+
+  const Type* GetType(uint32_t id) const {
+    auto it = types_.find(id);
+    return it == types_.end() ? nullptr : &it->second;
+  }
+  std::string TypeStr(uint32_t id);
+
+  uint32_t entry_id_ = 0;
+  int entry_model_ = 0;
+  uint32_t glsl_ext_id_ = 0;
+
+  std::unordered_map<uint32_t, Type> types_;
+  std::unordered_map<uint32_t, Variable> variables_;
+  std::unordered_map<uint32_t, std::string> constants_;
+  std::unordered_map<uint32_t, std::string> names_;
+  std::unordered_map<uint32_t, std::string> struct_names_;
+  std::unordered_map<uint32_t, Function> functions_;
+  // decorations seen before the variable/type they apply to
+  struct Decor {
+    int built_in = -1;
+    int location = -1;
+    int desc_set = -1;
+    int binding = -1;
+    bool block = false;
+  };
+  std::unordered_map<uint32_t, Decor> decor_;
+  std::unordered_map<uint32_t, std::string> member_names_;  // (type<<16|member)
+  std::unordered_map<uint32_t, ImageRef> sampled_images_;
+
+  // emission state
+  Function* fn_ = nullptr;
+  std::unordered_map<uint32_t, Block>* blocks_ = nullptr;
+  std::unordered_map<uint32_t, Phi>* phis_ = nullptr;
+  std::unordered_set<uint32_t> emitted_blocks_;
+  // phi var names by result id
+  std::unordered_map<uint32_t, std::string> phi_vars_;
+  // input var id -> param name inside entry function
+  std::unordered_map<uint32_t, std::string> in_params_;
+  // output var ids in order
+  std::vector<uint32_t> out_vars_;
+  // expression returned at OpReturn sites of the entry function ("" = void)
+  std::string entry_return_expr_;
+
+  WgslTranslationResult* result_ = nullptr;
+};
+
+std::string Translator::TypeStr(uint32_t id) {
+  const Type* t = GetType(id);
+  if (!t) return "T_unknown";
+  switch (t->kind) {
+    case TKind::kVoid: return "void";
+    case TKind::kBool: return "bool";
+    case TKind::kFloat: return t->width == 64 ? "f64" : "f32";
+    case TKind::kInt:
+      return std::string(t->is_signed ? "i" : "u") + (t->width == 64 ? "64" : "32");
+    case TKind::kVector: {
+      std::string c = TypeStr(t->elem);
+      return "vec" + std::to_string(t->components) + "<" + c + ">";
+    }
+    case TKind::kMatrix: {
+      std::string c = TypeStr(t->elem);
+      // c = vecN<f32>; columns = t->components
+      size_t lt = c.find('<');
+      uint32_t rows = 4;
+      if (c.size() > 3 && c.compare(0, 3, "vec") == 0 && lt != std::string::npos) {
+        rows = static_cast<uint32_t>(std::strtoul(c.c_str() + 3, nullptr, 10));
+      }
+      size_t gt = c.rfind('>');
+      std::string scalar = (lt != std::string::npos && gt != std::string::npos)
+                               ? c.substr(lt + 1, gt - lt - 1)
+                               : "f32";
+      return "mat" + std::to_string(t->components) + "x" + std::to_string(rows) +
+             "<" + scalar + ">";
+    }
+    case TKind::kArray: {
+      std::string e = TypeStr(t->elem);
+      if (t->len_id == 0) return "array<" + e + ">";
+      auto cit = constants_.find(t->len_id);
+      std::string len = cit != constants_.end() ? cit->second : "1u";
+      return "array<" + e + ", " + len + ">";
+    }
+    case TKind::kRuntimeArray: return "array<" + TypeStr(t->elem) + ">";
+    case TKind::kStruct: {
+      auto it = struct_names_.find(id);
+      return it != struct_names_.end() ? it->second : "S" + std::to_string(id);
+    }
+    case TKind::kPointer: {
+      const char* space = "function";
+      switch (t->storage) {
+        case kSCPrivate: space = "private"; break;
+        case kSCWorkgroup: space = "workgroup"; break;
+        case kSCUniform: space = "uniform"; break;
+        case kSCStorageBuffer: space = "storage"; break;
+        case kSCPushConstant: space = "push_constant"; break;
+        default: break;
+      }
+      if (t->storage == kSCInput || t->storage == kSCOutput ||
+          t->storage == kSCUniformConstant || t->storage == kSCFunction) {
+        return TypeStr(t->elem);  // access by value for these classes
+      }
+      return "ptr<" + std::string(space) + ", " + TypeStr(t->elem) + ">";
+    }
+    case TKind::kSampler: return "sampler";
+    case TKind::kSampledImage: return TypeStr(t->elem);  // texture type
+    case TKind::kImage: {
+      if (!t->sampled) {
+        static const char* fmts[] = {"rgba8unorm", "rgba8snorm", "rgba8uint",
+                                     "rgba8sint", "rgba16uint", "rgba16sint",
+                                     "rgba16float", "r32uint", "r32sint",
+                                     "r32float", "rgba32uint", "rgba32sint",
+                                     "rgba32float"};
+        // SPIR-V ImageFormat: 1..37 (subset); default r32uint.
+        const char* f = "r32uint";
+        if (t->format >= 1 && t->format <= 13) f = fmts[t->format - 1];
+        static const char* dims[] = {"1d", "2d", "3d", "cube", "2d"};
+        std::string d = dims[t->dim < 5 ? t->dim : 4];
+        return "texture_storage_" + d + "<" + f + ", write>";
+      }
+      const Type* comp = GetType(t->elem);
+      std::string c = "f32";
+      if (comp && comp->kind == TKind::kInt && !comp->is_signed) c = "u32";
+      if (comp && comp->kind == TKind::kInt && comp->is_signed) c = "i32";
+      static const char* dims[] = {"1d", "2d", "3d", "cube", "2d"};
+      std::string d = dims[t->dim < 5 ? t->dim : 4];
+      return "texture_" + d + (t->arrayed ? "_array" : "") + "<" + c + ">";
+    }
+    default: return "T_unknown";
+  }
+}
+
+bool Translator::ParseFlat(const uint32_t* words, size_t count) {
+  if (count < 5 || words[0] != kSpirvMagic) return fail("not a SPIR-V module");
+  size_t i = 5;
+  Function* cur_fn = nullptr;
+  bool in_function = false;
+  while (i < count) {
+    uint32_t wc = words[i] >> 16;
+    uint32_t op = words[i] & 0xFFFFu;
+    if (wc == 0 || i + wc > count) return fail("truncated SPIR-V");
+    std::vector<uint32_t> o(words + i + 1, words + i + wc);
+    i += wc;
+
+    switch (op) {
+      case kOpName: {
+        if (o.size() >= 2) {
+          const char* s = reinterpret_cast<const char*>(o.data() + 1);
+          names_[o[0]] = s;
+        }
+        break;
+      }
+      case kOpMemberName: {
+        if (o.size() >= 3) {
+          const char* s = reinterpret_cast<const char*>(o.data() + 2);
+          member_names_[(o[0] << 16) | o[1]] = s;
+        }
+        break;
+      }
+      case kOpEntryPoint: {
+        if (o.size() >= 2) {
+          entry_model_ = static_cast<int>(o[0]);
+          entry_id_ = o[1];
+          if (o.size() >= 3) {
+            const char* s = reinterpret_cast<const char*>(o.data() + 2);
+            names_[o[1]] = s;
+          }
+        }
+        break;
+      }
+      case 67 /* OpDecorate */: {
+        if (o.size() >= 2) {
+          Decor& d = decor_[o[0]];
+          switch (o[1]) {
+            case kDecBuiltIn: d.built_in = o.size() > 2 ? static_cast<int>(o[2]) : 0; break;
+            case kDecLocation: d.location = o.size() > 2 ? static_cast<int>(o[2]) : 0; break;
+            case kDecDescriptorSet: d.desc_set = o.size() > 2 ? static_cast<int>(o[2]) : 0; break;
+            case kDecBinding: d.binding = o.size() > 2 ? static_cast<int>(o[2]) : 0; break;
+            case kDecBlock: d.block = true; break;
+            default: break;
+          }
+        }
+        break;
+      }
+      case kOpTypeVoid: { Type t; t.kind = TKind::kVoid; types_[o[0]] = t; break; }
+      case kOpTypeBool: { Type t; t.kind = TKind::kBool; types_[o[0]] = t; break; }
+      case kOpTypeInt: {
+        Type t; t.kind = TKind::kInt; t.width = o[1]; t.is_signed = o[2] != 0;
+        types_[o[0]] = t; break;
+      }
+      case kOpTypeFloat: { Type t; t.kind = TKind::kFloat; t.width = o[1]; types_[o[0]] = t; break; }
+      case kOpTypeVector: {
+        Type t; t.kind = TKind::kVector; t.elem = o[1]; t.components = o[2];
+        types_[o[0]] = t; break;
+      }
+      case kOpTypeMatrix: {
+        Type t; t.kind = TKind::kMatrix; t.elem = o[1]; t.components = o[2];
+        types_[o[0]] = t; break;
+      }
+      case kOpTypeImage: {
+        Type t; t.kind = TKind::kImage; t.elem = o[1]; t.dim = o[2];
+        // operands: result, sampled-type, dim, depth, arrayed, ms, sampled, format
+        t.arrayed = o.size() > 4 && o[4] != 0;
+        t.sampled = o.size() > 6 ? o[6] != 0 : true;
+        if (o.size() > 7) t.format = o[7];
+        types_[o[0]] = t; break;
+      }
+      case kOpTypeSampler: { Type t; t.kind = TKind::kSampler; types_[o[0]] = t; break; }
+      case kOpTypeSampledImage: {
+        Type t; t.kind = TKind::kSampledImage; t.elem = o[1]; types_[o[0]] = t; break;
+      }
+      case kOpTypeArray: {
+        Type t; t.kind = TKind::kArray; t.elem = o[1]; t.len_id = o[2];
+        types_[o[0]] = t; break;
+      }
+      case kOpTypeRuntimeArray: {
+        Type t; t.kind = TKind::kRuntimeArray; t.elem = o[1]; types_[o[0]] = t; break;
+      }
+      case kOpTypeStruct: {
+        Type t; t.kind = TKind::kStruct;
+        t.members.assign(o.begin() + 1, o.end());
+        types_[o[0]] = t;
+        auto nit = names_.find(o[0]);
+        struct_names_[o[0]] = nit != names_.end() ? Sanitize(nit->second)
+                                                  : "S" + std::to_string(o[0]);
+        break;
+      }
+      case kOpTypePointer: {
+        Type t; t.kind = TKind::kPointer; t.storage = o[1]; t.elem = o[2];
+        types_[o[0]] = t; break;
+      }
+      case kOpTypeFunction: {
+        Type t; t.kind = TKind::kFunction; t.elem = o[1];
+        t.members.assign(o.begin() + 2, o.end());
+        types_[o[0]] = t; break;
+      }
+      case kOpConstantTrue: constants_[o[1]] = "true"; break;
+      case kOpConstantFalse: constants_[o[1]] = "false"; break;
+      case kOpConstant: {
+        if (o.size() < 2) break;
+        const Type* t = GetType(o[0]);
+        std::string v;
+        if (t && t->kind == TKind::kFloat) {
+          if (t->width == 64) {
+            uint64_t bits = static_cast<uint64_t>(o[2]) |
+                            (o.size() > 3 ? (static_cast<uint64_t>(o[3]) << 32) : 0);
+            double d;
+            std::memcpy(&d, &bits, 8);
+            char buf[64];
+            std::snprintf(buf, sizeof(buf), "%.9g", d);
+            v = std::string(buf) + (strchr(buf, '.') ? "" : ".0") + "";
+          } else {
+            float f;
+            std::memcpy(&f, &o[2], 4);
+            char buf[64];
+            std::snprintf(buf, sizeof(buf), "%.9g", f);
+            v = std::string(buf) + "f";
+          }
+        } else if (t && t->kind == TKind::kInt) {
+          char buf[48];
+          if (t->is_signed) {
+            std::snprintf(buf, sizeof(buf), "%d", static_cast<int32_t>(o[2]));
+            v = std::string(buf) + (t->width == 64 ? "i" : "i");
+          } else {
+            std::snprintf(buf, sizeof(buf), "%u", o[2]);
+            v = std::string(buf) + "u";
+          }
+        } else if (t && t->kind == TKind::kBool) {
+          v = o[2] ? "true" : "false";
+        } else {
+          v = "0u";
+        }
+        constants_[o[1]] = v;
+        break;
+      }
+      case kOpConstantComposite: {
+        std::string v = TypeStr(o[0]) + "(";
+        for (size_t k = 2; k < o.size(); ++k) {
+          if (k > 2) v += ", ";
+          auto cit = constants_.find(o[k]);
+          v += cit != constants_.end() ? cit->second : NameOf(o[k]);
+        }
+        v += ")";
+        constants_[o[1]] = v;
+        break;
+      }
+      case kOpConstantNull: {
+        const Type* t = GetType(o[0]);
+        std::string v;
+        if (t && t->kind == TKind::kBool) v = "false";
+        else if (t && (t->kind == TKind::kVector || t->kind == TKind::kMatrix ||
+                       t->kind == TKind::kArray))
+          v = TypeStr(o[0]) + "()";
+        else v = TypeStr(o[0]) + "(0)";
+        constants_[o[1]] = v;
+        break;
+      }
+      case kOpExtInstImport: {
+        const char* s = reinterpret_cast<const char*>(o.data() + 1);
+        if (std::strcmp(s, "GLSL.std.450") == 0) glsl_ext_id_ = o[0];
+        break;
+      }
+      case kOpVariable: {
+        if (o.size() < 3) break;
+        Variable v;
+        v.type_id = o[0];
+        v.sc = o[1];
+        auto dit = decor_.find(o[2]);
+        if (dit != decor_.end()) {
+          v.built_in = dit->second.built_in;
+          v.location = dit->second.location;
+          v.desc_set = dit->second.desc_set;
+          v.binding = dit->second.binding;
+          v.block = dit->second.block;
+        }
+        auto nit = names_.find(o[2]);
+        v.name = nit != names_.end() ? Sanitize(nit->second) : "";
+        variables_[o[2]] = v;
+        break;
+      }
+      case kOpFunction: {
+        in_function = true;
+        Function fn;
+        fn.id = o[1];
+        fn.ret_type = o[0];
+        auto it = functions_.emplace(o[1], std::move(fn));
+        cur_fn = &it.first->second;
+        break;
+      }
+      case kOpFunctionParameter: {
+        if (cur_fn) {
+          cur_fn->param_types.push_back(o[0]);
+          cur_fn->param_ids.push_back(o[1]);
+          auto nit = names_.find(o[1]);
+          names_[o[1]] = nit != names_.end() ? nit->second
+                                             : "arg" + std::to_string(o[1]);
+        }
+        break;
+      }
+      case kOpFunctionEnd: {
+        in_function = false;
+        cur_fn = nullptr;
+        break;
+      }
+      default: {
+        if (in_function && cur_fn && op != kOpFunctionCall) {
+          cur_fn->insts.push_back({op, std::move(o)});
+        }
+        break;
+      }
+    }
+  }
+  return true;
+}
+
+void Translator::BuildFunctions() {
+  for (auto& [id, fn] : functions_) {
+    (void)id;
+    BuildCFG(fn);
+  }
+}
+
+void Translator::BuildCFG(Function& fn) {
+  auto& blocks = fn.blocks;
+  auto& order = fn.block_order;
+  Block* cur = nullptr;
+  for (size_t k = 0; k < fn.insts.size(); ++k) {
+    const Inst& inst = fn.insts[k];
+    switch (inst.opcode) {
+      case kOpLabel: {
+        Block b;
+        b.id = inst.ops[0];
+        blocks[b.id] = b;
+        order.push_back(b.id);
+        cur = &blocks[b.id];
+        break;
+      }
+      case kOpLoopMerge: {
+        if (cur) {
+          cur->merge_id = inst.ops[0];
+          cur->continue_id = inst.ops[1];
+          if (blocks.count(cur->continue_id))
+            blocks[cur->continue_id].is_continue_target = true;
+        }
+        break;
+      }
+      case kOpSelectionMerge: {
+        if (cur) cur->merge_id = inst.ops[0];
+        break;
+      }
+      case kOpPhi: {
+        if (cur) {
+          cur->phi_results.push_back(inst.ops[1]);
+          cur->inst_refs.push_back(static_cast<uint32_t>(k));
+        }
+        break;
+      }
+      case kOpBranch: {
+        if (cur) {
+          cur->term_op = kOpBranch;
+          cur->target_id = inst.ops[0];
+        }
+        cur = nullptr;
+        break;
+      }
+      case kOpBranchConditional: {
+        if (cur) {
+          cur->term_op = kOpBranchConditional;
+          cur->cond_id = inst.ops[0];
+          cur->true_id = inst.ops[1];
+          cur->false_id = inst.ops[2];
+        }
+        cur = nullptr;
+        break;
+      }
+      case kOpSwitch: {
+        if (cur) {
+          cur->term_op = kOpSwitch;
+          cur->selector_id = inst.ops[0];
+          cur->default_id = inst.ops[1];
+          for (size_t p = 2; p + 1 < inst.ops.size(); p += 2) {
+            cur->cases.emplace_back(inst.ops[p], inst.ops[p + 1]);
+          }
+        }
+        cur = nullptr;
+        break;
+      }
+      case kOpReturn: {
+        if (cur) cur->term_op = kOpReturn;
+        cur = nullptr;
+        break;
+      }
+      case kOpReturnValue: {
+        if (cur) {
+          cur->term_op = kOpReturnValue;
+          cur->ret_value_id = inst.ops[0];
+        }
+        cur = nullptr;
+        break;
+      }
+      case kOpKill: {
+        if (cur) cur->term_op = kOpKill;
+        cur = nullptr;
+        break;
+      }
+      case kOpUnreachable: {
+        if (cur) cur->term_op = kOpUnreachable;
+        cur = nullptr;
+        break;
+      }
+      default: {
+        if (cur) {
+          cur->inst_refs.push_back(static_cast<uint32_t>(k));
+          if (inst.opcode == kOpVariable) fn.locals.insert(inst.ops[1]);
+        }
+        break;
+      }
+    }
+  }
+  // Phi records + predecessors
+  for (uint32_t bid : order) {
+    Block& b = blocks[bid];
+    for (uint32_t ri : b.inst_refs) {
+      const Inst& inst = fn.insts[ri];
+      if (inst.opcode == kOpPhi) {
+        Phi phi;
+        phi.type_id = inst.ops[0];
+        for (size_t p = 2; p + 1 < inst.ops.size(); p += 2) {
+          phi.edges.emplace_back(inst.ops[p], inst.ops[p + 1]);
+        }
+        fn.phis[inst.ops[1]] = phi;
+      }
+    }
+    switch (b.term_op) {
+      case kOpBranch:
+        if (blocks.count(b.target_id)) blocks[b.target_id].preds.push_back(b.id);
+        break;
+      case kOpBranchConditional:
+        if (blocks.count(b.true_id)) blocks[b.true_id].preds.push_back(b.id);
+        if (blocks.count(b.false_id)) blocks[b.false_id].preds.push_back(b.id);
+        break;
+      default: break;
+    }
+    if (b.merge_id && blocks.count(b.merge_id)) {
+      blocks[b.merge_id].preds.push_back(b.id);  // merge reached structurally
+    }
+    if (b.continue_id && blocks.count(b.continue_id)) {
+      blocks[b.continue_id].is_continue_target = true;
+    }
+  }
+}
+
+bool Translator::Run(const uint32_t* words, size_t count, int shader_stage,
+                     WgslTranslationResult& result) {
+  result_ = &result;
+  if (!ParseFlat(words, count)) return false;
+  if (entry_id_ == 0) return fail("no entry point");
+  auto fit = functions_.find(entry_id_);
+  if (fit == functions_.end()) return fail("entry point function missing");
+  entry_model_ = shader_stage >= 0 ? shader_stage : entry_model_;
+  BuildFunctions();
+  if (!EmitModule(shader_stage)) return false;
+  result.success = true;
+  result.wgsl = result_->wgsl;
+  return true;
+}
+
+// ---------- expression emission ----------
+
+std::string Translator::EmitExtInst(Function& fn, const Inst& inst,
+                                    std::unordered_map<uint32_t, std::string>& exprs,
+                                    bool& ok) {
+  (void)fn;
+  // OpExtInst res_type result set instruction operands...
+  uint32_t glsl_inst = inst.ops[3];
+  auto arg = [&](size_t k) {
+    auto cit = constants_.find(inst.ops[k]);
+    return cit != constants_.end() ? cit->second : exprs[inst.ops[k]];
+  };
+  switch (glsl_inst) {
+    case 2: return "round(" + arg(4) + ")";       // RoundEven
+    case 3: return "trunc(" + arg(4) + ")";       // Trunc
+    case 4: return "abs(" + arg(4) + ")";         // FAbs
+    case 8: return "floor(" + arg(4) + ")";       // Floor
+    case 10: return "fract(" + arg(4) + ")";      // Fract
+    case 13: return "sin(" + arg(4) + ")";        // Sin
+    case 14: return "cos(" + arg(4) + ")";        // Cos
+    case 29: return "exp2(" + arg(4) + ")";       // Exp2
+    case 30: return "log2(" + arg(4) + ")";       // Log2
+    case 31: return "sqrt(" + arg(4) + ")";       // Sqrt
+    case 32: return "rsqrt(" + arg(4) + ")";      // InverseSqrt
+    case 37: case 39: case 79:                    // FMin, SMin, NMin
+      return "min(" + arg(4) + ", " + arg(5) + ")";
+    case 40: case 42: case 80:                    // FMax, SMax, NMax
+      return "max(" + arg(4) + ", " + arg(5) + ")";
+    case 43: case 44: case 45: case 81:           // FClamp, UClamp, SClamp, NClamp
+      return "clamp(" + arg(4) + ", " + arg(5) + ", " + arg(6) + ")";
+    case 46: return "mix(" + arg(4) + ", " + arg(5) + ", " + arg(6) + ")";  // FMix
+    case 48: return "select(0.0f, 1.0f, " + arg(4) + " >= " + arg(5) + ")";  // Step
+    case 49: return "smoothstep(" + arg(4) + ", " + arg(5) + ", " + arg(6) + ")";
+    case 53: return "ldexp(" + arg(4) + ", " + arg(5) + ")";  // Ldexp
+    case 58: return "pack2x16float(" + arg(4) + ")";          // PackHalf2x16
+    case 62: return "unpack2x16float(" + arg(4) + ")";        // UnpackHalf2x16
+    case 74: case 75:                                          // FindSMsb, FindUMsb
+      return "firstLeadingBit(" + arg(4) + ")";
+    default:
+      ok = false;
+      return "";
+  }
+}
+
+std::string Translator::EmitExpr(Function& fn, const Inst& inst,
+                                 std::unordered_map<uint32_t, std::string>& exprs,
+                                 std::ostringstream& out, bool& ok) {
+  const auto& o = inst.ops;
+  auto PtrExpr = [&](uint32_t id) -> std::string {
+    auto eit = exprs.find(id);
+    if (eit != exprs.end()) return eit->second;
+    auto vit = variables_.find(id);
+    if (vit != variables_.end()) return NameOf(id);
+    return NameOf(id);
+  };
+  auto val = [&](size_t k) {
+    auto cit = constants_.find(o[k]);
+    if (cit != constants_.end()) return cit->second;
+    auto eit = exprs.find(o[k]);
+    if (eit != exprs.end()) return eit->second;
+    // Declared SSA var, function param, or module-scope variable.
+    return NameOf(o[k]);
+  };
+  auto need = [&](size_t k) {
+    if (k >= o.size()) {
+      ok = false;
+      return std::string("/* missing operand */");
+    }
+    return val(k);
+  };
+  std::string r = NameOf(o[1]);
+  std::string t = TypeStr(o[0]);
+  auto bin = [&](const char* sop) {
+    return "(" + need(2) + " " + sop + " " + need(3) + ")";
+  };
+  auto un = [&](const char* sop) { return sop + std::string("(") + need(2) + ")"; };
+  switch (inst.opcode) {
+    case kOpLoad: {
+      // Load from pointer/variable expression.
+      auto vit = exprs.find(o[2]);
+      if (vit != exprs.end()) return vit->second;
+      return NameOf(o[2]);
+    }
+    case kOpStore: {
+      // OpStore: operand 0 = pointer, operand 1 = object (no result id)
+      out << "  " << PtrExpr(o[0]) << " = " << need(1) << ";\n";
+      return "";
+    }
+    case kOpAccessChain:
+    case kOpInBoundsAccessChain: {
+      // base ptr + indices -> member/index path expression
+      std::string base = need(2);
+      const Type* base_t = nullptr;
+      {
+        auto vit = variables_.find(o[2]);
+        if (vit != variables_.end()) base_t = GetType(vit->second.type_id);
+        if (!base_t) {
+          // loaded pointer value
+          for (size_t k = 0; k < fn.insts.size() && !base_t; ++k) {
+            if (fn.insts[k].ops.size() > 1 && fn.insts[k].ops[1] == o[2] &&
+                (fn.insts[k].opcode == kOpAccessChain ||
+                 fn.insts[k].opcode == kOpInBoundsAccessChain)) {
+              // nested chains handled recursively via exprs only
+            }
+          }
+        }
+      }
+      std::string e = base;
+      const Type* walk = base_t ? GetType(base_t->elem) : nullptr;
+      for (size_t k = 3; k < o.size(); ++k) {
+        auto cit = constants_.find(o[k]);
+        uint32_t idx_type = 0;
+        // index type unknown; treat as constant when possible
+        if (cit != constants_.end()) {
+          // struct member access uses constant indices
+          if (walk && walk->kind == TKind::kStruct) {
+            uint32_t member = static_cast<uint32_t>(std::strtoul(cit->second.c_str(), nullptr, 10));
+            e += ".m" + std::to_string(member);
+            walk = walk->members.size() > member ? GetType(walk->members[member]) : nullptr;
+          } else {
+            e += "[" + cit->second + "]";
+            walk = walk ? (walk->kind == TKind::kArray || walk->kind == TKind::kRuntimeArray
+                               ? GetType(walk->elem)
+                               : nullptr)
+                        : nullptr;
+          }
+        } else {
+          e += "[" + exprs.at(o[k]) + "]";
+          walk = walk && (walk->kind == TKind::kArray || walk->kind == TKind::kRuntimeArray)
+                     ? GetType(walk->elem)
+                     : nullptr;
+        }
+        (void)idx_type;
+      }
+      return e;
+    }
+    case kOpVectorShuffle: {
+      // res = vec(base1, base2, indices...)
+      std::string base1 = need(2), base2 = need(3);
+      uint32_t n = t == "T_unknown" ? static_cast<uint32_t>(o.size() - 4) : 0;
+      std::string comps;
+      for (size_t k = 4; k < o.size(); ++k) {
+        uint32_t sel = o[k];
+        std::string c = sel < 4 ? base1 + "[" + std::to_string(sel) + "]"
+                                : base2 + "[" + std::to_string(sel - 4) + "]";
+        if (k > 4) comps += ", ";
+        comps += c;
+      }
+      if (n == 0) n = static_cast<uint32_t>(o.size() - 4);
+      return "vec" + std::to_string(n) + "<" +
+             (t.find("vec") == 0 ? t.substr(t.find('<') + 1, t.rfind('>') - t.find('<') - 1)
+                                 : "f32") +
+             ">(" + comps + ")";
+    }
+    case kOpCompositeConstruct: {
+      std::string v = t + "(";
+      for (size_t k = 2; k < o.size(); ++k) {
+        if (k > 2) v += ", ";
+        v += need(k);
+      }
+      v += ")";
+      return v;
+    }
+    case kOpCompositeExtract: {
+      std::string e = need(2);
+      // constant literal indices: word index 3.. is (literal) per spec (no ids)
+      for (size_t k = 3; k < o.size(); ++k) {
+        e += "[" + std::to_string(o[k]) + "]";
+      }
+      return e;
+    }
+    case kOpCompositeInsert: {
+      ok = false;  // rare in translator output; explicit failure over silent bug
+      return "";
+    }
+    case kOpCopyObject: return need(2);
+    case kOpImageTexelPointer: {
+      // result = (texture, coord) pair -- keep texel pointer in exprs map
+      return NameOf(o[2]) + "@@" + need(3);
+    }
+    case kOpImageFetch: {
+      std::string ptr = PtrExpr(o[2]);
+      size_t at = ptr.find("@@");
+      std::string tex = at != std::string::npos ? ptr.substr(0, at) : ptr;
+      std::string coord = at != std::string::npos ? ptr.substr(at + 2) : need(3);
+      return "textureLoad(" + tex + ", " + coord + ", 0)";
+    }
+    case kOpImageWrite: {
+      std::string ptr = PtrExpr(o[0]);
+      size_t at = ptr.find("@@");
+      std::string tex = at != std::string::npos ? ptr.substr(0, at) : ptr;
+      std::string coord = at != std::string::npos ? ptr.substr(at + 2) : need(1);
+      out << "  textureStore(" << tex << ", " << coord << ", " << need(2) << ");\n";
+      return "";
+    }
+    case 86 /* OpSampledImage */: {
+      sampled_images_[o[1]] = {o[2], o[3]};
+      return "";
+    }
+    case kOpImageSampleImplicitLod:
+    case kOpImageSampleExplicitLod: {
+      auto sit = sampled_images_.find(o[2]);
+      std::string tex, samp;
+      if (sit != sampled_images_.end()) {
+        tex = NameOf(sit->second.texture_id);
+        samp = NameOf(sit->second.sampler_id);
+      } else {
+        tex = need(2);
+        samp = "s0";
+      }
+      std::string uv = need(3);
+      if (inst.opcode == kOpImageSampleImplicitLod) {
+        return "textureSample(" + tex + ", " + samp + ", " + uv + ")";
+      }
+      // explicit lod: operand words after uv: [image-operand-mask, lod...]
+      std::string lod = "0.0f";
+      if (o.size() > 4) {
+        uint32_t mask = o[4];
+        const uint32_t kImageOperandsLodMask = 0x2;
+        if (mask & kImageOperandsLodMask && o.size() > 5) {
+          auto cit = constants_.find(o[5]);
+          lod = cit != constants_.end() ? cit->second : exprs.at(o[5]);
+        }
+      }
+      return "textureSampleLevel(" + tex + ", " + samp + ", " + uv + ", " + lod + ")";
+    }
+    case kOpSelect: {
+      // WGSL select(false_val, true_val, cond)
+      return "select(" + need(3) + ", " + need(2) + ", " + need(4) + ")";
+    }
+    case kOpExtInst: return EmitExtInst(fn, inst, exprs, ok);
+    default: break;
+  }
+
+  // Typed value ops with a result id: ops[0]=type, ops[1]=result.
+  switch (inst.opcode) {
+    case kOpSNegate: return "(-" + need(2) + ")";
+    case kOpFNegate: return "-(" + need(2) + ")";
+    case kOpIAdd: return bin("+");
+    case kOpFAdd: return bin("+");
+    case kOpISub: return bin("-");
+    case kOpFSub: return bin("-");
+    case kOpIMul: return bin("*");
+    case kOpFMul: return bin("*");
+    case kOpUDiv: return bin("/");
+    case kOpSDiv: return bin("/");
+    case kOpFDiv: return bin("/");
+    case kOpUMod: return bin("%");
+    case kOpSRem: return bin("%");
+    case kOpSMod: return bin("%");
+    case kOpFRem: return bin("%");
+    case kOpFMod: return bin("%");
+    case kOpVectorTimesScalar: return "(" + need(2) + " * " + need(3) + ")";
+    case kOpMatrixTimesVector: return "(" + need(2) + " * " + need(3) + ")";
+    case kOpMatrixTimesMatrix: return "(" + need(2) + " * " + need(3) + ")";
+    case kOpDot: return "dot(" + need(2) + ", " + need(3) + ")";
+    case kOpLogicalEqual: case kOpIEqual: case kOpFOrdEqual: case kOpFUnordEqual:
+      return bin("==");
+    case kOpLogicalNotEqual: case kOpINotEqual: case kOpFOrdNotEqual:
+    case kOpFUnordNotEqual:
+      return bin("!=");
+    case kOpULessThan: case kOpSLessThan: case kOpFOrdLessThan: return bin("<");
+    case kOpULessThanEqual: case kOpSLessThanEqual: case kOpFOrdLessThanEqual:
+      return bin("<=");
+    case kOpUGreaterThan: case kOpSGreaterThan: case kOpFOrdGreaterThan:
+      return bin(">");
+    case kOpUGreaterThanEqual: case kOpSGreaterThanEqual: case kOpFOrdGreaterThanEqual:
+      return bin(">=");
+    case kOpLogicalAnd: return bin("&&");
+    case kOpLogicalOr: return bin("||");
+    case kOpLogicalNot: return "!(" + need(2) + ")";
+    case kOpShiftRightLogical: return bin(">>");
+    case kOpShiftRightArithmetic: return bin(">>");
+    case kOpShiftLeftLogical: return bin("<<");
+    case kOpBitwiseOr: return bin("|");
+    case kOpBitwiseXor: return bin("^");
+    case kOpBitwiseAnd: return bin("&");
+    case kOpNot: return "~(" + need(2) + ")";
+    case kOpBitFieldInsert:
+      return "insertBits(" + need(2) + ", " + need(3) + ", " + need(4) + ", " +
+             need(5) + ")";
+    case kOpBitFieldSExtract: case kOpBitFieldUExtract:
+      return "extractBits(" + need(2) + ", " + need(3) + ", " + need(4) + ")";
+    case kOpBitReverse: return "reverseBits(" + need(2) + ")";
+    case kOpBitCount: return "countOneBits(" + need(2) + ")";
+    case kOpDPdx: case kOpDPdxFine: case kOpDPdxCoarse: return "dpdx(" + need(2) + ")";
+    case kOpDPdy: case kOpDPdyFine: case kOpDPdyCoarse: return "dpdy(" + need(2) + ")";
+    case kOpConvertFToU: case kOpConvertFToS: case kOpUConvert: case kOpSConvert:
+    case kOpConvertSToF: case kOpConvertUToF: case kOpFConvert:
+      return t + "(" + need(2) + ")";
+    case kOpBitcast: return "bitcast<" + t + ">(" + need(2) + ")";
+    default:
+      ok = false;
+      return "";
+  }
+}
+
+// ---------- module + function emission ----------
+
+bool Translator::EmitModule(int shader_stage) {
+  std::ostringstream out;
+  out << "// Generated by rex::graphics::webgpu::TranslateSpirvToWgsl\n";
+
+  // Resource bindings: uniform/storage buffers, images, samplers, push
+  // constants, workgroup/private module-scope vars.
+  std::vector<std::pair<uint32_t, const Variable*>> buffers;
+  for (const auto& [id, v] : variables_) {
+    if (v.sc == kSCUniform || v.sc == kSCStorageBuffer) {
+      buffers.emplace_back(id, &v);
+    }
+  }
+  // Struct definitions for Block-decorated buffers (topological-free v1: no
+  // nested struct dedup -- emit each referenced struct once).
+  std::unordered_set<uint32_t> emitted_structs;
+  std::vector<std::pair<uint32_t, const Variable*>> images_samplers;
+  for (const auto& [id, v] : variables_) {
+    if (v.sc == kSCUniformConstant) images_samplers.emplace_back(id, &v);
+  }
+  (void)buffers;
+
+  auto emit_struct = [&](uint32_t struct_id, std::ostringstream& s) {
+    if (emitted_structs.count(struct_id)) return;
+    emitted_structs.insert(struct_id);
+    const Type* t = GetType(struct_id);
+    if (!t || t->kind != TKind::kStruct) return;
+    s << "struct " << struct_names_[struct_id] << " {\n";
+    for (uint32_t m = 0; m < t->members.size(); ++m) {
+      const Type* mt = GetType(t->members[m]);
+      std::string mname;
+      auto mnit = member_names_.find((struct_id << 16) | m);
+      mname = mnit != member_names_.end() ? Sanitize(mnit->second)
+                                          : "m" + std::to_string(m);
+      s << "  " << mname << " : " << TypeStr(t->members[m]) << ",\n";
+    }
+    s << "};\n";
+  };
+
+  // Uniform/storage buffers: struct + var<uniform|storage>
+  for (const auto& [id, vp] : buffers) {
+    const Type* pt = GetType(vp->type_id);
+    if (!pt || pt->kind != TKind::kPointer) continue;
+    emit_struct(pt->elem, out);
+    const Variable* v = vp;
+    if (v->desc_set < 0) continue;
+    out << "@group(" << v->desc_set << ") @binding(" << v->binding << ") var<"
+        << (v->sc == kSCUniform ? "uniform" : "storage") << "> " << NameOf(id)
+        << " : " << struct_names_[pt->elem] << ";\n";
+  }
+  // Push constants
+  for (const auto& [id, v] : variables_) {
+    if (v.sc != kSCPushConstant) continue;
+    const Type* pt = GetType(v.type_id);
+    if (pt && pt->kind == TKind::kPointer) {
+      emit_struct(pt->elem, out);
+      out << "var<push_constant> " << NameOf(id) << " : " << struct_names_[pt->elem]
+          << ";\n";
+    }
+  }
+  // Images + samplers
+  for (const auto& [id, v] : images_samplers) {
+    if (v->desc_set < 0) continue;
+    out << "@group(" << v->desc_set << ") @binding(" << v->binding << ") var "
+        << NameOf(id) << " : " << TypeStr(v->type_id) << ";\n";
+  }
+  // Workgroup / private module-scope vars
+  for (const auto& [id, v] : variables_) {
+    if (v.sc == kSCWorkgroup) {
+      out << "var<workgroup> " << NameOf(id) << " : " << TypeStr(v.type_id)
+          << ";\n";
+    } else if (v.sc == kSCPrivate && v.built_in < 0) {
+      out << "var<private> " << NameOf(id) << " : " << TypeStr(v.type_id)
+          << ";\n";
+    }
+  }
+
+  // Entry point
+  Function& fn = functions_[entry_id_];
+  if (!EmitFunction(fn, shader_stage)) return false;
+  out << fn.emitted_code;
+  result_->wgsl = out.str();
+  return true;
+}
+
+bool Translator::EmitFunction(Function& fn, int shader_stage) {
+  fn_ = &fn;
+  blocks_ = &fn.blocks;
+  emitted_blocks_.clear();
+  phi_vars_.clear();
+  in_params_.clear();
+  out_vars_.clear();
+
+  const char* stage_attr = shader_stage == 0   ? "@vertex"
+                           : shader_stage == 1 ? "@fragment"
+                                               : "@compute @workgroup_size(64)";
+
+  // Entry-point inputs become parameters; outputs become a returned struct.
+  struct IOVar {
+    uint32_t id;
+    const Variable* v;
+    std::string name;
+  };
+  std::vector<IOVar> inputs, outputs;
+  for (const auto& [id, v] : variables_) {
+    if (v.sc == kSCInput) {
+      std::string n = v.name.empty() ? "in_" + std::to_string(id) : v.name;
+      inputs.push_back({id, &v, n});
+    } else if (v.sc == kSCOutput) {
+      std::string n = v.name.empty() ? "out_" + std::to_string(id) : v.name;
+      outputs.push_back({id, &v, n});
+      out_vars_.push_back(id);
+    }
+  }
+  std::sort(inputs.begin(), inputs.end(), [](const IOVar& a, const IOVar& b) {
+    auto key = [](const IOVar& x) {
+      return std::make_pair(x.v->built_in, x.v->location);
+    };
+    return key(a) < key(b);
+  });
+
+  std::ostringstream sig;
+  sig << stage_attr << "\nfn main(";
+  bool first_param = true;
+  for (const auto& io : inputs) {
+    if (!first_param) sig << ", ";
+    first_param = false;
+    if (io.v->built_in >= 0) {
+      sig << "@builtin(" << BuiltinName(io.v->built_in) << ")";
+    } else if (io.v->location >= 0) {
+      sig << "@location(" << io.v->location << ")";
+    }
+    sig << " " << io.name << " : " << TypeStr(io.v->type_id);
+    in_params_[io.id] = io.name;
+  }
+  sig << ")";
+
+  std::ostringstream out_struct_def;
+  std::string out_struct_name;
+  if (!outputs.empty()) {
+    out_struct_name = shader_stage == 0 ? "VertexOut" : "FragmentOut";
+    out_struct_def << "struct " << out_struct_name << " {\n";
+    for (const auto& io : outputs) {
+      if (io.v->built_in >= 0) {
+        out_struct_def << "  @builtin(" << BuiltinName(io.v->built_in) << ") ";
+      } else if (io.v->location >= 0) {
+        out_struct_def << "  @location(" << io.v->location << ") ";
+      }
+      out_struct_def << io.name << " : " << TypeStr(io.v->type_id) << ",\n";
+    }
+    out_struct_def << "}\n";
+  }
+
+  std::ostringstream body;
+  // Output variables become local vars (their values feed the return struct).
+  std::ostringstream out_expr;
+  for (const auto& io : outputs) {
+    body << "  var " << io.name << " : " << TypeStr(io.v->type_id) << ";\n";
+    if (out_expr.tellp() > 0) out_expr << ", ";
+    out_expr << io.name;
+  }
+  if (!outputs.empty()) {
+    entry_return_expr_ = out_struct_name + "(" + out_expr.str() + ")";
+  }
+  // Function-local variables (Function/Private storage class).
+  for (const auto& [id, v] : variables_) {
+    if ((v.sc == kSCFunction || v.sc == kSCPrivate) && fn.owns_local(id) &&
+        v.built_in < 0) {
+      body << "  var " << NameOf(id) << " : " << TypeStr(v.type_id) << ";\n";
+    }
+  }
+  // SSA value vars at function scope: every typed result gets one, so
+  // cross-block uses resolve without a liveness pass.
+  std::unordered_set<uint32_t> declared_values;
+  for (const Inst& inst : fn.insts) {
+    if (OpHasTypedResult(inst.opcode) && inst.ops.size() >= 2) {
+      declared_values.insert(inst.ops[1]);
+      body << "  var " << NameOf(inst.ops[1]) << " : "
+           << TypeStr(inst.ops[0]) << ";\n";
+    }
+  }
+  // Phi result vars at function scope.
+  for (const auto& [pid, phi] : fn.phis) {
+    phi_vars_[pid] = "phi_" + std::to_string(pid);
+    body << "  var " << phi_vars_[pid] << " : " << TypeStr(phi.type_id) << ";\n";
+  }
+  (void)declared_values;
+
+  if (fn.block_order.empty()) return fail("entry function has no blocks");
+  if (!Structurize(fn, fn.block_order[0], {}, 0, body)) {
+    return false;
+  }
+
+  std::ostringstream code;
+  code << out_struct_def.str() << sig.str();
+  if (!outputs.empty()) code << " -> " << out_struct_name;
+  code << " {\n" << body.str() << "}\n";
+  fn.emitted_code = code.str();
+  return true;
+}
+
+void Translator::EmitEdgePhis(Function& fn, uint32_t from_block,
+                              std::unordered_map<uint32_t, std::string>& exprs,
+                              std::ostringstream& out) {
+  // For each phi in blocks branching out of from_block: assign the incoming
+  // value for this predecessor. Called just before emitting the terminator.
+  const Block& b = fn.blocks[from_block];
+  std::vector<uint32_t> targets;
+  switch (b.term_op) {
+    case kOpBranch: targets.push_back(b.target_id); break;
+    case kOpBranchConditional:
+      targets.push_back(b.true_id);
+      targets.push_back(b.false_id);
+      break;
+    case kOpSwitch:
+      targets.push_back(b.default_id);
+      for (auto& [lit, t] : b.cases) targets.push_back(t);
+      break;
+    default: return;
+  }
+  for (uint32_t t : targets) {
+    auto bit = fn.blocks.find(t);
+    if (bit == fn.blocks.end()) continue;
+    for (uint32_t pr : bit->second.phi_results) {
+      auto pit = fn.phis.find(pr);
+      if (pit == fn.phis.end()) continue;
+      for (auto& [pred, val_id] : pit->second.edges) {
+        if (pred == from_block) {
+          auto cit = constants_.find(val_id);
+          std::string v = cit != constants_.end() ? cit->second : exprs[val_id];
+          out << "  " << phi_vars_[pr] << " = " << v << ";\n";
+        }
+      }
+    }
+  }
+}
+
+void Translator::EmitPhisFor(Function& fn, uint32_t from_block,
+                             uint32_t target_block,
+                             std::unordered_map<uint32_t, std::string>& exprs,
+                             std::ostringstream& out) {
+  auto bit = fn.blocks.find(target_block);
+  if (bit == fn.blocks.end()) return;
+  for (uint32_t pr : bit->second.phi_results) {
+    auto pit = fn.phis.find(pr);
+    if (pit == fn.phis.end()) continue;
+    for (auto& [pred, val_id] : pit->second.edges) {
+      if (pred == from_block) {
+        auto cit = constants_.find(val_id);
+        std::string v = cit != constants_.end() ? cit->second : exprs[val_id];
+        out << "  " << phi_vars_[pr] << " = " << v << ";\n";
+      }
+    }
+  }
+}
+
+bool Translator::Structurize(Function& fn, uint32_t block_id,
+                             const std::unordered_set<uint32_t>& stops, int depth,
+                             std::ostringstream& out, uint32_t loop_continue_id,
+                             uint32_t loop_merge_id, uint32_t loop_header_id) {
+  if (depth > 64) return fail("CFG structurization depth exceeded");
+  if (!blocks_->count(block_id)) return fail("branch to missing block");
+  if (emitted_blocks_.count(block_id) || stops.count(block_id)) return true;
+  emitted_blocks_.insert(block_id);
+  Block& b = (*blocks_)[block_id];
+
+  // Statements: expression emission per instruction.
+  std::unordered_map<uint32_t, std::string> exprs;
+  // Seed with entry-point input params, output locals and phi variables.
+  for (const auto& [id, pname] : in_params_) exprs[id] = pname;
+  for (const auto& [pid, pvar] : phi_vars_) exprs[pid] = pvar;
+  for (uint32_t ov : out_vars_) {
+    auto vit = variables_.find(ov);
+    if (vit != variables_.end()) {
+      exprs[ov] = vit->second.name.empty() ? "out_" + std::to_string(ov)
+                                           : vit->second.name;
+    }
+  }
+
+  auto emit_body = [&](std::ostringstream& s) -> bool {
+    for (uint32_t ri : b.inst_refs) {
+      const Inst& inst = fn.insts[ri];
+      switch (inst.opcode) {
+        case kOpPhi: continue;  // handled on edges
+        case kOpStore: case kOpImageWrite: case 86 /* OpSampledImage */: {
+          bool ok = true;
+          EmitExpr(fn, inst, exprs, s, ok);
+          if (!ok) return fail("unsupported operation in shader body (opcode " +
+                               std::to_string(inst.opcode) + ")");
+          break;
+        }
+        continue;
+        default: {
+          bool ok = true;
+          std::string e = EmitExpr(fn, inst, exprs, s, ok);
+          if (!ok) return fail("unsupported operation in shader body (opcode " +
+                               std::to_string(inst.opcode) + ")");
+          if (!e.empty() && inst.ops.size() > 1) {
+            if (inst.opcode == 60 /* ImageTexelPointer */ ||
+                inst.opcode == 86 /* SampledImage */) {
+              // Reference-like results: keep the raw expression in the map.
+              exprs[inst.ops[1]] = e;
+            } else if (OpHasTypedResult(inst.opcode)) {
+              s << "  " << NameOf(inst.ops[1]) << " = " << e << ";\n";
+              exprs[inst.ops[1]] = NameOf(inst.ops[1]);
+            }
+          }
+          break;
+        }
+      }
+    }
+    return true;
+  };
+  if (!emit_body(out)) return false;
+
+  // Terminators.
+  switch (b.term_op) {
+    case kOpReturn: {
+      EmitEdgePhis(fn, block_id, exprs, out);
+      out << "  return";
+      if (!entry_return_expr_.empty()) out << " " << entry_return_expr_;
+      out << ";\n";
+      return true;
+    }
+    case kOpReturnValue: {
+      EmitEdgePhis(fn, block_id, exprs, out);
+      if (!entry_return_expr_.empty()) {
+        // Outputs were stored to variables; return the interface struct.
+        out << "  return " << entry_return_expr_ << ";\n";
+      } else {
+        out << "  return " << exprs.at(b.ret_value_id) << ";\n";
+      }
+      return true;
+    }
+    case kOpKill: {
+      out << "  discard;\n  return";
+      if (!entry_return_expr_.empty()) out << " " << entry_return_expr_;
+      out << ";\n";
+      return true;
+    }
+    case kOpUnreachable: {
+      return true;
+    }
+    case kOpBranch: {
+      EmitEdgePhis(fn, block_id, exprs, out);
+      if (b.target_id == b.id) return fail("self-loop without OpLoopMerge");
+      // Back edge inside a continuing section: end of the continuing block.
+      if (loop_header_id != 0 && b.target_id == loop_header_id) return true;
+      if (loop_continue_id != 0 && b.target_id == loop_continue_id) {
+        out << "  continue;\n";
+        return true;
+      }
+      if (loop_merge_id != 0 && b.target_id == loop_merge_id) {
+        out << "  break;\n";
+        return true;
+      }
+      // Loop header (has OpLoopMerge): emit the loop construct.
+      if (b.continue_id != 0) {
+        uint32_t body_id = b.target_id;
+        if (b.term_op == kOpBranchConditional) {
+          body_id = (b.true_id != b.merge_id && b.true_id != b.continue_id)
+                        ? b.true_id
+                        : b.false_id;
+        }
+        std::unordered_set<uint32_t> inner_stops = stops;
+        inner_stops.insert(b.continue_id);
+        inner_stops.insert(b.merge_id);
+        std::ostringstream body_out, cont_out;
+        if (!Structurize(fn, body_id, inner_stops, depth + 1, body_out,
+                         b.continue_id, b.merge_id, b.id)) {
+          return false;
+        }
+        if (!Structurize(fn, b.continue_id, {}, depth + 1, cont_out,
+                         b.continue_id, b.merge_id, b.id)) {
+          return false;
+        }
+        const Block& cont = (*blocks_)[b.continue_id];
+        std::string break_if;
+        if (cont.term_op == kOpBranchConditional) {
+          auto cit = constants_.find(cont.cond_id);
+          std::string cond = cit != constants_.end()
+                                 ? cit->second
+                                 : (exprs.count(cont.cond_id)
+                                        ? exprs[cont.cond_id]
+                                        : NameOf(cont.cond_id));
+          if (cont.true_id == b.id && cont.false_id == b.merge_id) {
+            break_if = "!(" + cond + ")";
+          } else if (cont.false_id == b.id && cont.true_id == b.merge_id) {
+            break_if = cond;
+          }
+        }
+        if (!break_if.empty()) {
+          // do-while shape: the back-edge condition lives in the continue
+          // block -> statements go to the WGSL continuing section.
+          out << "  loop {\n" << body_out.str()
+              << "  } continuing {\n" << cont_out.str()
+              << "    break if " << break_if << ";\n  }\n";
+        } else {
+          // while-shape: the body's exit check already emitted `break`;
+          // the continue-block statements run after it, still inside the
+          // loop body (unreachable once broken, executed otherwise).
+          out << "  loop {\n" << body_out.str() << cont_out.str() << "  }\n";
+        }
+        if (b.merge_id) {
+          return Structurize(fn, b.merge_id, stops, depth + 1, out);
+        }
+        return true;
+      }
+      return Structurize(fn, b.target_id, stops, depth + 1, out,
+                         loop_continue_id, loop_merge_id, loop_header_id);
+    }
+    case kOpBranchConditional: {
+      auto cond_str = [&]() {
+        auto cit = constants_.find(b.cond_id);
+        return cit != constants_.end()
+                   ? cit->second
+                   : (exprs.count(b.cond_id) ? exprs[b.cond_id] : NameOf(b.cond_id));
+      };
+      // Loop-context special cases (break/continue on the edges).
+      if (loop_merge_id != 0 || loop_continue_id != 0) {
+        const std::string cond = cond_str();
+        bool t_cont = b.true_id == loop_continue_id;
+        bool f_cont = b.false_id == loop_continue_id;
+        bool t_merge = b.true_id == loop_merge_id;
+        bool f_merge = b.false_id == loop_merge_id;
+        if (t_cont && f_merge) {
+          out << "  if (!(" << cond << ")) { break; }\n";
+          return true;
+        }
+        if (t_merge && f_cont) {
+          out << "  if (" << cond << ") { break; }\n";
+          return true;
+        }
+        if (t_cont && !f_merge) {
+          out << "  if (" << cond << ") { continue; }\n";
+          return Structurize(fn, b.false_id, stops, depth + 1, out,
+                             loop_continue_id, loop_merge_id, loop_header_id);
+        }
+        if (f_cont && !t_merge) {
+          out << "  if (!(" << cond << ")) { continue; }\n";
+          return Structurize(fn, b.true_id, stops, depth + 1, out,
+                             loop_continue_id, loop_merge_id, loop_header_id);
+        }
+        if (t_merge && !f_cont) {
+          std::ostringstream f_out;
+          EmitPhisFor(fn, block_id, b.false_id, exprs, f_out);
+          if (!Structurize(fn, b.false_id, stops, depth + 1, f_out,
+                           loop_continue_id, loop_merge_id, loop_header_id)) {
+            return false;
+          }
+          out << "  if (" << cond << ") { break; }\n" << f_out.str();
+          return true;
+        }
+        if (f_merge && !t_cont) {
+          std::ostringstream t_out;
+          EmitPhisFor(fn, block_id, b.true_id, exprs, t_out);
+          if (!Structurize(fn, b.true_id, stops, depth + 1, t_out,
+                           loop_continue_id, loop_merge_id, loop_header_id)) {
+            return false;
+          }
+          out << "  if (!(" << cond << ")) { break; }\n" << t_out.str();
+          return true;
+        }
+      }
+      // Generic selection.
+      std::unordered_set<uint32_t> inner_stops = stops;
+      if (b.merge_id) inner_stops.insert(b.merge_id);
+      const std::string cond = cond_str();
+      bool true_is_merge = b.merge_id && b.true_id == b.merge_id;
+      bool false_is_merge = b.merge_id && b.false_id == b.merge_id;
+      std::ostringstream t_out, f_out;
+      EmitPhisFor(fn, block_id, b.true_id, exprs, t_out);
+      if (!true_is_merge) {
+        if (!Structurize(fn, b.true_id, inner_stops, depth + 1, t_out,
+                         loop_continue_id, loop_merge_id, loop_header_id)) {
+          return false;
+        }
+      }
+      EmitPhisFor(fn, block_id, b.false_id, exprs, f_out);
+      if (!false_is_merge) {
+        if (!Structurize(fn, b.false_id, inner_stops, depth + 1, f_out,
+                         loop_continue_id, loop_merge_id, loop_header_id)) {
+          return false;
+        }
+      }
+      out << "  if " << cond << " {\n" << t_out.str() << "  } else {\n"
+          << f_out.str() << "  }\n";
+      if (b.merge_id) {
+        return Structurize(fn, b.merge_id, stops, depth + 1, out,
+                           loop_continue_id, loop_merge_id, loop_header_id);
+      }
+      return true;
+    }
+    case kOpSwitch: {
+      std::unordered_set<uint32_t> inner_stops = stops;
+      if (b.merge_id) inner_stops.insert(b.merge_id);
+      std::string sel = exprs.count(b.selector_id) ? exprs[b.selector_id]
+                                                   : NameOf(b.selector_id);
+      bool first = true;
+      for (auto& [lit, target] : b.cases) {
+        auto cit = constants_.find(lit);
+        std::string lit_s = cit != constants_.end() ? cit->second
+                                                    : std::to_string(lit);
+        std::ostringstream c_out;
+        if (!Structurize(fn, target, inner_stops, depth + 1, c_out)) return false;
+        out << (first ? "  if (" : "  else if (") << sel << " == " << lit_s
+            << ") {\n"
+            << c_out.str() << "  }\n";
+        first = false;
+      }
+      std::ostringstream d_out;
+      if (b.default_id && blocks_->count(b.default_id) &&
+          !emitted_blocks_.count(b.default_id) && !inner_stops.count(b.default_id)) {
+        if (!Structurize(fn, b.default_id, inner_stops, depth + 1, d_out))
+          return false;
+        out << "  else {\n" << d_out.str() << "  }\n";
+      }
+      if (b.merge_id) {
+        return Structurize(fn, b.merge_id, stops, depth + 1, out);
+      }
+      return true;
+    }
+    default:
+      return fail("unsupported terminator");
+  }
+}
+
+}  // namespace
+
+bool TranslateSpirvToWgsl(const uint32_t* spirv_words, size_t word_count,
+                          int shader_stage, WgslTranslationResult& result) {
+  Translator translator;
+  return translator.Run(spirv_words, word_count, shader_stage, result);
+}
+
+}  // namespace rex::graphics::webgpu
diff --git a/src/graphics/webgpu/wgsl_translator.h b/src/graphics/webgpu/wgsl_translator.h
new file mode 100644
index 0000000..d1ccfda
--- /dev/null
+++ b/src/graphics/webgpu/wgsl_translator.h
@@ -0,0 +1,40 @@
+#pragma once
+/**
+ * @file        webgpu/wgsl_translator.h
+ * @brief       SPIR-V to WGSL translator for the WebGPU (browser) backend
+ *
+ * Dawn (the WebGPU implementation Emscripten targets) consumes WGSL only --
+ * unlike Vulkan it does not accept SPIR-V input, and SPIRV-Cross no longer
+ * ships a WGSL writer upstream. This translator converts the SPIR-V produced
+ * by the backend-agnostic SpirvShaderTranslator into WGSL.
+ *
+ * Scope: the opcode subset the in-tree translator emits (arithmetic, bitwise
+ * and bitfield ops, comparisons, logical ops, select, Phi, switch, composite
+ * ops, memory ops, image ops, derivatives, GLSL.std.450 extended
+ * instructions). CFG shapes it cannot structurize into WGSL control flow
+ * produce a clean error, never silent miscompilation.
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace rex::graphics::webgpu {
+
+struct WgslTranslationResult {
+  bool success = false;
+  // WGSL source on success; empty on failure.
+  std::string wgsl;
+  // Human-readable failure reason on failure.
+  std::string error;
+};
+
+// Translates a SPIR-V module (compiled for the WebGPU profile) to WGSL.
+// shader_stage: 0 = vertex, 1 = fragment, 2 = compute (used for the entry
+// point attribute and for choosing implicit-lod vs explicit-lod sampling).
+bool TranslateSpirvToWgsl(const uint32_t* spirv_words, size_t word_count,
+                          int shader_stage, WgslTranslationResult& result);
+
+}  // namespace rex::graphics::webgpu
