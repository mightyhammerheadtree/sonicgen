+#pragma once
+/**
+ * @file        webgpu/webgpu_presenter.h
+ * @brief       WebGPU graphics provider, presenter and immediate drawer
+ *
+ * The presenter owns the canvas surface connection: the guest front buffer is
+ * uploaded as a texture and painted to the swapchain with a letterboxing quad
+ * (embedded WGSL), then presented. This is the complete browser presentation
+ * path; FSR/CAS paint effects are a Phase 4 addition on top of it.
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include <memory>
+
+#include <rex/ui/graphics_provider.h>
+#include <rex/ui/immediate_drawer.h>
+#include <rex/ui/presenter.h>
+
+#include "webgpu_device.h"
+#include "webgpu_util.h"
+
+namespace rex::graphics::webgpu {
+
+// Derived so it can construct the protected base; carries no extra payload
+// for the web backend (uploads happen through the deferred queue).
+class WebGPUGuestOutputRefreshContext : public rex::ui::Presenter::GuestOutputRefreshContext {
+ public:
+  explicit WebGPUGuestOutputRefreshContext(bool& is_8bpc_out_ref)
+      : GuestOutputRefreshContext(is_8bpc_out_ref) {}
+};
+
+class WebGPUPresenter : public rex::ui::Presenter {
+ public:
+  explicit WebGPUPresenter(HostGpuLossCallback host_gpu_loss_callback,
+                           WebGPUDevice* device);
+  ~WebGPUPresenter() override;
+
+  // Presenter
+  rex::ui::Surface::TypeFlags GetSupportedSurfaceTypes() const override;
+  bool CaptureGuestOutput(rex::ui::RawImage& image_out) override;
+
+ protected:
+  SurfacePaintConnectResult ConnectOrReconnectPaintingToSurfaceFromUIThread(
+      rex::ui::Surface& new_surface, uint32_t new_surface_width,
+      uint32_t new_surface_height, bool was_paintable,
+      bool& is_vsync_implicit_out) override;
+  void DisconnectPaintingFromSurfaceFromUIThreadImpl() override;
+  bool RefreshGuestOutputImpl(uint32_t mailbox_index, uint32_t frontbuffer_width,
+                              uint32_t frontbuffer_height,
+                              std::function<bool(GuestOutputRefreshContext&)> refresher,
+                              bool& is_8bpc_out_ref) override;
+  PaintResult PaintAndPresentImpl(bool execute_ui_drawers) override;
+
+ public:
+  // Called by the graphics system each main-thread frame before painting.
+  void SetGuestTexture(WGPUTexture texture, uint32_t width, uint32_t height);
+
+ private:
+  // Paint pipeline over the shared letterbox shader (webgpu_util.cpp): group
+  // 0 = letterbox uniform, group 1 = guest texture + sampler.
+  bool EnsurePaintPipeline();
+
+  WebGPUDevice* device_ = nullptr;
+  // Latest guest output (owned by the texture cache, borrowed here).
+  WGPUTexture guest_texture_ = nullptr;
+  uint32_t guest_width_ = 0;
+  uint32_t guest_height_ = 0;
+  WGPUTextureView guest_view_ = nullptr;
+  WGPUSampler paint_sampler_ = nullptr;
+  PaintPipeline paint_;
+  bool connected_ = false;
+};
+
+class WebGPUProvider : public rex::ui::GraphicsProvider {
+ public:
+  explicit WebGPUProvider(WebGPUDevice* device) : device_(device) {}
+
+  std::unique_ptr<rex::ui::Presenter> CreatePresenter(
+      rex::ui::Presenter::HostGpuLossCallback host_gpu_loss_callback =
+          rex::ui::Presenter::FatalErrorHostGpuLossCallback) override;
+  std::unique_ptr<rex::ui::ImmediateDrawer> CreateImmediateDrawer() override;
+
+ private:
+  WebGPUDevice* device_;
+};
+
+// Minimal immediate drawer: UI overlays (ImGui) draw through it. A no-op
+// implementation keeps the app running without the overlay until Phase 4.
+class WebGPUImmediateDrawer : public rex::ui::ImmediateDrawer {
+ public:
+  explicit WebGPUImmediateDrawer(WebGPUDevice* device) : device_(device) {}
+
+ protected:
+  std::unique_ptr<rex::ui::ImmediateTexture> CreateTexture(
+      uint32_t width, uint32_t height, rex::ui::ImmediateTextureFilter filter,
+      bool is_repeated, const uint8_t* data) override;
+  void Begin(rex::ui::UIDrawContext& ui_draw_context, float coordinate_space_width,
+             float coordinate_space_height) override;
+  void BeginDrawBatch(const rex::ui::ImmediateDrawBatch& batch) override;
+  void Draw(const rex::ui::ImmediateDraw& draw) override;
+  void EndDrawBatch() override;
+
+ private:
+  WebGPUDevice* device_;
+};
+
+}  // namespace rex::graphics::webgpu
diff --git a/src/graphics/webgpu/webgpu_util.cpp b/src/graphics/webgpu/webgpu_util.cpp
new file mode 100644
index 0000000..802b813
--- /dev/null
+++ b/src/graphics/webgpu/webgpu_util.cpp
@@ -0,0 +1,375 @@
+/**
+ * @file        webgpu/webgpu_util.cpp
+ * @brief       WebGPU helpers shared by the wasm backend (implementation)
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include "webgpu_util.h"
+
+#include <cmath>
+
+#include <rex/logging.h>
+
+namespace rex::graphics::webgpu {
+
+namespace {
+
+// Presentation shader: aspect-preserving letterbox quad. The UV transform
+// (scale in .xy, offset in .zw) crops the guest image into the surface's
+// aspect box; the load-op clear fills the bars.
+constexpr const char* kPaintWGSL = R"(
+struct VsOut {
+  @builtin(position) pos : vec4<f32>,
+  @location(0) uv : vec2<f32>,
+};
+struct Letterbox {
+  scale_offset : vec4<f32>,
+};
+@group(0) @binding(0) var<uniform> letterbox : Letterbox;
+@group(1) @binding(0) var guest : texture_2d<f32>;
+@group(1) @binding(1) var samp : sampler;
+@vertex
+fn vs_main(@builtin(vertex_index) vid : u32) -> VsOut {
+  var pos = array<vec2<f32>, 6>(
+    vec2<f32>(-1.0, -1.0), vec2<f32>(1.0, -1.0), vec2<f32>(-1.0, 1.0),
+    vec2<f32>(-1.0, 1.0), vec2<f32>(1.0, -1.0), vec2<f32>(1.0, 1.0));
+  var out : VsOut;
+  out.pos = vec4<f32>(pos[vid], 0.0, 1.0);
+  // Centered letterbox UV: maps the surface quad into the guest image rect.
+  var u = f32((vid == 1u) || (vid == 4u));
+  var v = f32((vid == 2u) || (vid == 3u));
+  out.uv = vec2<f32>(u, v) * letterbox.scale_offset.xy +
+           letterbox.scale_offset.zw;
+  return out;
+}
+@fragment
+fn fs_main(in : VsOut) -> @location(0) vec4<f32> {
+  var uv = clamp(in.uv, vec2<f32>(0.0), vec2<f32>(1.0));
+  return textureSample(guest, samp, uv);
+}
+)";
+
+}  // namespace
+
+WGPUShaderModule CreateWGSLShaderModule(WGPUDevice device,
+                                        const std::string& wgsl,
+                                        const char* label) {
+  if (!device || wgsl.empty()) return nullptr;
+  WGPUShaderSourceWGSL wgsl_source = {};
+  wgsl_source.chain.sType = WGPUSType_ShaderSourceWGSL;
+  wgsl_source.code = WGPUStringView{wgsl.data(), wgsl.size()};
+  WGPUShaderModuleDescriptor desc = {};
+  desc.label = SViewCast(label);
+  desc.nextInChain = &wgsl_source.chain;
+  WGPUShaderModule module = wgpuDeviceCreateShaderModule(device, &desc);
+  if (!module) {
+    REXGPU_ERROR("webgpu: WGSL shader module creation failed ({})", label);
+  }
+  return module;
+}
+
+WGPUBindGroupLayout CreateSharedMemoryBindGroupLayout(WGPUDevice device) {
+  if (!device) return nullptr;
+  WGPUBindGroupLayoutEntry entry = {};
+  entry.binding = 0;
+  entry.visibility = WGPUShaderStage_Vertex | WGPUShaderStage_Fragment |
+                     WGPUShaderStage_Compute;
+  entry.buffer.type = WGPUBufferBindingType_ReadOnlyStorage;
+  entry.buffer.minBindingSize = 0;
+  WGPUBindGroupLayoutDescriptor desc = {};
+  desc.entryCount = 1;
+  desc.entries = &entry;
+  return wgpuDeviceCreateBindGroupLayout(device, &desc);
+}
+
+WGPUBindGroupLayout CreateConstantsBindGroupLayout(WGPUDevice device) {
+  if (!device) return nullptr;
+  WGPUBindGroupLayoutEntry entries[kConstantBufferCount] = {};
+  for (uint32_t i = 0; i < kConstantBufferCount; ++i) {
+    entries[i].binding = i;
+    entries[i].visibility = WGPUShaderStage_Vertex | WGPUShaderStage_Fragment;
+    entries[i].buffer.type = WGPUBufferBindingType_Uniform;
+    entries[i].buffer.minBindingSize = 0;
+  }
+  WGPUBindGroupLayoutDescriptor desc = {};
+  desc.entryCount = kConstantBufferCount;
+  desc.entries = entries;
+  return wgpuDeviceCreateBindGroupLayout(device, &desc);
+}
+
+WGPUBindGroupLayout CreateTexturesBindGroupLayout(WGPUDevice device,
+                                                  uint32_t texture_count,
+                                                  uint32_t sampler_count) {
+  if (!device || (texture_count + sampler_count) == 0) return nullptr;
+  std::vector<WGPUBindGroupLayoutEntry> entries;
+  entries.reserve(texture_count + sampler_count);
+  for (uint32_t i = 0; i < texture_count; ++i) {
+    WGPUBindGroupLayoutEntry entry = {};
+    entry.binding = i;
+    entry.visibility = WGPUShaderStage_Vertex | WGPUShaderStage_Fragment;
+    entry.texture.sampleType = WGPUTextureSampleType_Float;
+    entry.texture.viewDimension = WGPUTextureViewDimension_2D;
+    entries.push_back(entry);
+  }
+  for (uint32_t i = 0; i < sampler_count; ++i) {
+    WGPUBindGroupLayoutEntry entry = {};
+    entry.binding = texture_count + i;
+    entry.visibility = WGPUShaderStage_Vertex | WGPUShaderStage_Fragment;
+    entry.sampler.type = WGPUSamplerBindingType_Filtering;
+    entries.push_back(entry);
+  }
+  WGPUBindGroupLayoutDescriptor desc = {};
+  desc.entryCount = uint32_t(entries.size());
+  desc.entries = entries.data();
+  return wgpuDeviceCreateBindGroupLayout(device, &desc);
+}
+
+WGPUPipelineLayout CreatePipelineLayoutForABI(WGPUDevice device,
+                                              uint32_t vs_texture_count,
+                                              uint32_t ps_texture_count) {
+  if (!device) return nullptr;
+  WGPUBindGroupLayout set0 = CreateSharedMemoryBindGroupLayout(device);
+  WGPUBindGroupLayout set1 = CreateConstantsBindGroupLayout(device);
+  if (!set0 || !set1) {
+    if (set0) wgpuBindGroupLayoutRelease(set0);
+    if (set1) wgpuBindGroupLayoutRelease(set1);
+    return nullptr;
+  }
+  WGPUBindGroupLayout set2 = nullptr;
+  WGPUBindGroupLayout set3 = nullptr;
+  WGPUBindGroupLayout layouts[4];
+  uint32_t count = 0;
+  layouts[count++] = set0;
+  layouts[count++] = set1;
+  if (vs_texture_count) {
+    set2 = CreateTexturesBindGroupLayout(device, vs_texture_count,
+                                         vs_texture_count);
+    if (!set2) goto fail;
+    layouts[count++] = set2;
+  }
+  if (ps_texture_count) {
+    set3 = CreateTexturesBindGroupLayout(device, ps_texture_count,
+                                         ps_texture_count);
+    if (!set3) goto fail;
+    layouts[count++] = set3;
+  }
+  {
+    WGPUPipelineLayoutDescriptor desc = {};
+    desc.bindGroupLayouts = layouts;
+    desc.bindGroupLayoutCount = count;
+    WGPUPipelineLayout layout = wgpuDeviceCreatePipelineLayout(device, &desc);
+    wgpuBindGroupLayoutRelease(set0);
+    wgpuBindGroupLayoutRelease(set1);
+    if (set2) wgpuBindGroupLayoutRelease(set2);
+    if (set3) wgpuBindGroupLayoutRelease(set3);
+    return layout;
+  }
+fail:
+  wgpuBindGroupLayoutRelease(set0);
+  wgpuBindGroupLayoutRelease(set1);
+  if (set2) wgpuBindGroupLayoutRelease(set2);
+  if (set3) wgpuBindGroupLayoutRelease(set3);
+  return nullptr;
+}
+
+WGPUTextureFormat MapGuestColorFormat(xenos::ColorRenderTargetFormat format) {
+  // The backend canonicalizes color attachments to 32-bit BGRA8: guest shaders
+  // write through the WGSL translator which outputs unorm8 BGRA, and the
+  // 16-bit/float guest formats are handled at the EDRAM level by the resolve
+  // path. Formats this backend cannot represent are rendered as BGRA8 too
+  // (documented v1 simplification).
+  (void)format;
+  return WGPUTextureFormat_BGRA8Unorm;
+}
+
+uint32_t HostBytesPerPixel(WGPUTextureFormat format) {
+  switch (format) {
+    case WGPUTextureFormat_BGRA8Unorm:
+    case WGPUTextureFormat_RGBA8Unorm:
+    case WGPUTextureFormat_RGBA8UnormSrgb:
+      return 4;
+    default:
+      return 4;
+  }
+}
+
+WGPUSampler CreateGuestSampler(
+    WGPUDevice device, xenos::TextureFilter mag_filter,
+    xenos::TextureFilter min_filter, xenos::TextureFilter mip_filter,
+    xenos::AnisoFilter aniso_filter) {
+  if (!device) return nullptr;
+  auto map_filter = [](xenos::TextureFilter filter) {
+    switch (filter) {
+      case xenos::TextureFilter::kPoint:
+        return WGPUFilterMode_Nearest;
+      default:
+        return WGPUFilterMode_Linear;
+    }
+  };
+  WGPUSamplerDescriptor desc = {};
+  desc.magFilter = map_filter(mag_filter);
+  desc.minFilter = map_filter(min_filter);
+  // Guest mipmap filters map to the browser's two modes; anisotropy above the
+  // platform default is requested when the guest enables aniso.
+  desc.mipmapFilter = mip_filter == xenos::TextureFilter::kLinear
+                          ? WGPUMipmapFilterMode_Linear
+                          : WGPUMipmapFilterMode_Nearest;
+  desc.lodMinClamp = 0.0f;
+  desc.lodMaxClamp = 16.0f;
+  desc.maxAnisotropy =
+      aniso_filter >= xenos::AnisoFilter::kMax_4_1
+          ? (aniso_filter >= xenos::AnisoFilter::kMax_8_1 ? 8u : 4u)
+          : 1u;
+  desc.addressModeU = WGPUAddressMode_ClampToEdge;
+  desc.addressModeV = WGPUAddressMode_ClampToEdge;
+  desc.addressModeW = WGPUAddressMode_ClampToEdge;
+  return wgpuDeviceCreateSampler(device, &desc);
+}
+
+bool CreatePaintPipeline(WGPUDevice device, WGPUTextureFormat surface_format,
+                         PaintPipeline& out) {
+  if (!device) return false;
+  out.module = CreateWGSLShaderModule(device, kPaintWGSL, "paint_module");
+  if (!out.module) return false;
+
+  // Letterbox uniform (vec4 scale_offset).
+  WGPUBufferDescriptor udesc = {};
+  udesc.label = SViewCast("paint_letterbox_uniform");
+  udesc.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst;
+  udesc.size = sizeof(float) * 4;
+  out.uniform_buffer = wgpuDeviceCreateBuffer(device, &udesc);
+  if (!out.uniform_buffer) {
+    DestroyPaintPipeline(out);
+    return false;
+  }
+
+  WGPUBindGroupLayoutEntry uniform_entry = {};
+  uniform_entry.binding = 0;
+  uniform_entry.visibility = WGPUShaderStage_Vertex;
+  uniform_entry.buffer.type = WGPUBufferBindingType_Uniform;
+  uniform_entry.buffer.minBindingSize = sizeof(float) * 4;
+  WGPUBindGroupLayoutDescriptor uldesc = {};
+  uldesc.entryCount = 1;
+  uldesc.entries = &uniform_entry;
+  WGPUBindGroupLayout uniform_layout =
+      wgpuDeviceCreateBindGroupLayout(device, &uldesc);
+
+  WGPUBindGroupLayoutEntry texture_entries[2] = {};
+  texture_entries[0].binding = 0;
+  texture_entries[0].visibility = WGPUShaderStage_Fragment;
+  texture_entries[0].texture.sampleType = WGPUTextureSampleType_Float;
+  texture_entries[0].texture.viewDimension = WGPUTextureViewDimension_2D;
+  texture_entries[1].binding = 1;
+  texture_entries[1].visibility = WGPUShaderStage_Fragment;
+  texture_entries[1].sampler.type = WGPUSamplerBindingType_Filtering;
+  WGPUBindGroupLayoutDescriptor tldesc = {};
+  tldesc.entryCount = 2;
+  tldesc.entries = texture_entries;
+  out.bind_group_layout = wgpuDeviceCreateBindGroupLayout(device, &tldesc);
+
+  if (uniform_layout && out.bind_group_layout) {
+    WGPUBindGroupLayout layouts[2] = {uniform_layout, out.bind_group_layout};
+    WGPUPipelineLayoutDescriptor pldesc = {};
+    pldesc.bindGroupLayouts = layouts;
+    pldesc.bindGroupLayoutCount = 2;
+    WGPUPipelineLayout layout = wgpuDeviceCreatePipelineLayout(device, &pldesc);
+    if (layout) {
+      WGPUVertexState vs = {};
+      vs.module = out.module;
+      vs.entryPoint = SViewCast("vs_main");
+      WGPUColorTargetState target = {};
+      target.format = surface_format;
+      target.writeMask = WGPUColorWriteMask_All;
+      WGPUFragmentState fs = {};
+      fs.module = out.module;
+      fs.entryPoint = SViewCast("fs_main");
+      fs.targetCount = 1;
+      fs.targets = &target;
+      WGPURenderPipelineDescriptor pdesc = {};
+      pdesc.label = SViewCast("paint_pipeline");
+      pdesc.layout = layout;
+      pdesc.vertex = vs;
+      pdesc.fragment = &fs;
+      pdesc.primitive.topology = WGPUPrimitiveTopology_TriangleList;
+      pdesc.multisample.count = 1;
+      out.pipeline = wgpuDeviceCreateRenderPipeline(device, &pdesc);
+      wgpuPipelineLayoutRelease(layout);
+    }
+  }
+  if (uniform_layout) {
+    if (out.pipeline) {
+      WGPUBindGroupEntry entries[1] = {};
+      entries[0].binding = 0;
+      entries[0].buffer = out.uniform_buffer;
+      entries[0].offset = 0;
+      entries[0].size = sizeof(float) * 4;
+      WGPUBindGroupDescriptor bgdesc = {};
+      bgdesc.layout = uniform_layout;
+      bgdesc.entryCount = 1;
+      bgdesc.entries = entries;
+      out.bind_group = wgpuDeviceCreateBindGroup(device, &bgdesc);
+    }
+    wgpuBindGroupLayoutRelease(uniform_layout);
+  }
+  if (!out.pipeline || !out.bind_group || !out.bind_group_layout) {
+    DestroyPaintPipeline(out);
+    return false;
+  }
+  return true;
+}
+
+void DestroyPaintPipeline(PaintPipeline& paint) {
+  if (paint.bind_group) wgpuBindGroupRelease(paint.bind_group);
+  if (paint.uniform_buffer) wgpuBufferRelease(paint.uniform_buffer);
+  if (paint.bind_group_layout)
+    wgpuBindGroupLayoutRelease(paint.bind_group_layout);
+  if (paint.pipeline) wgpuRenderPipelineRelease(paint.pipeline);
+  if (paint.module) wgpuShaderModuleRelease(paint.module);
+  paint = {};
+}
+
+WGPUBindGroup CreatePaintTextureBindGroup(WGPUDevice device,
+                                          const PaintPipeline& paint,
+                                          WGPUTextureView guest_view,
+                                          WGPUSampler sampler) {
+  if (!device || !paint.bind_group_layout || !guest_view || !sampler) {
+    return nullptr;
+  }
+  WGPUBindGroupEntry entries[2] = {};
+  entries[0].binding = 0;
+  entries[0].textureView = guest_view;
+  entries[1].binding = 1;
+  entries[1].sampler = sampler;
+  WGPUBindGroupDescriptor desc = {};
+  desc.layout = paint.bind_group_layout;
+  desc.entryCount = 2;
+  desc.entries = entries;
+  return wgpuDeviceCreateBindGroup(device, &desc);
+}
+
+void UpdatePaintLetterbox(WGPUQueue queue, const PaintPipeline& paint,
+                          uint32_t surface_width, uint32_t surface_height,
+                          uint32_t guest_width, uint32_t guest_height) {
+  if (!queue || !paint.uniform_buffer || !surface_width || !surface_height ||
+      !guest_width || !guest_height) {
+    return;
+  }
+  // Map the guest rect into surface UV space, centered, preserving aspect.
+  float surface_aspect = float(surface_width) / float(surface_height);
+  float guest_aspect = float(guest_width) / float(guest_height);
+  float scale_x = 1.0f, scale_y = 1.0f;
+  if (guest_aspect > surface_aspect) {
+    scale_y = surface_aspect / guest_aspect;
+  } else {
+    scale_x = guest_aspect / surface_aspect;
+  }
+  float uv_scale_x = scale_x;
+  float uv_scale_y = scale_y;
+  float uv_off_x = (1.0f - scale_x) * 0.5f;
+  float uv_off_y = (1.0f - scale_y) * 0.5f;
+  float data[4] = {uv_scale_x, uv_scale_y, uv_off_x, uv_off_y};
+  wgpuQueueWriteBuffer(queue, paint.uniform_buffer, 0, data, sizeof(data));
+}
+
+}  // namespace rex::graphics::webgpu
