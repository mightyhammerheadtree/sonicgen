+/**
+ * @file        webgpu/graphics_system.cpp
+ * @brief       WebGPU backend graphics system (implementation)
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include <rex/graphics/webgpu/graphics_system.h>
+
+#include <rex/logging.h>
+
+#if REX_PLATFORM_EMSCRIPTEN
+#include <emscripten.h>
+#endif
+
+#include "command_processor.h"
+#include "webgpu_presenter.h"
+
+namespace rex::graphics::webgpu {
+
+WebGPUGraphicsSystem::WebGPUGraphicsSystem() = default;
+
+WebGPUGraphicsSystem::~WebGPUGraphicsSystem() = default;
+
+bool WebGPUGraphicsSystem::IsAvailable() {
+#if REX_PLATFORM_EMSCRIPTEN
+  return EM_ASM_INT({
+    return (typeof navigator !== 'undefined' && navigator.gpu) ? 1 : 0;
+  }) != 0;
+#else
+  return false;
+#endif
+}
+
+std::string WebGPUGraphicsSystem::name() const {
+  return device()->ready() ? "WebGPU (wasm)" : "WebGPU (wasm, initializing)";
+}
+
+void WebGPUGraphicsSystem::CreateProvider(bool with_presentation) {
+  (void)with_presentation;
+  if (!IsAvailable()) {
+    REXLOG_ERROR(
+        "rexgpu-xenos[webgpu]: navigator.gpu unavailable -- use a WebGPU-enabled "
+        "browser (Chrome/Edge 113+, Firefox with WebGPU enabled, Safari 26+).");
+  }
+  // Device acquisition is asynchronous; the provider is created immediately
+  // and the presenter connects once the device state machine completes.
+  device()->Initialize("#canvas");
+  provider_ = std::make_unique<WebGPUProvider>(device_.get());
+  provider_supports_presentation_ = true;
+}
+
+std::unique_ptr<CommandProcessor> WebGPUGraphicsSystem::CreateCommandProcessor() {
+  return std::make_unique<WebGPUCommandProcessor>(this, kernel_state_, device_.get());
+}
+
+WebGPUDevice* WebGPUGraphicsSystem::device() const { return device_.get(); }
+
+void WebGPUGraphicsSystem::PumpFrame(uint32_t surface_width,
+                                     uint32_t surface_height) {
+  // Main thread: complete device init, drain the deferred queue, present.
+  device_->Pump();
+  if (command_processor_) {
+    static_cast<WebGPUCommandProcessor*>(command_processor_.get())
+        ->PumpFrame(surface_width, surface_height);
+  }
+}
+
+}  // namespace rex::graphics::webgpu
