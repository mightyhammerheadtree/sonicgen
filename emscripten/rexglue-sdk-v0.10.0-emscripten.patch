+#pragma once
+/**
+ * @file        webgpu/webgpu_util.h
+ * @brief       WebGPU helpers shared by the wasm backend
+ *
+ * Contains the fixed shader-interface ABI factories. The SpirvShaderTranslator
+ * emits a fixed descriptor set layout that the WGSL translator preserves
+ * verbatim (@group/@binding are copied from the SPIR-V descriptor set and
+ * binding decorations):
+ *
+ *   set 0: binding 0 - shared memory storage buffer (read-only)
+ *   set 1: bindings 0..4 - uniform buffers
+ *          (0 system, 1 float VS, 2 float PS, 3 bool/loop, 4 fetch)
+ *   set 2: vertex textures: bindings [0, texN) = textures, [texN, texN+sampN)
+ *          = samplers
+ *   set 3: pixel textures: same numbering
+ *
+ * Every pipeline built from translated shaders uses this exact layout so bind
+ * groups can be created once and reused, and guest pipelines need no vertex
+ * buffer layouts (vertex fetch reads through the shared memory storage
+ * buffer).
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <webgpu/webgpu.h>
+
+#include <rex/graphics/xenos.h>
+
+namespace rex::graphics::webgpu {
+
+inline WGPUStringView SViewCast(const char* s) {
+  return WGPUStringView{s, s ? std::strlen(s) : 0u};
+}
+
+// Descriptor set indices, mirroring SpirvShaderTranslator.
+enum : uint32_t {
+  kDescriptorSetSharedMemory = 0,
+  kDescriptorSetConstants = 1,
+  kDescriptorSetTexturesVertex = 2,
+  kDescriptorSetTexturesPixel = 3,
+  kDescriptorSetCount = 4,
+};
+
+// Binding indices within the constant set, mirroring SpirvShaderTranslator's
+// ConstantBuffer enum.
+enum : uint32_t {
+  kConstantBufferSystem = 0,
+  kConstantBufferFloatVertex = 1,
+  kConstantBufferFloatPixel = 2,
+  kConstantBufferBoolLoop = 3,
+  kConstantBufferFetch = 4,
+  kConstantBufferCount = 5,
+};
+
+// Creates a shader module from WGSL source, or null on error (message logged).
+WGPUShaderModule CreateWGSLShaderModule(WGPUDevice device,
+                                        const std::string& wgsl,
+                                        const char* label);
+
+// Fixed-ABI bind group layouts (created per device, cacheable by the caller).
+WGPUBindGroupLayout CreateSharedMemoryBindGroupLayout(WGPUDevice device);
+WGPUBindGroupLayout CreateConstantsBindGroupLayout(WGPUDevice device);
+// Textures at bindings [0, texture_count), samplers after them.
+WGPUBindGroupLayout CreateTexturesBindGroupLayout(WGPUDevice device,
+                                                  uint32_t texture_count,
+                                                  uint32_t sampler_count);
+
+// Pipeline layout for the sets [0, set_count) with the fixed ABI. Sets 2/3 use
+// the provided texture/sampler counts. Returns null on failure.
+WGPUPipelineLayout CreatePipelineLayoutForABI(WGPUDevice device,
+                                              uint32_t vs_texture_count,
+                                              uint32_t ps_texture_count);
+
+// Formats: guest color format -> the canonical host format this backend
+// renders and uploads with (BGRA8Unorm for 32-bit color, RGBA8Unorm fallback
+// otherwise), plus bytes per texel of the *host* format.
+WGPUTextureFormat MapGuestColorFormat(xenos::ColorRenderTargetFormat format);
+uint32_t HostBytesPerPixel(WGPUTextureFormat format);
+
+// Filter mapping for guest sampler state -> WGPUSampler.
+WGPUSampler CreateGuestSampler(
+    WGPUDevice device, xenos::TextureFilter mag_filter,
+    xenos::TextureFilter min_filter, xenos::TextureFilter mip_filter,
+    xenos::AnisoFilter aniso_filter);
+
+// Presentation paint pipeline: textured, aspect-preserving quad drawing a
+// guest output texture onto the canvas surface. Shared by the presenter and
+// the command processor's per-frame pump. The pipeline reads the guest view
+// and sampler from bind group 0, and a vec4 (scale.xy, offset.xy) UV transform
+// from bind group 1 uniform buffer.
+struct PaintPipeline {
+  WGPUShaderModule module = nullptr;
+  WGPURenderPipeline pipeline = nullptr;
+  WGPUBindGroupLayout bind_group_layout = nullptr;
+  WGPUBuffer uniform_buffer = nullptr;
+  WGPUBindGroup bind_group = nullptr;  // uniform only; texture set per frame
+};
+// Creates the pipeline + fixed uniform bind group part. Returns false on
+// failure (nothing needs releasing).
+bool CreatePaintPipeline(WGPUDevice device, WGPUTextureFormat surface_format,
+                         PaintPipeline& out);
+void DestroyPaintPipeline(PaintPipeline& paint);
+// Creates the per-frame bind group for the guest texture (released by the
+// caller after the pass).
+WGPUBindGroup CreatePaintTextureBindGroup(WGPUDevice device,
+                                          const PaintPipeline& paint,
+                                          WGPUTextureView guest_view,
+                                          WGPUSampler sampler);
+// Writes the letterbox UV transform for a guest image in a surface of the
+// given size into the paint uniform buffer.
+void UpdatePaintLetterbox(WGPUQueue queue, const PaintPipeline& paint,
+                          uint32_t surface_width, uint32_t surface_height,
+                          uint32_t guest_width, uint32_t guest_height);
+
+}  // namespace rex::graphics::webgpu
