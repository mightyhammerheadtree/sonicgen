+// --------------------------- command processor hooks ------------------------
+
+bool WebGPUCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type,
+                                       uint32_t index_count,
+                                       IndexBufferInfo* index_buffer_info,
+                                       bool major_mode_explicit) {
+  (void)major_mode_explicit;
+  CapturedDraw draw;
+  if (!CaptureDraw(prim_type, index_count, index_buffer_info, draw)) {
+    return false;
+  }
+  deferred_queue_.Push([this, draw = std::move(draw)]() {
+    if (!device_->ready()) return;
+    WGPUDevice device = device_->device();
+    WGPUQueue queue = device_->queue();
+
+    // 1. Upload captured shared memory ranges (vertex fetch + index buffer).
+    for (const CapturedDraw::MemoryRange& range : draw.ranges) {
+      shared_memory_->Upload(range.guest_address, range.data);
+    }
+    if (!draw.index_buffer.data.empty()) {
+      shared_memory_->Upload(draw.index_buffer.guest_address,
+                             draw.index_buffer.data);
+    }
+
+    // 2. Constant banks -> set 1 bind group.
+    WGPUBindGroup constants_group =
+        constant_buffers_->Upload(device, draw.constants);
+    if (!constants_group) {
+      REXGPU_ERROR("webgpu: constant buffer upload failed; draw skipped");
+      return;
+    }
+
+    // 3. Shader modules from the captured WGSL (released after pipeline
+    //    creation; the pipeline keeps the compiled state).
+    WGPUShaderModule vs_module =
+        CreateWGSLShaderModule(device, draw.vs_wgsl, "guest_vs");
+    if (!vs_module) return;
+    WGPUShaderModule ps_module =
+        draw.depth_only
+            ? nullptr
+            : CreateWGSLShaderModule(device, draw.ps_wgsl, "guest_ps");
+    if (!draw.depth_only && !ps_module) {
+      wgpuShaderModuleRelease(vs_module);
+      return;
+    }
+
+    // 4. Pipeline (fixed ABI layout; keyed by shaders + state).
+    WebGPUPipelineKey key;
+    key.vertex_hash = draw.vs_hash;
+    key.pixel_hash = draw.ps_hash;
+    key.vs_texture_count = draw.vs_texture_count;
+    key.ps_texture_count = draw.ps_texture_count;
+    key.blend_packed = draw.blend_packed;
+    key.topology = draw.topology;
+    key.has_pixel_shader = draw.depth_only ? 0u : 1u;
+    WGPURenderPipeline pipeline = pipeline_cache_->GetOrCreate(
+        vs_module, ps_module, key);
+    wgpuShaderModuleRelease(vs_module);
+    if (ps_module) wgpuShaderModuleRelease(ps_module);
+    if (!pipeline) return;
+
+    // 5. Texture bind groups (sets 2/3), created per draw.
+    auto bind_textures = [&](const std::vector<CapturedTexture>& textures,
+                             uint32_t set_index) -> WGPUBindGroup {
+      uint32_t count = uint32_t(textures.size());
+      if (!count) return nullptr;
+      WGPUBindGroupLayout layout =
+          CreateTexturesBindGroupLayout(device, count, count);
+      if (!layout) return nullptr;
+      std::vector<WGPUBindGroupEntry> entries(count * 2);
+      for (uint32_t i = 0; i < count; ++i) {
+        WGPUTextureView view = texture_cache_->GetView(textures[i].key);
+        entries[i].binding = i;
+        entries[i].textureView = view;
+        WGPUSampler sampler = texture_cache_->GetSampler(
+            textures[i].sampler_state, xenos::xe_gpu_texture_fetch_t{});
+        entries[count + i].binding = count + i;
+        entries[count + i].sampler = sampler;
+      }
+      WGPUBindGroupDescriptor desc = {};
+      desc.layout = layout;
+      desc.entryCount = count * 2;
+      desc.entries = entries.data();
+      WGPUBindGroup group = wgpuDeviceCreateBindGroup(device, &desc);
+      wgpuBindGroupLayoutRelease(layout);
+      return group;
+    };
+    WGPUBindGroup vs_textures_group = bind_textures(draw.vs_textures, 2);
+    WGPUBindGroup ps_textures_group = bind_textures(draw.ps_textures, 3);
+
+    // 6. Render target + render pass + indexed draw.
+    WGPUTextureFormat rt_format = MapGuestColorFormat(draw.rt_format);
+    WGPUTextureView rt_view = render_target_cache_->GetView(
+        draw.rt_base, draw.rt_width, draw.rt_height, rt_format);
+    if (!rt_view) {
+      REXGPU_ERROR("webgpu: render target view unavailable; draw skipped");
+      return;
+    }
+    WGPURenderPassColorAttachment color = {};
+    color.view = rt_view;
+    color.loadOp = WGPULoadOp_Clear;  // no EDRAM copy-in in v1
+    color.storeOp = WGPUStoreOp_Store;
+    color.clearValue = WGPUColor{0.0, 0.0, 0.0, 0.0};
+    WGPURenderPassDescriptor rpdesc = {};
+    rpdesc.colorAttachmentCount = 1;
+    rpdesc.colorAttachments = &color;
+    WGPUCommandEncoderDescriptor edesc = {};
+    WGPUCommandEncoder encoder = wgpuDeviceCreateCommandEncoder(device, &edesc);
+    if (encoder) {
+      WGPURenderPassEncoder pass =
+          wgpuCommandEncoderBeginRenderPass(encoder, &rpdesc);
+      if (pass) {
+        wgpuRenderPassEncoderSetPipeline(pass, pipeline);
+        WGPUBindGroup shared_memory_group =
+            shared_memory_->GetBindGroup(device);
+        if (shared_memory_group) {
+          wgpuRenderPassEncoderSetBindGroup(pass, 0, shared_memory_group, 0,
+                                            nullptr);
+        }
+        wgpuRenderPassEncoderSetBindGroup(pass, 1, constants_group, 0, nullptr);
+        if (vs_textures_group) {
+          wgpuRenderPassEncoderSetBindGroup(pass, 2, vs_textures_group, 0,
+                                            nullptr);
+        }
+        if (ps_textures_group) {
+          wgpuRenderPassEncoderSetBindGroup(pass, 3, ps_textures_group, 0,
+                                            nullptr);
+        }
+        if (!draw.index_buffer.data.empty()) {
+          WGPUIndexFormat format = draw.index_format == xenos::IndexFormat::kInt32
+                                       ? WGPUIndexFormat_Uint32
+                                       : WGPUIndexFormat_Uint16;
+          wgpuRenderPassEncoderSetIndexBuffer(
+              pass, shared_memory_->buffer(), format,
+              draw.index_buffer.guest_address,
+              uint64_t(draw.index_buffer.data.size()));
+          wgpuRenderPassEncoderDrawIndexed(pass, draw.index_count, 1, 0, 0, 0);
+        } else {
+          wgpuRenderPassEncoderDraw(pass, draw.index_count, 1, 0, 0);
+        }
+        wgpuRenderPassEncoderEnd(pass);
+        wgpuRenderPassEncoderRelease(pass);
+      }
+      WGPUCommandBufferDescriptor cbdesc = {};
+      WGPUCommandBuffer cb = wgpuCommandEncoderFinish(encoder, &cbdesc);
+      if (cb) {
+        wgpuQueueSubmit(queue, 1, &cb);
+        wgpuCommandBufferRelease(cb);
+      }
+      wgpuCommandEncoderRelease(encoder);
+    }
+    if (vs_textures_group) wgpuBindGroupRelease(vs_textures_group);
+    if (ps_textures_group) wgpuBindGroupRelease(ps_textures_group);
+  });
+  return true;
+}
+
+bool WebGPUCommandProcessor::IssueCopy() {
+  // Render-target resolve: the resolve destination is recorded; copying to
+  // the guest resolve address (with format conversion from the EDRAM
+  // representation) is ported from the Vulkan resolve path next. Presentation
+  // reads the live render target directly, so resolves are not on the critical
+  // path in v1.
+  deferred_queue_.Push([this]() {
+    if (!device_->ready()) return;
+    // Recorded for the resolve port; no-op in v1 (see file header).
+  });
+  return true;
+}
+
+void WebGPUCommandProcessor::MakeCoherent() {
+  // Guest writes through the CPU go straight to guest memory; the captured
+  // per-draw uploads read the current contents at draw time, so no separate
+  // coherence step is needed in this backend.
+}
+
+void WebGPUCommandProcessor::PrepareForWait() {}
+
+void WebGPUCommandProcessor::ReturnFromWait() {}
+
+void WebGPUCommandProcessor::ClearCaches() {
+  deferred_queue_.Push([this]() {
+    if (!device_->ready()) return;
+    texture_cache_->Clear();
+    render_target_cache_->Clear();
+    pipeline_cache_->Clear();
+  });
+}
+
+void WebGPUCommandProcessor::InvalidateGpuMemory() { ClearCaches(); }
+
+void WebGPUCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr,
+                                       uint32_t frontbuffer_width,
+                                       uint32_t frontbuffer_height) {
+  // Capture the front buffer contents for presentation on the main thread.
+  std::vector<uint8_t> front_bytes;
+  uint32_t bytes_per_texel = 4;
+  size_t bytes = size_t(frontbuffer_width) * frontbuffer_height * bytes_per_texel;
+  const uint8_t* src = memory_->TranslatePhysical<const uint8_t*>(frontbuffer_ptr);
+  if (src && bytes && bytes <= kMaxCaptureBytes) {
+    front_bytes.assign(src, src + bytes);
+  }
+  uint32_t w = frontbuffer_width, h = frontbuffer_height;
+
+  deferred_queue_.Push([this, fb = std::move(front_bytes), w, h,
+                        base = frontbuffer_ptr]() {
+    if (!device_->ready() || fb.empty()) return;
+    TextureKey key{base, w, h, WGPUTextureFormat_BGRA8Unorm};
+    texture_cache_->Upload(key, fb);
+    swap_key_ = key;
+    swap_valid_ = true;
+    swap_width_ = w;
+    swap_height_ = h;
+  });
+}
+
+// --------------------------- presentation (main thread) ---------------------
+
+void WebGPUCommandProcessor::PresentOnSurface(uint32_t surface_width,
+                                              uint32_t surface_height) {
+  if (!device_->ready() || !swap_valid_) return;
+  if (!device_->ConfigureSurface(surface_width, surface_height)) return;
+  bool suboptimal = false;
+  WGPUTexture target = device_->AcquireSurfaceTexture(&suboptimal);
+  if (!target) return;
+
+  if (!paint_created_) {
+    paint_created_ = CreatePaintPipeline(device_->device(),
+                                         device_->surface_format(), paint_);
+    if (paint_created_) {
+      paint_sampler_handle_ = CreateGuestSampler(
+          device_->device(), xenos::TextureFilter::kLinear,
+          xenos::TextureFilter::kLinear, xenos::TextureFilter::kLinear,
+          xenos::AnisoFilter::kDisabled);
+    }
+  }
+  if (!paint_created_ || !paint_sampler_handle_) return;
+
+  WGPUTextureView guest_view = texture_cache_->GetView(swap_key_);
+  if (!guest_view) return;
+  UpdatePaintLetterbox(device_->queue(), paint_, surface_width, surface_height,
+                       swap_width_, swap_height_);
+  WGPUBindGroup texture_group = CreatePaintTextureBindGroup(
+      device_->device(), paint_, guest_view, paint_sampler_handle_);
+  if (!texture_group) return;
+
+  WGPUTextureViewDescriptor svdesc = {};
+  svdesc.format = device_->surface_format();
+  svdesc.dimension = WGPUTextureViewDimension_2D;
+  svdesc.aspect = WGPUTextureAspect_All;
+  WGPUTextureView surface_view = wgpuTextureCreateView(target, &svdesc);
+  if (surface_view) {
+    WGPURenderPassColorAttachment color = {};
+    color.view = surface_view;
+    color.loadOp = WGPULoadOp_Clear;
+    color.storeOp = WGPUStoreOp_Store;
+    color.clearValue = WGPUColor{0.0, 0.0, 0.0, 1.0};
+    WGPURenderPassDescriptor rpdesc = {};
+    rpdesc.colorAttachmentCount = 1;
+    rpdesc.colorAttachments = &color;
+    WGPUCommandEncoderDescriptor edesc = {};
+    WGPUCommandEncoder encoder =
+        wgpuDeviceCreateCommandEncoder(device_->device(), &edesc);
+    if (encoder) {
+      WGPURenderPassEncoder pass =
+          wgpuCommandEncoderBeginRenderPass(encoder, &rpdesc);
+      if (pass) {
+        wgpuRenderPassEncoderSetPipeline(pass, paint_.pipeline);
+        wgpuRenderPassEncoderSetBindGroup(pass, 0, paint_.bind_group, 0,
+                                          nullptr);
+        wgpuRenderPassEncoderSetBindGroup(pass, 1, texture_group, 0, nullptr);
+        wgpuRenderPassEncoderDraw(pass, 6, 1, 0, 0);
+        wgpuRenderPassEncoderEnd(pass);
+        wgpuRenderPassEncoderRelease(pass);
+      }
+      WGPUCommandBufferDescriptor cbdesc = {};
+      WGPUCommandBuffer cb = wgpuCommandEncoderFinish(encoder, &cbdesc);
+      if (cb) {
+        wgpuQueueSubmit(device_->queue(), 1, &cb);
+        wgpuCommandBufferRelease(cb);
+      }
+      wgpuCommandEncoderRelease(encoder);
+    }
+    wgpuTextureViewRelease(surface_view);
+  }
+  wgpuBindGroupRelease(texture_group);
+  device_->Present();
+}
+
+void WebGPUCommandProcessor::PumpFrame(uint32_t surface_width,
+                                       uint32_t surface_height) {
+  // Main thread only: drives the async device state machine, drains the
+  // captured draw/copy/upload operations into real WebGPU calls, then paints
+  // the latest guest output to the canvas surface.
+  device_->Pump();
+  deferred_queue_.Drain();
+  PresentOnSurface(surface_width, surface_height);
+}
+
+}  // namespace rex::graphics::webgpu
