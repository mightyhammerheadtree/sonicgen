+/**
+ * @file        webgpu/resources.cpp
+ * @brief       WebGPU resource caches (implementation)
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include "resources.h"
+
+#include <cstring>
+
+#include <rex/logging.h>
+
+namespace rex::graphics::webgpu {
+
+namespace {
+constexpr uint32_t kTexelCopyRowAlignment = 256;
+}  // namespace
+
+// ----------------------------- shared memory -------------------------------
+
+void WebGPUSharedMemory::Initialize(WGPUDevice device, WGPUQueue queue,
+                                    uint32_t capacity) {
+  device_ = device;
+  queue_ = queue;
+  capacity_ = capacity;
+  WGPUBufferDescriptor desc = {};
+  desc.label = SViewCast("shared_memory");
+  desc.usage = WGPUBufferUsage_Storage | WGPUBufferUsage_CopyDst;
+  desc.size = capacity_;
+  desc.mappedAtCreation = false;
+  buffer_ = wgpuDeviceCreateBuffer(device_, &desc);
+  if (!buffer_) {
+    REXGPU_ERROR("webgpu: shared memory buffer creation failed ({} bytes)",
+                 capacity_);
+  }
+}
+
+void WebGPUSharedMemory::Shutdown() {
+  if (bind_group_) wgpuBindGroupRelease(bind_group_);
+  if (bind_group_layout_) wgpuBindGroupLayoutRelease(bind_group_layout_);
+  if (buffer_) {
+    wgpuBufferRelease(buffer_);
+    buffer_ = nullptr;
+  }
+  capacity_ = 0;
+  device_ = nullptr;
+  queue_ = nullptr;
+}
+
+void WebGPUSharedMemory::Upload(uint32_t guest_offset,
+                                const std::vector<uint8_t>& data) {
+  if (!queue_ || data.empty()) return;
+  if (guest_offset + data.size() > capacity_) return;
+  wgpuQueueWriteBuffer(queue_, buffer_, guest_offset, data.data(), data.size());
+}
+
+WGPUBindGroup WebGPUSharedMemory::GetBindGroup(WGPUDevice device) {
+  if (!device || !buffer_) return nullptr;
+  if (bind_group_) return bind_group_;
+  bind_group_layout_ = CreateSharedMemoryBindGroupLayout(device);
+  if (!bind_group_layout_) return nullptr;
+  WGPUBindGroupEntry entry = {};
+  entry.binding = 0;
+  entry.buffer = buffer_;
+  entry.offset = 0;
+  entry.size = capacity_;
+  WGPUBindGroupDescriptor desc = {};
+  desc.layout = bind_group_layout_;
+  desc.entryCount = 1;
+  desc.entries = &entry;
+  bind_group_ = wgpuDeviceCreateBindGroup(device, &desc);
+  return bind_group_;
+}
+
+// ----------------------------- constant buffers ----------------------------
+
+void WebGPUConstantBuffers::Initialize(WGPUDevice device, WGPUQueue queue) {
+  device_ = device;
+  queue_ = queue;
+}
+
+void WebGPUConstantBuffers::Shutdown() {
+  if (bind_group_) wgpuBindGroupRelease(bind_group_);
+  if (bind_group_layout_) wgpuBindGroupLayoutRelease(bind_group_layout_);
+  for (WGPUBuffer buffer : buffers_) {
+    if (buffer) wgpuBufferRelease(buffer);
+  }
+  bind_group_ = nullptr;
+  bind_group_layout_ = nullptr;
+  for (WGPUBuffer& buffer : buffers_) buffer = nullptr;
+  for (uint32_t& size : buffer_sizes_) size = 0;
+  device_ = nullptr;
+  queue_ = nullptr;
+}
+
+WGPUBuffer WebGPUConstantBuffers::CreateBuffer(uint32_t size,
+                                               const char* label) {
+  WGPUBufferDescriptor desc = {};
+  desc.label = SViewCast(label);
+  desc.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst;
+  // Uniform buffer binding sizes must be 4-byte aligned; every captured bank
+  // is a multiple of a dword already.
+  desc.size = (size + 3u) & ~uint32_t(3);
+  return wgpuDeviceCreateBuffer(device_, &desc);
+}
+
+WGPUBindGroup WebGPUConstantBuffers::RefreshBindGroup(WGPUDevice device) {
+  if (bind_group_) {
+    wgpuBindGroupRelease(bind_group_);
+    bind_group_ = nullptr;
+  }
+  if (bind_group_layout_) {
+    wgpuBindGroupLayoutRelease(bind_group_layout_);
+    bind_group_layout_ = nullptr;
+  }
+  bind_group_layout_ = CreateConstantsBindGroupLayout(device);
+  if (!bind_group_layout_) return nullptr;
+  WGPUBindGroupEntry entries[kConstantBufferCount] = {};
+  for (uint32_t i = 0; i < kConstantBufferCount; ++i) {
+    if (!buffers_[i]) return nullptr;
+    entries[i].binding = i;
+    entries[i].buffer = buffers_[i];
+    entries[i].offset = 0;
+    entries[i].size = buffer_sizes_[i];
+  }
+  WGPUBindGroupDescriptor desc = {};
+  desc.layout = bind_group_layout_;
+  desc.entryCount = kConstantBufferCount;
+  desc.entries = entries;
+  bind_group_ = wgpuDeviceCreateBindGroup(device, &desc);
+  return bind_group_;
+}
+
+WGPUBindGroup WebGPUConstantBuffers::Upload(WGPUDevice device,
+                                            const CapturedConstants& constants) {
+  if (!device || !queue_) return nullptr;
+  const std::vector<uint8_t>* banks[kConstantBufferCount] = {
+      &constants.system, &constants.float_vs, &constants.float_ps,
+      &constants.bool_loop, &constants.fetch};
+  bool sizes_changed = false;
+  for (uint32_t i = 0; i < kConstantBufferCount; ++i) {
+    uint32_t size = uint32_t(banks[i]->size());
+    if (!size) continue;
+    if (!buffers_[i] || buffer_sizes_[i] < size) {
+      if (buffers_[i]) wgpuBufferRelease(buffers_[i]);
+      static const char* labels[kConstantBufferCount] = {
+          "constants_system", "constants_float_vs", "constants_float_ps",
+          "constants_bool_loop", "constants_fetch"};
+      buffers_[i] = CreateBuffer(size, labels[i]);
+      if (!buffers_[i]) {
+        REXGPU_ERROR("webgpu: constant buffer {} creation failed ({} bytes)", i,
+                     size);
+        return nullptr;
+      }
+      buffer_sizes_[i] = size;
+      sizes_changed = true;
+    }
+    // Grow-and-write: when the buffer is larger than this capture, zero-fill
+    // the tail so stale data never leaks between draws.
+    std::vector<uint8_t> padded(buffer_sizes_[i], 0);
+    std::memcpy(padded.data(), banks[i]->data(), size);
+    wgpuQueueWriteBuffer(queue_, buffers_[i], 0, padded.data(), padded.size());
+  }
+  if (sizes_changed || !bind_group_) return RefreshBindGroup(device);
+  return bind_group_;
+}
+
+// ----------------------------- texture cache -------------------------------
+
+void WebGPUTextureCache::Initialize(WGPUDevice device, WGPUQueue queue) {
+  device_ = device;
+  queue_ = queue;
+}
+
+void WebGPUTextureCache::Shutdown() {
+  Clear();
+  if (null_view_) {
+    wgpuTextureViewRelease(null_view_);
+    null_view_ = nullptr;
+  }
+  if (null_texture_) {
+    wgpuTextureRelease(null_texture_);
+    null_texture_ = nullptr;
+  }
+  device_ = nullptr;
+  queue_ = nullptr;
+}
+
+void WebGPUTextureCache::Clear() {
+  for (auto& [key, entry] : entries_) {
+    if (entry.view) wgpuTextureViewRelease(entry.view);
+    if (entry.texture) wgpuTextureRelease(entry.texture);
+  }
+  entries_.clear();
+  for (auto& [key, sampler] : samplers_) {
+    if (sampler) wgpuSamplerRelease(sampler);
+  }
+  samplers_.clear();
+}
+
+WGPUTexture WebGPUTextureCache::Get(const TextureKey& key) const {
+  auto it = entries_.find(key);
+  return it == entries_.end() ? nullptr : it->second.texture;
+}
+
+void WebGPUTextureCache::Upload(const TextureKey& key,
+                                const std::vector<uint8_t>& data) {
+  if (!device_) return;
+  auto it = entries_.find(key);
+  if (it == entries_.end()) {
+    WGPUTextureDescriptor desc = {};
+    desc.label = SViewCast("guest_texture");
+    desc.size = {key.width, key.height, 1};
+    desc.format = WGPUTextureFormat(key.format);
+    desc.usage = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst;
+    WGPUTexture texture = wgpuDeviceCreateTexture(device_, &desc);
+    if (!texture) {
+      REXGPU_ERROR("webgpu: guest texture creation failed ({}x{})", key.width,
+                   key.height);
+      return;
+    }
+    it = entries_.emplace(key, Entry{texture, nullptr}).first;
+  }
+  // The browser requires texel copy row pitches to be 256-byte aligned; pad
+  // rows into a staging copy.
+  uint32_t bpp = HostBytesPerPixel(WGPUTextureFormat(key.format));
+  uint32_t row_bytes = key.width * bpp;
+  uint32_t aligned_row = (row_bytes + kTexelCopyRowAlignment - 1) &
+                         ~(kTexelCopyRowAlignment - 1);
+  WGPUTexelCopyTextureInfo dst = {};
+  dst.texture = it->second.texture;
+  dst.mipLevel = 0;
+  dst.origin = {0, 0, 0};
+  dst.aspect = WGPUTextureAspect_All;
+  if (aligned_row == row_bytes) {
+    WGPUTexelCopyBufferLayout layout = {};
+    layout.bytesPerRow = row_bytes;
+    layout.rowsPerImage = key.height;
+    WGPUExtent3D size = {key.width, key.height, 1};
+    wgpuQueueWriteTexture(queue_, &dst, data.data(), data.size(), &layout,
+                          &size);
+  } else {
+    std::vector<uint8_t> padded(size_t(aligned_row) * key.height, 0);
+    for (uint32_t row = 0; row < key.height; ++row) {
+      std::memcpy(padded.data() + size_t(row) * aligned_row,
+                  data.data() + size_t(row) * row_bytes, row_bytes);
+    }
+    WGPUTexelCopyBufferLayout layout = {};
+    layout.bytesPerRow = aligned_row;
+    layout.rowsPerImage = key.height;
+    WGPUExtent3D size = {key.width, key.height, 1};
+    wgpuQueueWriteTexture(queue_, &dst, padded.data(), padded.size(), &layout,
+                          &size);
+  }
+}
+
+WGPUTextureView WebGPUTextureCache::CreateViewForTexture(
+    WGPUTexture texture, WGPUTextureFormat format) {
+  WGPUTextureViewDescriptor vdesc = {};
+  vdesc.format = format;
+  vdesc.dimension = WGPUTextureViewDimension_2D;
+  vdesc.aspect = WGPUTextureAspect_All;
+  return wgpuTextureCreateView(texture, &vdesc);
+}
+
+WGPUTextureView WebGPUTextureCache::GetView(const TextureKey& key) {
+  if (!device_) return nullptr;
+  auto it = entries_.find(key);
+  if (it == entries_.end()) {
+    // Unknown texture: bind the null substitute so the draw still runs
+    // (unbound textures are a common guest pattern for unused samplers).
+    if (!null_texture_) {
+      WGPUTextureDescriptor desc = {};
+      desc.label = SViewCast("webgpu_null_texture");
+      desc.size = {1, 1, 1};
+      desc.format = WGPUTextureFormat_BGRA8Unorm;
+      desc.usage = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst;
+      null_texture_ = wgpuDeviceCreateTexture(device_, &desc);
+      if (!null_texture_) return nullptr;
+      uint32_t zero = 0u;
+      WGPUTexelCopyTextureInfo dst = {};
+      dst.texture = null_texture_;
+      dst.aspect = WGPUTextureAspect_All;
+      WGPUTexelCopyBufferLayout layout = {};
+      layout.bytesPerRow = kTexelCopyRowAlignment;
+      layout.rowsPerImage = 1;
+      WGPUExtent3D size = {1, 1, 1};
+      wgpuQueueWriteTexture(queue_, &dst, &zero, sizeof(zero), &layout, &size);
+      null_view_ = CreateViewForTexture(null_texture_,
+                                        WGPUTextureFormat_BGRA8Unorm);
+    }
+    return null_view_;
+  }
+  if (!it->second.view) {
+    it->second.view = CreateViewForTexture(
+        it->second.texture, WGPUTextureFormat(key.format));
+  }
+  return it->second.view;
+}
+
+WGPUSampler WebGPUTextureCache::GetSampler(
+    uint32_t packed_state, const xenos::xe_gpu_texture_fetch_t& fetch) {
+  SamplerStateKey key{packed_state};
+  auto it = samplers_.find(key);
+  if (it != samplers_.end()) return it->second;
+  // The guest filter state rides in the packed key; the fetch supplies the
+  // aniso clamp behavior of this binding's shader.
+  auto unpack_filter = [](uint32_t bits) {
+    switch (bits & 3u) {
+      case 0:
+        return xenos::TextureFilter::kPoint;  // kPointSampled et al
+      default:
+        return xenos::TextureFilter::kLinear;
+    }
+  };
+  WGPUSampler sampler = CreateGuestSampler(
+      device_, unpack_filter(packed_state), unpack_filter(packed_state >> 2),
+      unpack_filter(packed_state >> 4), xenos::AnisoFilter(packed_state >> 6 & 7u));
+  if (sampler) samplers_.emplace(key, sampler);
+  return sampler;
+}
+
+// --------------------------- render target cache ---------------------------
+
+void WebGPURenderTargetCache::Initialize(WGPUDevice device) { device_ = device; }
+
+void WebGPURenderTargetCache::Shutdown() {
+  Clear();
+  device_ = nullptr;
+}
+
+void WebGPURenderTargetCache::Clear() {
+  for (auto& [base, entry] : entries_) {
+    if (entry.view) wgpuTextureViewRelease(entry.view);
+    if (entry.texture) wgpuTextureRelease(entry.texture);
+  }
+  entries_.clear();
+}
+
+WGPUTexture WebGPURenderTargetCache::GetTexture(uint32_t edram_base,
+                                                uint32_t width, uint32_t height,
+                                                WGPUTextureFormat format) {
+  if (!device_) return nullptr;
+  auto it = entries_.find(edram_base);
+  if (it != entries_.end()) {
+    if (it->second.width == width && it->second.height == height) {
+      return it->second.texture;
+    }
+    // Same tiles, different size: re-create.
+    if (it->second.view) wgpuTextureViewRelease(it->second.view);
+    wgpuTextureRelease(it->second.texture);
+    entries_.erase(it);
+  }
+  WGPUTextureDescriptor desc = {};
+  desc.label = SViewCast("guest_render_target");
+  desc.size = {width, height, 1};
+  desc.format = format;
+  desc.usage = WGPUTextureUsage_RenderAttachment |
+               WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopySrc |
+               WGPUTextureUsage_CopyDst;
+  WGPUTexture texture = wgpuDeviceCreateTexture(device_, &desc);
+  if (!texture) {
+    REXGPU_ERROR("webgpu: render target creation failed ({}x{}, base {:X})",
+                 width, height, edram_base);
+    return nullptr;
+  }
+  entries_.emplace(edram_base, Entry{texture, nullptr, width, height});
+  return texture;
+}
+
+WGPUTextureView WebGPURenderTargetCache::GetView(uint32_t edram_base,
+                                                 uint32_t width, uint32_t height,
+                                                 WGPUTextureFormat format) {
+  if (!GetTexture(edram_base, width, height, format)) return nullptr;
+  auto it = entries_.find(edram_base);
+  if (!it->second.view) {
+    WGPUTextureViewDescriptor vdesc = {};
+    vdesc.format = format;
+    vdesc.dimension = WGPUTextureViewDimension_2D;
+    vdesc.aspect = WGPUTextureAspect_All;
+    it->second.view = wgpuTextureCreateView(it->second.texture, &vdesc);
+  }
+  return it->second.view;
+}
+
+void WebGPURenderTargetCache::InvalidateRange(uint32_t start_tile,
+                                              uint32_t tile_count) {
+  if (!tile_count) return;
+  uint32_t end_tile = start_tile + tile_count;
+  for (auto it = entries_.begin(); it != entries_.end();) {
+    uint32_t base = it->first;
+    // EDRAM tile ranges intersecting the cleared range are evicted; guest
+    // clears re-create the content through the normal draw path.
+    if (base < end_tile && base + 1 >= start_tile) {
+      if (it->second.view) wgpuTextureViewRelease(it->second.view);
+      if (it->second.texture) wgpuTextureRelease(it->second.texture);
+      it = entries_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+// ----------------------------- pipeline cache ------------------------------
+
+void WebGPUPipelineCache::Initialize(WGPUDevice device,
+                                     WGPUTextureFormat target_format) {
+  device_ = device;
+  target_format_ = target_format;
+}
+
+void WebGPUPipelineCache::Shutdown() {
+  Clear();
+  device_ = nullptr;
+}
+
+void WebGPUPipelineCache::Clear() {
+  for (auto& [key, pipeline] : entries_) {
+    if (pipeline) wgpuRenderPipelineRelease(pipeline);
+  }
+  entries_.clear();
+}
+
+namespace {
+
+WGPUBlendFactor MapBlendFactor(uint32_t bits) {
+  switch (bits & 15u) {
+    case 0: return WGPUBlendFactor_Zero;
+    case 1: return WGPUBlendFactor_One;
+    case 2: return WGPUBlendFactor_Src;
+    case 3: return WGPUBlendFactor_OneMinusSrc;
+    case 4: return WGPUBlendFactor_SrcAlpha;
+    case 5: return WGPUBlendFactor_OneMinusSrcAlpha;
+    case 6: return WGPUBlendFactor_Dst;
+    case 7: return WGPUBlendFactor_OneMinusDst;
+    case 8: return WGPUBlendFactor_DstAlpha;
+    case 9: return WGPUBlendFactor_OneMinusDstAlpha;
+    case 10: return WGPUBlendFactor_Constant;
+    case 11: return WGPUBlendFactor_OneMinusConstant;
+    case 12: return WGPUBlendFactor_SrcAlphaSaturated;
+    default: return WGPUBlendFactor_Zero;
+  }
+}
+
+WGPUBlendOperation MapBlendOp(uint32_t bits) {
+  switch (bits & 7u) {
+    case 0: return WGPUBlendOperation_Add;
+    case 1: return WGPUBlendOperation_Subtract;
+    case 2: return WGPUBlendOperation_ReverseSubtract;
+    case 3: return WGPUBlendOperation_Min;
+    case 4: return WGPUBlendOperation_Max;
+    default: return WGPUBlendOperation_Add;
+  }
+}
+
+}  // namespace
+
+WGPURenderPipeline WebGPUPipelineCache::GetOrCreate(
+    WGPUShaderModule vertex_module, WGPUShaderModule pixel_module,
+    const WebGPUPipelineKey& key) {
+  if (!device_) return nullptr;
+  auto it = entries_.find(key);
+  if (it != entries_.end()) return it->second;
+
+  WGPUPipelineLayout layout = CreatePipelineLayoutForABI(
+      device_, key.vs_texture_count, key.ps_texture_count);
+  if (!layout) {
+    REXGPU_ERROR("webgpu: pipeline layout creation failed (vs{}, ps{})",
+                 key.vs_texture_count, key.ps_texture_count);
+    return nullptr;
+  }
+
+  WGPUBlendComponent color = {};
+  color.operation = MapBlendOp(key.blend_packed);
+  color.srcFactor = MapBlendFactor(key.blend_packed >> 3);
+  color.dstFactor = MapBlendFactor(key.blend_packed >> 7);
+  WGPUBlendComponent alpha = {};
+  alpha.operation = MapBlendOp(key.blend_packed >> 11);
+  alpha.srcFactor = MapBlendFactor(key.blend_packed >> 14);
+  alpha.dstFactor = MapBlendFactor(key.blend_packed >> 18);
+  WGPUBlendState blend = {color, alpha};
+  WGPUColorTargetState target = {};
+  target.format = target_format_;
+  target.blend = &blend;
+  target.writeMask = (key.blend_packed >> 22) & WGPUColorWriteMask_All;
+  if (!target.writeMask) target.writeMask = WGPUColorWriteMask_All;
+
+  WGPUVertexState vertex_state = {};
+  vertex_state.module = vertex_module;
+  vertex_state.entryPoint = SViewCast("main");
+  WGPUFragmentState fragment_state = {};
+  fragment_state.module = pixel_module;
+  fragment_state.entryPoint = SViewCast("main");
+  fragment_state.targetCount = 1;
+  fragment_state.targets = &target;
+
+  WGPURenderPipelineDescriptor desc = {};
+  desc.label = SViewCast("guest_pipeline");
+  desc.layout = layout;
+  desc.vertex = vertex_state;
+  desc.fragment = pixel_module ? &fragment_state : nullptr;
+  desc.primitive.topology = WGPUPrimitiveTopology(key.topology);
+  desc.primitive.cullMode = WGPUCullMode_None;
+  desc.multisample.count = 1;
+
+  WGPURenderPipeline pipeline = wgpuDeviceCreateRenderPipeline(device_, &desc);
+  wgpuPipelineLayoutRelease(layout);
+  if (pipeline) {
+    entries_.emplace(key, pipeline);
+  } else {
+    REXGPU_ERROR(
+        "webgpu: pipeline creation failed ({:016X}/{:016X}, vs{} ps{} tex, "
+        "blend {:X}, topo {})",
+        key.vertex_hash, key.pixel_hash, key.vs_texture_count,
+        key.ps_texture_count, key.blend_packed, key.topology);
+  }
+  return pipeline;
+}
+
+}  // namespace rex::graphics::webgpu
