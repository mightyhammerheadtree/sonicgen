diff --git a/include/rex/platform/fpscr.h b/include/rex/platform/fpscr.h
index c2c4fd4..8990c13 100644
--- a/include/rex/platform/fpscr.h
+++ b/include/rex/platform/fpscr.h
@@ -82,6 +82,45 @@ struct FPSCRPlatform {
   }
 };
 
+#elif defined(__EMSCRIPTEN__)
+
+// WebAssembly: wasm MVP floating point is IEEE-754 with a fixed
+// round-to-nearest mode -- there is no dynamic host rounding control (no
+// MXCSR/FPCR equivalent) until the wasm rounding-modes proposal ships.
+// Keep a software shadow of the MXCSR-shaped FPSCR so guest FPSCR reads and
+// writes stay logically correct; guest code that switches to non-default
+// rounding gets correct FPSCR state, and rounding-sensitive individual ops
+// (fctiw/fctiwz and friends) are translated by the recompiler into explicit
+// trunc/convert sequences rather than relying on the host rounding mode.
+struct FPSCRPlatform {
+  static constexpr size_t RoundShift = 13;
+  static constexpr size_t RoundMaskVal = SIMDE_MM_ROUND_MASK;
+  static constexpr size_t FlushMask = SIMDE_MM_FLUSH_ZERO_MASK;
+  // Exception mask bits (1 = exception masked/disabled). Wasm traps instead of
+  // raising FP exceptions, so all exception sources stay masked in the shadow.
+  static constexpr u32 ExceptionMask = (1 << 7) |   // IM - Invalid operation
+                                       (1 << 8) |   // DM - Denormal operand
+                                       (1 << 9) |   // ZM - Zero divide
+                                       (1 << 10) |  // OM - Overflow
+                                       (1 << 11) |  // UM - Underflow
+                                       (1 << 12);   // PM - Precision (Inexact)
+  // Shadow mapping only (nearest, zero, +inf, -inf); never applied to a host FPU.
+  static constexpr size_t GuestToHost[] = {0, 3, 1, 2};
+
+  static inline u32& ShadowCsr() noexcept {
+    static thread_local u32 csr = 0;
+    return csr;
+  }
+
+  static inline u32 getcsr() noexcept { return ShadowCsr(); }
+
+  static inline void setcsr(u32 csr) noexcept { ShadowCsr() = csr; }
+
+  static inline void InitHostExceptions(u32& csr) noexcept {
+    csr |= ExceptionMask;  // Set mask bits to disable exceptions
+  }
+};
+
 #else
 #error "Missing implementation for FPSCR."
 #endif
