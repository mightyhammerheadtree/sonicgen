@@ -0,0 +1,84 @@
+/**
+ * @file        webgpu/shader.cpp
+ * @brief       WebGPU shader objects (implementation)
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include "shader.h"
+
+#include <rex/logging.h>
+
+#include "wgsl_translator.h"
+
+namespace rex::graphics::webgpu {
+
+WebGPUShader::WebGPUShader(xenos::ShaderType shader_type, uint64_t ucode_data_hash,
+                           const uint32_t* ucode_dwords, size_t ucode_dword_count,
+                           std::endian ucode_source_endian)
+    : SpirvShader(shader_type, ucode_data_hash, ucode_dwords, ucode_dword_count,
+                  ucode_source_endian) {}
+
+Shader::Translation* WebGPUShader::CreateTranslationInstance(uint64_t modification) {
+  return new WebGPUTranslation(*this, modification);
+}
+
+WebGPUShader::WebGPUTranslation::~WebGPUTranslation() {
+  if (shader_module_) {
+    wgpuShaderModuleRelease(shader_module_);
+    shader_module_ = nullptr;
+  }
+}
+
+bool WebGPUShader::WebGPUTranslation::EnsureWGSLTranslated() {
+  if (!is_valid()) return false;
+  if (!wgsl_.empty()) return true;
+  if (wgsl_attempted_) return false;
+  wgsl_attempted_ = true;
+
+  // Stage for the WGSL entry attribute: vertex vs fragment. Compute shaders
+  // are not produced by the guest pipeline (memexport uses storage writes).
+  int stage = static_cast<const WebGPUShader&>(shader()).type() ==
+                      xenos::ShaderType::kVertex
+                  ? 0
+                  : 1;
+
+  const auto& spirv = translated_binary();
+  WgslTranslationResult result;
+  if (!TranslateSpirvToWgsl(reinterpret_cast<const uint32_t*>(spirv.data()),
+                            spirv.size() / sizeof(uint32_t), stage, result)) {
+    REXGPU_ERROR(
+        "webgpu: SPIR-V to WGSL translation failed for shader {:016X} "
+        "modification {:016X}: {}",
+        shader().ucode_data_hash(), modification(), result.error);
+    MakeInvalid();
+    return false;
+  }
+  wgsl_ = result.wgsl;
+  return true;
+}
+
+WGPUShaderModule WebGPUShader::WebGPUTranslation::GetOrCreateShaderModule(
+    WGPUDevice device) {
+  if (!is_valid() || !device) return nullptr;
+  if (shader_module_) return shader_module_;
+  if (!EnsureWGSLTranslated()) return nullptr;
+
+  WGPUShaderSourceWGSL wgsl_source = {};
+  wgsl_source.chain.sType = WGPUSType_ShaderSourceWGSL;
+  wgsl_source.code = WGPUStringView{wgsl_.data(), wgsl_.size()};
+  WGPUShaderModuleDescriptor desc = {};
+  desc.nextInChain = &wgsl_source.chain;
+  shader_module_ = wgpuDeviceCreateShaderModule(device, &desc);
+  if (!shader_module_) {
+    REXGPU_ERROR("webgpu: WGPUShaderModule creation failed for shader {:016X}",
+                 shader().ucode_data_hash());
+    MakeInvalid();
+    return nullptr;
+  }
+  // Keep the WGSL available for pipeline-cache dumps / debugging.
+  set_host_disassembly(wgsl_);
+  return shader_module_;
+}
+
+}  // namespace rex::graphics::webgpu
