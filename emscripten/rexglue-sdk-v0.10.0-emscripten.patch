+// Shared memory window mirrored on the device (vertex/index fetch data).
+constexpr uint32_t kSharedMemorySize = 128u * 1024u * 1024u;
+// Safety bound for any single captured guest range.
+constexpr uint32_t kMaxCaptureBytes = 32u * 1024u * 1024u;
+
+// The float constant banks in the register file (identity index -> dword).
+constexpr uint32_t kShaderConstantBankVS =
+    XE_GPU_REG_SHADER_CONSTANT_000_X;  // 0x4000, registers 0-255 (4KB)
+constexpr uint32_t kShaderConstantBankPS =
+    XE_GPU_REG_SHADER_CONSTANT_256_X;  // 0x4400, registers 0-255 of the PS
+                                       // bank (4KB)
+constexpr uint32_t kShaderConstantBool =
+    XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031;  // 8 dwords, 256 bools
+constexpr uint32_t kShaderConstantLoop =
+    XE_GPU_REG_SHADER_CONSTANT_LOOP_00;  // 4 dwords; the WGSL buffer has 32
+constexpr uint32_t kShaderConstantFetch =
+    XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0;  // 32 x 6 dwords
+
+void AppendRegisterBlock(const uint32_t* register_values, uint32_t index,
+                         uint32_t dword_count, std::vector<uint8_t>& out) {
+  const uint8_t* begin =
+      reinterpret_cast<const uint8_t*>(register_values + index);
+  out.insert(out.end(), begin,
+             begin + size_t(dword_count) * sizeof(uint32_t));
+}
+
+// Packs the float constant bank the way the translator indexes it: tightly
+// ordered by the set bits of the shader's register map, or the whole bank
+// when the shader addresses registers dynamically.
+void PackFloatConstants(const uint32_t* bank,
+                        const Shader::ConstantRegisterMap& map,
+                        std::vector<uint8_t>& out) {
+  if (map.float_dynamic_addressing) {
+    out.resize(sizeof(float) * 4 * 256);
+    std::memcpy(out.data(), bank, out.size());
+    return;
+  }
+  out.reserve(size_t(map.float_count) * 16);
+  for (uint32_t block = 0; block < 4; ++block) {
+    uint64_t bits = map.float_bitmap[block];
+    while (bits) {
+      uint32_t bit = uint32_t(std::countr_zero(bits));
+      uint32_t register_index = block * 64 + bit;
+      AppendRegisterBlock(bank, register_index * 4, 4, out);
+      bits &= bits - 1;
+    }
+  }
+}
+
+// Guest texture format -> canonical host BGRA8 conversion for the untiled
+// (linear) formats this backend supports in v1. Returns false for formats
+// the texture loader does not handle yet.
+bool ConvertLinearTexture(const uint8_t* guest_data, size_t guest_bytes,
+                          xenos::TextureFormat format, uint32_t width,
+                          uint32_t height, uint32_t row_pitch_bytes,
+                          xenos::Endian endianness, std::vector<uint8_t>& out) {
+  auto word_swapped = [endianness]() {
+    // Guest words are big-endian relative to the host reads; the fetch's
+    // endianness field describes the guest packing.
+    return endianness == xenos::Endian::k8in32 ||
+           endianness == xenos::Endian::k16in32;
+  };
+  switch (format) {
+    case xenos::TextureFormat::k_8_8_8_8: {
+      // Guest BGRA byte order, already the host canonical format.
+      out.assign(guest_data, guest_data + guest_bytes);
+      if (word_swapped()) {
+        for (size_t i = 0; i + 4 <= out.size(); i += 4) {
+          std::swap(out[i], out[i + 3]);
+          std::swap(out[i + 1], out[i + 2]);
+        }
+      }
+      return true;
+    }
+    case xenos::TextureFormat::k_2_10_10_10:
+    case xenos::TextureFormat::k_5_6_5:
+    case xenos::TextureFormat::k_1_5_5_5: {
+      out.resize(size_t(width) * height * 4);
+      for (uint32_t y = 0; y < height; ++y) {
+        const uint8_t* row = guest_data + size_t(y) * row_pitch_bytes;
+        uint8_t* dst = out.data() + size_t(y) * width * 4;
+        for (uint32_t x = 0; x < width; ++x) {
+          if (format == xenos::TextureFormat::k_2_10_10_10) {
+            uint32_t word;
+            std::memcpy(&word, row + size_t(x) * 4, sizeof(word));
+            if (word_swapped()) word = __builtin_bswap32(word);
+            dst[x * 4 + 0] = uint8_t(((word >> 20) & 0x3FF) >> 2);  // B
+            dst[x * 4 + 1] = uint8_t(((word >> 10) & 0x3FF) >> 2);  // G
+            dst[x * 4 + 2] = uint8_t((word & 0x3FF) >> 2);          // R
+            dst[x * 4 + 3] = uint8_t((word >> 30) * 85u);           // A
+          } else {
+            uint16_t half;
+            std::memcpy(&half, row + size_t(x) * 2, sizeof(half));
+            if (endianness == xenos::Endian::k8in16) {
+              half = uint16_t(__builtin_bswap16(half));
+            }
+            if (format == xenos::TextureFormat::k_5_6_5) {
+              dst[x * 4 + 0] = uint8_t((half & 0x1F) << 3);            // B
+              dst[x * 4 + 1] = uint8_t(((half >> 5) & 0x3F) << 2);     // G
+              dst[x * 4 + 2] = uint8_t(((half >> 11) & 0x1F) << 3);    // R
+              dst[x * 4 + 3] = 0xFF;                                   // A
+            } else {  // k_1_5_5_5
+              dst[x * 4 + 0] = uint8_t((half & 0x1F) << 3);            // B
+              dst[x * 4 + 1] = uint8_t(((half >> 5) & 0x1F) << 3);     // G
+              dst[x * 4 + 2] = uint8_t(((half >> 10) & 0x1F) << 3);    // R
+              dst[x * 4 + 3] = (half & 0x8000) ? 0xFF : 0x00;          // A
+            }
+          }
+        }
+      }
+      return true;
+    }
+    default:
+      return false;
+  }
+}
