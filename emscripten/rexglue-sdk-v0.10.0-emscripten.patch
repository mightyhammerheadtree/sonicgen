+#pragma once
+/**
+ * @file        webgpu/command_processor.h
+ * @brief       WebGPU backend command processor
+ *
+ * Runs the guest PM4 ring on the command processor thread (base class logic).
+ * Each draw is fully captured on that thread - shader WGSL translation,
+ * constant banks, texture bytes, index buffer, render target and blend state
+ * - and the main thread encodes the WebGPU render pass when it drains the
+ * deferred queue. WebGPU itself is main-thread-only in the browser.
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include <memory>
+#include <vector>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/graphics/graphics_system.h>
+#include <rex/graphics/pipeline/shader/spirv_translator.h>
+
+#include "deferred_queue.h"
+#include "resources.h"
+#include "webgpu_device.h"
+
+namespace rex::graphics::webgpu {
+
+class WebGPUShader;
+
+// Per-draw texture binding captured on the CP thread: guest identity key,
+// filter state for the sampler cache, and the converted host-format bytes.
+struct CapturedTexture {
+  TextureKey key;
+  uint32_t sampler_state = 0;  // packed mag/min/mip filters + aniso
+  std::vector<uint8_t> data;
+};
+
+// One guest draw, fully resolved on the command processor thread so the main
+// thread can encode it into WebGPU without touching guest memory again.
+struct CapturedDraw {
+  // Shader WGSL sources + identity hashes for the pipeline key.
+  std::string vs_wgsl;
+  std::string ps_wgsl;
+  uint64_t vs_hash = 0;
+  uint64_t ps_hash = 0;
+  uint32_t vs_texture_count = 0;
+  uint32_t ps_texture_count = 0;
+  bool depth_only = false;  // no pixel shader (VS only)
+
+  // Constant banks (see WebGPUConstantBuffers / CapturedConstants).
+  CapturedConstants constants;
+
+  // Shared memory ranges to upload (guest address -> bytes).
+  struct MemoryRange {
+    uint32_t guest_address;
+    std::vector<uint8_t> data;
+  };
+  std::vector<MemoryRange> ranges;  // vertex fetch ranges
+  MemoryRange index_buffer;         // guest address + index bytes
+
+  xenos::IndexFormat index_format = xenos::IndexFormat::kInt16;
+  uint32_t index_count = 0;
+
+  // Color render target 0 (EDRAM tile base as the cache key).
+  uint32_t rt_base = UINT32_MAX;
+  uint32_t rt_width = 0;
+  uint32_t rt_height = 0;
+  xenos::ColorRenderTargetFormat rt_format =
+      xenos::ColorRenderTargetFormat::k_8_8_8_8;
+
+  // Blend (packed RB_BLENDCONTROL0 + RB_COLOR_MASK) and primitive topology.
+  uint32_t blend_packed = 0;
+  uint8_t topology = 3;  // WGPUPrimitiveTopology_TriangleList
+
+  // Textures for sets 2 (vertex) and 3 (pixel).
+  std::vector<CapturedTexture> vs_textures;
+  std::vector<CapturedTexture> ps_textures;
+};
+
+class WebGPUCommandProcessor : public CommandProcessor {
+ public:
+  WebGPUCommandProcessor(GraphicsSystem* graphics_system,
+                         system::KernelState* kernel_state,
+                         WebGPUDevice* device);
+  ~WebGPUCommandProcessor() override;
+
+  // CommandProcessor
+  bool Initialize() override;
+  void Shutdown() override;
+  void ClearCaches() override;
+  void InvalidateGpuMemory() override;
+  void IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
+                 uint32_t frontbuffer_height) override;
+
+  // Presentation pump -- called on the main thread each frame.
+  void PumpFrame(uint32_t surface_width, uint32_t surface_height);
+
+  DeferredQueue& deferred_queue() { return deferred_queue_; }
+  WebGPUDevice* device() const { return device_; }
+  WebGPUTextureCache* texture_cache() const { return texture_cache_.get(); }
+  WebGPURenderTargetCache* render_target_cache() const {
+    return render_target_cache_.get();
+  }
+  WebGPUPipelineCache* pipeline_cache() const { return pipeline_cache_.get(); }
+  WebGPUSharedMemory* shared_memory() const { return shared_memory_.get(); }
+
+ protected:
+  bool SetupContext() override;
+  void ShutdownContext() override;
+  Shader* LoadShader(xenos::ShaderType shader_type, uint32_t guest_address,
+                     const uint32_t* host_address,
+                     uint32_t dword_count) override;
+  bool IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
+                 IndexBufferInfo* index_buffer_info,
+                 bool major_mode_explicit) override;
+  bool IssueCopy() override;
+  void MakeCoherent() override;
+  void PrepareForWait() override;
+  void ReturnFromWait() override;
+
+ private:
+  // CP-thread capture helpers (see IssueDraw).
+  bool CaptureDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
+                   IndexBufferInfo* index_buffer_info, CapturedDraw& draw);
+  bool CaptureShader(WebGPUShader* shader, bool vertex, uint32_t program_cntl,
+                     std::string& wgsl_out, uint64_t& hash_out,
+                     uint32_t& texture_count_out);
+  void CaptureConstants(WebGPUShader* vs, WebGPUShader* ps,
+                        CapturedConstants& constants);
+  void CaptureTextures(WebGPUShader* shader, uint32_t packed_key_offset,
+                       std::vector<CapturedTexture>& textures_out);
+  bool CaptureTextureData(const xenos::xe_gpu_texture_fetch_t& fetch,
+                          std::vector<uint8_t>& data_out);
+  static uint32_t PackBlendState(uint32_t blend_control, uint32_t color_mask,
+                                 bool blend_active);
+  static uint8_t MapTopology(xenos::PrimitiveType prim_type);
+  static bool MemoryRangeForGuestAddress(uint32_t guest_address,
+                                         uint32_t shared_memory_capacity);
+
+  void PresentOnSurface(uint32_t surface_width, uint32_t surface_height);
+
+  WebGPUDevice* device_ = nullptr;
+  DeferredQueue deferred_queue_;
+
+  std::unique_ptr<WebGPUSharedMemory> shared_memory_;
+  std::unique_ptr<WebGPUConstantBuffers> constant_buffers_;
+  std::unique_ptr<WebGPUTextureCache> texture_cache_;
+  std::unique_ptr<WebGPURenderTargetCache> render_target_cache_;
+  std::unique_ptr<WebGPUPipelineCache> pipeline_cache_;
+
+  // Guest shader translation.
+  std::unique_ptr<SpirvShaderTranslator> shader_translator_;
+
+  // Presentation: shared paint pipeline + latest guest output.
+  PaintPipeline paint_;
+  std::unique_ptr<WGPUSampler> paint_sampler_;
+  WGPUSampler paint_sampler_handle_ = nullptr;
+  bool paint_created_ = false;
+  TextureKey swap_key_{};
+  bool swap_valid_ = false;
+  uint32_t swap_width_ = 0;
+  uint32_t swap_height_ = 0;
+};
+
+}  // namespace rex::graphics::webgpu
diff --git a/src/graphics/webgpu/deferred_queue.cpp b/src/graphics/webgpu/deferred_queue.cpp
new file mode 100644
index 0000000..6eb5cbf
--- /dev/null
+++ b/src/graphics/webgpu/deferred_queue.cpp
@@ -0,0 +1,36 @@
+/**
+ * @file        webgpu/deferred_queue.cpp
+ * @brief       Main-thread deferred GPU operation queue (implementation)
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include "deferred_queue.h"
+
+namespace rex::graphics::webgpu {
+
+void DeferredQueue::Push(Op op) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  ops_.push(std::move(op));
+}
+
+void DeferredQueue::Drain() {
+  // Swap under the lock so pushes during execution queue for the next frame
+  // instead of growing the drain unboundedly.
+  std::queue<Op> local;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    local.swap(ops_);
+  }
+  while (!local.empty()) {
+    local.front()();
+    local.pop();
+  }
+}
+
+size_t DeferredQueue::Size() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return ops_.size();
+}
+
+}  // namespace rex::graphics::webgpu
diff --git a/src/graphics/webgpu/deferred_queue.h b/src/graphics/webgpu/deferred_queue.h
new file mode 100644
index 0000000..dc79427
--- /dev/null
+++ b/src/graphics/webgpu/deferred_queue.h
@@ -0,0 +1,38 @@
+#pragma once
+/**
+ * @file        webgpu/deferred_queue.h
+ * @brief       Main-thread deferred GPU operation queue for the wasm backend
+ *
+ * The guest command processor runs on its own thread and must not call
+ * WebGPU directly (main-thread-only API in the browser). Backend operations
+ * are recorded as lambdas and drained by the main thread each frame, mirroring
+ * how the Vulkan backend batches through its deferred command buffer.
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include <functional>
+#include <mutex>
+#include <queue>
+
+namespace rex::graphics::webgpu {
+
+class DeferredQueue {
+ public:
+  using Op = std::function<void()>;
+
+  // Called from any thread (the command processor thread).
+  void Push(Op op);
+
+  // Called from the main thread each frame: executes and clears all pending
+  // operations in submission order.
+  void Drain();
+
+  size_t Size();
+
+ private:
+  std::mutex mutex_;
+  std::queue<Op> ops_;
+};
+
+}  // namespace rex::graphics::webgpu
