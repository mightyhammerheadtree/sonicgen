+/**
+ * @file        webgpu/wgsl_translator.cpp
+ * @brief       SPIR-V to WGSL translator (implementation)
+ *
+ * Parses the SPIR-V module produced by SpirvShaderTranslator and emits WGSL.
+ * Covers the opcode subset the in-tree translator emits: types/constants,
+ * interface variables (Location/BuiltIn/DescriptorSet/Binding), memory ops
+ * via pointer-expression tracking, arithmetic/logic/bitwise/composite/image
+ * ops, derivatives, GLSL.std.450 extended instructions, and CFG
+ * structurization (if/else, switch-as-if-chain, loops, Phi-to-variable
+ * promotion). Unsupported CFG shapes fail with a clear error instead of
+ * producing incorrect WGSL.
+ *
+ * @copyright   BSD 3-Clause License
+ */
+
+#include "wgsl_translator.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace rex::graphics::webgpu {
+namespace {
+
+constexpr uint32_t kSpirvMagic = 0x07230203u;
+
